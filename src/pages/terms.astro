---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Terms & Conditions | Vatsal Jain · Arqo Studio"
  description="Terms and Conditions governing the use of Vatsal Jain and Arqo Studio digital products and services."
>
  <!-- HEADER -->
  <header class="sticky top-0 z-50 w-full border-b border-[#E8E6E1] bg-[#FAF9F6]/90 backdrop-blur-md">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex items-center justify-between py-4">
        <!-- Logo -->
        <a href="/" class="text-base sm:text-lg font-bold text-[#141416] tracking-tight">Vatsal Jain<span class="text-[#E24A1F] text-2xl font-black leading-none ml-[0.5px]">.</span></a>

        <!-- Nav links -->
        <nav class="hidden items-center gap-8 md:flex">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Products</a>
          <a href="/vault" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Ad Vault</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/vault"
            class="hidden md:inline-flex items-center gap-1.5 rounded-md bg-[#E24A1F] px-4 py-2 text-xs sm:text-sm font-bold text-white transition hover:bg-[#C53B12] shadow-sm"
          >
            Get The Vault →
          </a>

          <!-- Mobile hamburger -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="flex h-9 w-9 items-center justify-center rounded-md border border-[#E8E6E1] text-[#5E5D64] transition hover:bg-white md:hidden"
            aria-label="Toggle menu"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden pb-4 md:hidden border-t border-[#E8E6E1] pt-3">
        <nav class="flex flex-col gap-3">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64] hover:text-[#141416]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64] hover:text-[#141416]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64] hover:text-[#141416]">Products</a>
          <a
            href="/vault"
            class="mt-1 inline-flex items-center justify-center gap-1.5 rounded-md bg-[#E24A1F] px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-[#C53B12] text-center"
          >
            Get The Vault →
          </a>
        </nav>
      </div>
    </div>
  </header>

  <main class="flex-auto">
    <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="border-b border-[#E8E6E1] pb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Legal Documentation</span>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          Terms &amp; Conditions
        </h1>
        <p class="mt-3 text-sm text-[#5E5D64]">
          Last updated: October 29, 2026 · Effective immediately
        </p>
      </div>

      <!-- META DISCLAIMER CALLOUT -->
      <div class="mt-8 rounded-xl border border-amber-200/80 bg-amber-50/50 p-5 text-xs text-[#5E5D64] leading-relaxed">
        <strong class="font-bold text-[#141416] uppercase tracking-wider block mb-1">Important Meta / Facebook Disclaimer:</strong>
        This site is not a part of the Facebook website or Meta Platforms, Inc. Additionally, this site is NOT endorsed or affiliated with Facebook or Meta Platforms, Inc. in any way. FACEBOOK is a registered trademark of META PLATFORMS, INC.
      </div>

      <div class="mt-10 space-y-10 text-sm text-[#3E3D42] leading-relaxed">
        <!-- 1. Agreement to Terms -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">1. Agreement to Terms</h2>
          <p class="mt-3">
            By accessing or purchasing from <a href="https://vatsal.arqostudio.com" class="text-[#E24A1F] hover:underline">vatsal.arqostudio.com</a>, you agree to be bound by these Terms &amp; Conditions and all applicable laws and regulations. If you do not agree with any of these terms, you are prohibited from using or accessing this site and purchasing our products.
          </p>
        </section>

        <!-- 2. Digital Products & Deliverables -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">2. Digital Products &amp; Deliverables</h2>
          <p class="mt-3">
            We provide digital informational resources, creative packs, and consulting services, including:
          </p>
          <ul class="mt-3 list-disc pl-5 space-y-2 text-[#5E5D64]">
            <li><strong>The Static Ad Vault:</strong> A digital resource comprising 30 foundational static ad teardowns, visual hierarchy blueprints, a sprint execution checklist, private Notion workspace access, and downloadable PDF documentation, plus ongoing vault additions.</li>
            <li><strong>25 Custom Static Ads Pack:</strong> Custom creative production for your brand delivered as graphic assets across standard aspect ratios.</li>
            <li><strong>Roast My Ads:</strong> Direct strategic audit teardowns and 1-on-1 advisory calls.</li>
          </ul>
        </section>

        <!-- 3. Intellectual Property & License -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">3. License &amp; Usage Rights</h2>
          <p class="mt-3">
            Upon purchasing <em>The Static Ad Vault</em>, you are granted a non-exclusive, non-transferable, revocable single-user license to review the materials and apply the frameworks, formulas, and layouts to create advertisements for your own business or your direct clients.
          </p>
          <p class="mt-3 text-[#5E5D64]">
            <strong>Restrictions:</strong> You may not share your private access credentials, resell, sublicense, publicly upload, publish on file-sharing repositories, or create competing swipe files or derivative commercial digital vault products from our source materials. Any unauthorized redistribution constitutes copyright infringement and will result in immediate termination of access without refund.
          </p>
        </section>

        <!-- 4. Payments, Pricing & Taxes -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">4. Payments, Pricing &amp; Taxes</h2>
          <p class="mt-3">
            All purchases are processed securely through our authorized payment partner, <strong>Razorpay</strong>. Prices are clearly stated in Indian Rupees (₹) and/or applicable foreign currencies at checkout. You agree to provide current, complete, and accurate purchase and account information for all transactions.
          </p>
        </section>

        <!-- 5. Refund & Cancellation Policy -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">5. Refund &amp; Cancellation Policy</h2>
          <p class="mt-3">
            Due to the immediate digital delivery and irreversible nature of Notion workspace access, downloadable PDF playbooks, and proprietary breakdown documents, <strong>all sales for The Static Ad Vault and digital asset packs are final and non-refundable</strong>.
          </p>
          <p class="mt-3 text-[#5E5D64]">
            Please review the sample formats, FAQ section, and curriculum details on the product page before completing your order. If you experience technical issues accessing your purchase, our support team will resolve them promptly via <a href="mailto:hello@arqostudio.com" class="font-semibold text-[#E24A1F] hover:underline">hello@arqostudio.com</a>.
          </p>
        </section>

        <!-- 6. Meta / Facebook Disclaimer -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">6. Meta Platforms &amp; Third-Party Disclaimer</h2>
          <p class="mt-3">
            <strong>Not affiliated with Meta Platforms, Inc.:</strong> This website and the educational materials provided are in no way affiliated with, sponsored by, or endorsed by Meta Platforms, Inc., Facebook, or Instagram. "Facebook" and "Instagram" are registered trademarks of Meta Platforms, Inc.
          </p>
          <p class="mt-3 text-[#5E5D64]">
            <strong>No Performance Guarantees:</strong> Any case studies, metrics, ROAS examples, or teardown figures shown on this site represent past analyses or illustrative examples. We make no warranty or guarantee regarding your specific revenue, return on ad spend, or customer acquisition costs, as performance depends on variables outside our control including product-market fit, offer economics, inventory, pricing, and campaign execution.
          </p>
        </section>

        <!-- 7. Limitation of Liability -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">7. Limitation of Liability</h2>
          <p class="mt-3">
            In no event shall Vatsal Jain, Arqo Studio, or its affiliates be liable for any direct, indirect, incidental, special, consequential, or punitive damages arising out of your access to, use of, or inability to use our website, digital products, or recommendations.
          </p>
        </section>

        <!-- 8. Governing Law & Dispute Resolution -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">8. Governing Law</h2>
          <p class="mt-3">
            These Terms &amp; Conditions shall be governed by and construed in accordance with the laws of India, without regard to conflict of law principles. Any dispute arising under these Terms shall be resolved in the competent courts located in India.
          </p>
        </section>

        <!-- 9. Contact Information -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">9. Contact Information</h2>
          <p class="mt-3">
            For questions or inquiries regarding these Terms &amp; Conditions, please contact us at:
          </p>
          <div class="mt-4 rounded-xl border border-[#E8E6E1] bg-white p-5 text-xs text-[#5E5D64] space-y-1.5 shadow-2xs">
            <div><strong>Entity:</strong> Vatsal Jain · Arqo Studio</div>
            <div><strong>Support Email:</strong> <a href="mailto:hello@arqostudio.com" class="text-[#E24A1F] hover:underline">hello@arqostudio.com</a></div>
            <div><strong>Website:</strong> <a href="https://vatsal.arqostudio.com" class="hover:underline">https://vatsal.arqostudio.com</a></div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-[#E8E6E1] bg-[#FAF9F6] py-10">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-xs text-[#8E8D94]">
          © {new Date().getFullYear()} Vatsal Jain · Arqo Studio. All rights reserved.
        </p>
        <div class="flex flex-wrap items-center gap-6 text-xs text-[#5E5D64]">
          <a href="/" class="hover:text-[#141416]">Home</a>
          <a href="/vault" class="hover:text-[#141416]">Ad Vault</a>
          <a href="/privacy" class="hover:text-[#141416]">Privacy Policy</a>
          <a href="/terms" class="text-[#141416] font-semibold">Terms &amp; Conditions</a>
          <a href="mailto:hello@arqostudio.com" class="hover:text-[#141416]">Contact</a>
        </div>
      </div>
      <div class="mt-6 border-t border-[#E8E6E1] pt-6 text-center text-[11px] text-[#8E8D94] leading-relaxed">
        <p>Disclaimer: This site is not a part of the Facebook website or Meta Platforms, Inc. Additionally, this site is NOT endorsed by Facebook / Meta in any way. FACEBOOK is a trademark of META PLATFORMS, INC.</p>
      </div>
    </div>
  </footer>
</Layout>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
  });
</script>
