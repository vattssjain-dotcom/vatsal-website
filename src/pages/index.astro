---
import Layout from '../layouts/Layout.astro';

const products = [
  {
    tag: 'Flagship System',
    tagColor: 'text-orange-500 font-bold',
    title: 'AI Ad Creative Vault',
    description:
      '50 proven static ad creatives for Meta, plus the exact AI prompts and workflow to remake them for your own brand in an afternoon.',
    type: 'Vault + Prompts',
    href: '/vault',
  },
  {
    tag: 'Most popular',
    tagColor: 'text-orange-500',
    title: 'The Meta Ads Playbook',
    description:
      'The exact framework I use to run profitable Meta ads for clients. Campaign structure, budgets, creatives, scaling — no fluff, just what works.',
    type: 'Ebook',
    href: '#store',
  },
  {
    tag: 'DIY Course',
    tagColor: 'text-zinc-500 dark:text-zinc-400',
    title: 'Run Ads Yourself — From Zero',
    description:
      'A step-by-step course to run your own Facebook & Instagram ads without hiring an agency. Built for founders and D2C brand owners.',
    type: 'Course',
    href: '#store',
  },
  {
    tag: 'DFY Service',
    tagColor: 'text-zinc-500 dark:text-zinc-400',
    title: 'Done-For-You Ad Management',
    description:
      'I run your ads end-to-end — strategy, creative briefing, launch, optimization. You focus on the product, I bring you customers.',
    type: 'Service',
    href: '#store',
  },
  {
    tag: 'AI + Creativity',
    tagColor: 'text-zinc-500 dark:text-zinc-400',
    title: 'AI Images & Videos Masterclass',
    description:
      'How I generate high-converting ad creatives and content using AI image and video tools. Prompts, workflows, and tools included.',
    type: 'Course',
    href: '#store',
  },
  {
    tag: 'Writing',
    tagColor: 'text-zinc-500 dark:text-zinc-400',
    title: 'The D2C Brand Builder',
    description:
      'Lessons from building a D2C clothing brand from scratch to ₹12L+ in revenue — what worked, what failed, and how to do it faster.',
    type: 'Book',
    href: '#store',
  },
  {
    tag: 'Coming soon',
    tagColor: 'text-zinc-500 dark:text-zinc-400',
    title: 'Arqo Studio — Growth Templates',
    description:
      'Plug-and-play marketing templates, ad copy frameworks, and creative briefs used at Arqo Studio for real client campaigns.',
    type: 'Bundle',
    href: '#store',
  },
];

const stats = [
  { value: '₹12L+', label: 'Revenue Generated', sublabel: 'Own D2C Clothing Brand' },
  { value: '3+', label: 'Years Running Ads', sublabel: 'Meta & Google' },
  { value: '∞', label: 'Ideas Shipped', sublabel: 'Arqo Studio' },
];
---

<Layout>
  <!-- NAVBAR -->
  <header class="sticky top-0 z-50 w-full border-b border-zinc-100 bg-white/80 backdrop-blur-sm dark:border-zinc-800 dark:bg-zinc-950/80">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex items-center justify-between py-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 text-base font-bold text-zinc-900 dark:text-zinc-100">
          Vatsal Jain<span class="text-orange-500">.io</span>
        </a>

        <!-- Nav links -->
        <nav class="hidden items-center gap-8 md:flex">
          <a href="#about" class="text-sm font-medium text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">About</a>
          <a href="/vault" class="text-sm font-semibold text-orange-500 transition hover:text-orange-600 dark:text-orange-400">AI Ad Vault</a>
          <a href="#store" class="text-sm font-medium text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">Store</a>
          <a href="#writing" class="text-sm font-medium text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">Writing</a>
          <a href="#work-with-me" class="text-sm font-medium text-zinc-600 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">Work with me</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Dark mode toggle -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="flex h-9 w-9 items-center justify-center rounded-none text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
          >
            <!-- Sun icon (shown in dark) -->
            <svg id="icon-sun" class="hidden h-5 w-5 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <!-- Moon icon (shown in light) -->
            <svg id="icon-moon" class="h-5 w-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </button>

          <!-- CTA button -->
          <a
            href="/vault"
            class="hidden rounded-none bg-orange-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-orange-600 sm:inline-flex"
          >
            AI Ad Vault
          </a>

          <!-- Mobile hamburger -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="flex h-9 w-9 items-center justify-center rounded-none text-zinc-600 transition hover:bg-zinc-100 md:hidden dark:text-zinc-400 dark:hover:bg-zinc-800"
            aria-label="Toggle menu"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden pb-4 md:hidden">
        <nav class="flex flex-col gap-4">
          <a href="#about" class="text-sm font-medium text-zinc-600 dark:text-zinc-400">About</a>
          <a href="/vault" class="text-sm font-semibold text-orange-500 dark:text-orange-400">AI Ad Vault (New)</a>
          <a href="#store" class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Store</a>
          <a href="#writing" class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Writing</a>
          <a href="#work-with-me" class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Work with me</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="flex-auto">

    <!-- HERO -->
    <section id="about" class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
      <div class="flex flex-col gap-10 md:flex-row md:items-center md:justify-between">
        <!-- Left: text -->
        <div class="max-w-2xl">
          <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 sm:text-5xl leading-tight">
            D2C founder. Ad man.<br />
            <a href="#store" class="underline decoration-orange-500 decoration-2 underline-offset-[6px] transition hover:decoration-orange-400">
              Hustler
            </a> building online.
          </h1>
          <p class="mt-6 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            I'm Vatsal, founder of <strong class="text-zinc-900 dark:text-zinc-100">Arqo Studio</strong>. I ran my own D2C clothing brand — built it to ₹12 lakhs in revenue. Now I run ads for a living, create AI images and videos, and sell products that help other hustlers grow faster.
          </p>

          <!-- Quick links -->
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/vault"
              class="inline-flex items-center gap-1.5 rounded-none bg-orange-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-orange-600 shadow-sm"
            >
              AI Ad Creative Vault <span aria-hidden="true">→</span>
            </a>
            <a
              href="#store"
              class="inline-flex items-center gap-1 text-sm font-medium text-zinc-700 transition hover:text-orange-500 dark:text-zinc-300 dark:hover:text-orange-400"
            >
              Browse all products <span aria-hidden="true">→</span>
            </a>
            <a
              href="#work-with-me"
              class="inline-flex items-center gap-1 text-sm font-medium text-zinc-500 transition hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              Work with me <span aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Social links -->
          <div class="mt-8 flex gap-5">
            <!-- Twitter / X -->
            <a href="https://twitter.com/" class="group -m-1 p-1" aria-label="Follow on Twitter">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 fill-zinc-400 transition group-hover:fill-zinc-600 dark:fill-zinc-500 dark:group-hover:fill-zinc-300">
                <path d="M20.055 7.983c.011.174.011.347.011.523 0 5.338-3.92 11.494-11.09 11.494v-.003A10.755 10.755 0 0 1 3 18.186c.308.038.618.057.928.058a7.655 7.655 0 0 0 4.841-1.733c-1.668-.032-3.13-1.16-3.642-2.805a3.753 3.753 0 0 0 1.76-.07C5.07 13.256 3.76 11.6 3.76 9.676v-.05a3.77 3.77 0 0 0 1.77.505C3.816 8.945 3.288 6.583 4.322 4.737c1.98 2.524 4.9 4.058 8.034 4.22a4.137 4.137 0 0 1 1.128-3.86A3.807 3.807 0 0 1 19 5.274a7.657 7.657 0 0 0 2.475-.98c-.29.934-.9 1.729-1.713 2.233A7.54 7.54 0 0 0 22 5.89a8.084 8.084 0 0 1-1.945 2.093Z"/>
              </svg>
            </a>
            <!-- Instagram -->
            <a href="https://instagram.com/" class="group -m-1 p-1" aria-label="Follow on Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 fill-zinc-400 transition group-hover:fill-zinc-600 dark:fill-zinc-500 dark:group-hover:fill-zinc-300">
                <path d="M12 3c-2.444 0-2.75.01-3.71.054-.959.044-1.613.196-2.185.418A4.412 4.412 0 0 0 4.51 4.511c-.5.5-.809 1.002-1.039 1.594-.222.572-.374 1.226-.418 2.184C3.01 9.25 3 9.556 3 12s.01 2.75.054 3.71c.044.959.196 1.613.418 2.185.23.592.538 1.094 1.039 1.595.5.5 1.002.808 1.594 1.038.572.222 1.226.374 2.184.418C9.25 20.99 9.556 21 12 21s2.75-.01 3.71-.054c.959-.044 1.613-.196 2.185-.419a4.412 4.412 0 0 0 1.595-1.038c.5-.5.808-1.002 1.038-1.594.222-.572.374-1.226.418-2.184.044-.96.054-1.267.054-3.711s-.01-2.75-.054-3.71c-.044-.959-.196-1.613-.419-2.185A4.412 4.412 0 0 0 19.49 4.51c-.5-.5-1.002-.809-1.594-1.039-.572-.222-1.226-.374-2.184-.418C14.75 3.01 14.444 3 12 3Zm0 1.622c2.403 0 2.688.009 3.637.052.877.04 1.354.187 1.67.31.421.163.72.358 1.036.673.315.315.51.615.673 1.035.123.317.27.794.31 1.671.043.95.052 1.234.052 3.637s-.009 2.688-.052 3.637c-.04.877-.187 1.354-.31 1.67-.163.421-.358.72-.673 1.036a2.79 2.79 0 0 1-1.035.673c-.317.123-.794.27-1.671.31-.95.043-1.234.052-3.637.052s-2.688-.009-3.637-.052c-.877-.04-1.354-.187-1.67-.31a2.789 2.789 0 0 1-1.036-.673 2.79 2.79 0 0 1-.673-1.035c-.123-.317-.27-.794-.31-1.671-.043-.95-.052-1.234-.052-3.637s.009-2.688.052-3.637c.04-.877.187-1.354.31-1.67.163-.421.358-.72.673-1.036.315-.315.615-.51 1.035-.673.317-.123.794-.27 1.671-.31.95-.043 1.234-.052 3.637-.052Z"/>
                <path d="M12 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm0-7.622a4.622 4.622 0 1 0 0 9.244 4.622 4.622 0 0 0 0-9.244Zm5.884-.182a1.08 1.08 0 1 1-2.16 0 1.08 1.08 0 0 1 2.16 0Z"/>
              </svg>
            </a>
            <!-- LinkedIn -->
            <a href="https://linkedin.com/" class="group -m-1 p-1" aria-label="Connect on LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 fill-zinc-400 transition group-hover:fill-zinc-600 dark:fill-zinc-500 dark:group-hover:fill-zinc-300">
                <path d="M18.335 18.339H15.67v-4.177c0-.996-.02-2.278-1.39-2.278-1.389 0-1.601 1.084-1.601 2.205v4.25h-2.666V9.75h2.56v1.17h.035c.358-.674 1.228-1.387 2.528-1.387 2.7 0 3.2 1.778 3.2 4.091v4.715zM7.003 8.575a1.546 1.546 0 01-1.548-1.549 1.548 1.548 0 111.547 1.549zm1.336 9.764H5.666V9.75H8.34v8.589zM19.67 3H4.329C3.593 3 3 3.58 3 4.297v15.406C3 20.42 3.594 21 4.328 21h15.338C20.4 21 21 20.42 21 19.703V4.297C21 3.58 20.4 3 19.666 3h.003z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: photo placeholder -->
        <div class="shrink-0 md:pl-8">
          <div class="relative aspect-square w-44 rotate-2 overflow-hidden rounded-2xl bg-zinc-100 shadow-lg ring-1 ring-zinc-900/5 sm:w-52 md:w-56 dark:bg-zinc-800 dark:ring-white/10">
            <!-- Replace src with your actual photo -->
            <div class="flex h-full w-full items-center justify-center bg-zinc-200 dark:bg-zinc-700">
              <span class="text-4xl font-bold text-zinc-400 dark:text-zinc-500">VJ</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS STRIP -->
    <div class="border-y border-zinc-100 dark:border-zinc-800">
      <div class="mx-auto max-w-5xl px-5 py-8 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {stats.map((s) => (
            <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
              <span class="text-3xl font-bold text-zinc-900 dark:text-zinc-100">{s.value}</span>
              <span class="mt-1 text-sm font-semibold text-zinc-700 dark:text-zinc-300">{s.label}</span>
              <span class="text-xs text-zinc-400 dark:text-zinc-500">{s.sublabel}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- STORE / PRODUCTS -->
    <section id="store" class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <!-- Section heading -->
      <div class="flex items-center gap-3 mb-2">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-6 w-6 flex-none">
          <path d="M2.75 9.75a3 3 0 0 1 3-3h12.5a3 3 0 0 1 3 3v8.5a3 3 0 0 1-3 3H5.75a3 3 0 0 1-3-3v-8.5Z" class="fill-zinc-100 stroke-zinc-400 dark:fill-zinc-100/10 dark:stroke-zinc-500"/>
          <path d="M3 14.25h6.249c.484 0 .952-.002 1.316.319l.777.682a.996.996 0 0 0 1.316 0l.777-.682c.364-.32.832-.319 1.316-.319H21M8.75 6.5V4.75a2 2 0 0 1 2-2h2.5a2 2 0 0 1 2 2V6.5" class="stroke-zinc-400 dark:stroke-zinc-500"/>
        </svg>
        <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">What I sell</h2>
      </div>
      <!-- COMPACT FEATURED PRODUCT (AI AD CREATIVE VAULT) -->
      <div class="mb-12 border border-orange-500/30 bg-orange-500/[0.03] p-6 sm:p-8 dark:border-orange-500/40 dark:bg-orange-500/[0.04]">
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="max-w-xl">
            <div class="flex items-center gap-2">
              <span class="bg-orange-500 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">Flagship Vault</span>
              <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Launch Offer</span>
            </div>
            <h3 class="mt-2 text-xl font-bold text-zinc-900 dark:text-zinc-100">
              AI Ad Creative Vault
            </h3>
            <p class="mt-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-300 leading-relaxed">
              50 proven static ad creatives for Meta, plus the exact AI prompts and workflow to remake them for your own brand in an afternoon.
            </p>
            <ul class="mt-3.5 space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400">
              <li class="flex items-center gap-2">
                <span class="text-orange-500 font-bold">✓</span>
                <span>50 static ad frameworks with underlying psychology</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-orange-500 font-bold">✓</span>
                <span>Copy-paste AI prompts to reproduce each visual</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-orange-500 font-bold">✓</span>
                <span>1-page testing & decision checklist</span>
              </li>
            </ul>
          </div>

          <div class="flex shrink-0 flex-col items-start md:items-end gap-3 border-t border-orange-500/20 pt-4 md:border-t-0 md:pt-0">
            <div>
              <span class="text-xs text-zinc-400 line-through">₹2,499</span>
              <span class="ml-1.5 text-2xl font-extrabold text-orange-500 sm:text-3xl">₹999</span>
            </div>
            <a
              href="/vault"
              class="inline-flex items-center gap-2 bg-orange-500 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-orange-600 shadow-sm"
            >
              See the Vault <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>

      <ul role="list" class="grid grid-cols-1 gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <li class="group relative flex flex-col items-start">
            <!-- Tag (type label) -->
            <span class={`relative z-10 order-first mb-3 flex items-center text-sm ${product.tagColor}`}>
              {product.tag}
            </span>

            <!-- Thumb placeholder -->
            <span class="relative z-10 order-first mb-4 block w-full overflow-hidden rounded-xl bg-zinc-100 ring-1 ring-zinc-900/5 dark:bg-zinc-800 dark:ring-white/10" style="margin-top: 0;">
              <div class="aspect-[16/10] w-full flex items-center justify-center bg-zinc-100 dark:bg-zinc-800">
                <span class="text-xs font-medium text-zinc-400 dark:text-zinc-500 uppercase tracking-widest">{product.type}</span>
              </div>
            </span>

            <!-- Product title -->
            <h3 class="text-base font-semibold tracking-tight text-orange-500 underline-offset-4 transition group-hover:underline dark:text-orange-400">
              <div class="absolute -inset-x-4 -inset-y-6 z-0 scale-95 bg-zinc-50 opacity-0 transition group-hover:scale-100 group-hover:opacity-100 dark:bg-zinc-800/50 sm:-inset-x-6 sm:rounded-2xl"></div>
              <a href={product.href}>
                <span class="absolute -inset-x-4 -inset-y-6 z-20 sm:-inset-x-6 sm:rounded-2xl"></span>
                <span class="relative z-10">{product.title}</span>
              </a>
            </h3>

            <!-- Description -->
            <p class="relative z-10 mt-2 text-sm text-zinc-600 dark:text-zinc-400">
              {product.description}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <!-- WRITING / BLOG TEASER -->
    <section id="writing" class="border-t border-zinc-100 dark:border-zinc-800">
      <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
        <div class="flex items-center gap-3 mb-2">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-6 w-6">
            <path d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" class="stroke-zinc-400 dark:stroke-zinc-500"/>
          </svg>
          <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Writing</h2>
        </div>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-8 max-w-xl">
          Raw notes on running ads, building D2C brands, and using AI — no fluff, just what I've learned the hard way.
        </p>

        <!-- Article placeholders -->
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
          {[
            {
              date: 'Sept 10, 2026',
              dateTime: '2026-09-10',
              title: 'How I Scaled a D2C Clothing Brand to ₹12L Without a Big Budget',
              excerpt: 'The exact ad strategy, product positioning, and organic plays that took my clothing brand from zero to twelve lakhs in revenue — mistakes included.',
            },
            {
              date: 'Aug 28, 2026',
              dateTime: '2026-08-28',
              title: 'Why Most People Burn Money on Meta Ads (and How to Stop)',
              excerpt: 'After running ads for dozens of brands, these are the five structural mistakes I see again and again that kill ROAS before a campaign even has a chance.',
            },
            {
              date: 'Aug 14, 2026',
              dateTime: '2026-08-14',
              title: 'AI Images That Actually Convert: My Full Creative Workflow',
              excerpt: 'My end-to-end process for generating ad creatives with AI tools that look custom-made, not AI-generated. Prompts, post-processing, and what to avoid.',
            },
            {
              date: 'Jul 30, 2026',
              dateTime: '2026-07-30',
              title: 'Starting Arqo Studio: What I Got Right, What I Got Wrong',
              excerpt: 'The honest story of building Arqo Studio — the first clients, pricing mistakes, and what I would do differently on day one.',
            },
          ].map((article) => (
            <article class="group relative flex flex-col items-start">
              <h2 class="text-base font-semibold tracking-tight text-orange-500 underline-offset-4 transition group-hover:underline dark:text-orange-400">
                <div class="absolute -inset-x-4 -inset-y-6 z-0 scale-95 bg-zinc-50 opacity-0 transition group-hover:scale-100 group-hover:opacity-100 dark:bg-zinc-800/50 sm:-inset-x-6 sm:rounded-2xl"></div>
                <a href="#writing">
                  <span class="absolute -inset-x-4 -inset-y-6 z-20 sm:-inset-x-6 sm:rounded-2xl"></span>
                  <span class="relative z-10">{article.title}</span>
                </a>
              </h2>
              <time class="relative z-10 order-first mb-3 flex items-center pl-3.5 text-sm text-zinc-400 dark:text-zinc-500" datetime={article.dateTime}>
                <span class="absolute inset-y-0 left-0 flex items-center" aria-hidden="true">
                  <span class="h-4 w-0.5 rounded-full bg-zinc-200 dark:bg-zinc-600"></span>
                </span>
                {article.date}
              </time>
              <p class="relative z-10 mt-2 text-sm text-zinc-600 dark:text-zinc-400">
                {article.excerpt}
              </p>
            </article>
          ))}
        </div>

        <a href="#writing" class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-orange-500 transition hover:text-orange-600 dark:text-orange-400">
          All articles
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="ml-1 h-4 w-4 stroke-current">
            <path d="M6.75 5.75 9.25 8l-2.5 2.25" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- WORK WITH ME -->
    <section id="work-with-me" class="border-t border-zinc-100 dark:border-zinc-800">
      <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16 items-start">
          <!-- Left -->
          <div>
            <div class="flex items-center gap-3 mb-2">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-6 w-6">
                <path d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z" class="stroke-zinc-400 dark:stroke-zinc-500"/>
              </svg>
              <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Work with me</h2>
            </div>
            <p class="mt-4 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
              If you're a D2C brand or business that wants to grow through paid ads, I offer a fully done-for-you ad management service through <strong class="text-zinc-900 dark:text-zinc-100">Arqo Studio</strong>. Strategy, creative, launch, and optimization — all handled.
            </p>
            <ul class="mt-6 space-y-3 text-sm text-zinc-600 dark:text-zinc-400">
              {[
                'Meta Ads (Facebook & Instagram)',
                'Creative strategy & AI-generated creatives',
                'Campaign structure, scaling & optimization',
                'Monthly reporting & transparent results',
              ].map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 h-4 w-4 shrink-0 text-orange-500">✓</span>
                  {item}
                </li>
              ))}
            </ul>
            <a
              href="mailto:hey@vatsaljain.io"
              class="mt-8 inline-flex items-center gap-2 rounded-none bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white"
            >
              Let's talk
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="h-4 w-4 stroke-current">
                <path d="M6.75 5.75 9.25 8l-2.5 2.25" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <!-- Right: newsletter -->
          <div class="rounded-2xl border border-zinc-100 p-6 dark:border-zinc-800">
            <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">Stay in the loop</h3>
            <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
              Get notified when I drop new writing, products, or playbooks. No spam. Unsubscribe any time.
            </p>
            <form class="mt-5" onsubmit="return false;">
              <div class="flex gap-3">
                <label for="email-input" class="sr-only">Email address</label>
                <input
                  id="email-input"
                  type="email"
                  placeholder="your@email.com"
                  class="min-w-0 flex-auto rounded-none border border-zinc-200 bg-white px-4 py-2 text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-orange-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:placeholder:text-zinc-500"
                />
                <button
                  type="submit"
                  class="flex-none rounded-none bg-orange-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-orange-600"
                >
                  Subscribe
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="border-t border-zinc-100 dark:border-zinc-800">
    <div class="mx-auto max-w-5xl px-5 py-10 sm:px-8 lg:px-12">
      <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
        <p class="text-sm text-zinc-400 dark:text-zinc-500">
          © {new Date().getFullYear()} Vatsal Jain · Arqo Studio
        </p>
        <nav class="flex gap-6">
          <a href="#about" class="text-sm text-zinc-400 transition hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300">About</a>
          <a href="#store" class="text-sm text-zinc-400 transition hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300">Store</a>
          <a href="#writing" class="text-sm text-zinc-400 transition hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300">Writing</a>
          <a href="mailto:hey@vatsaljain.io" class="text-sm text-zinc-400 transition hover:text-zinc-600 dark:text-zinc-500 dark:hover:text-zinc-300">Contact</a>
        </nav>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Dark mode toggle
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile menu
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu on nav click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
  });
</script>
