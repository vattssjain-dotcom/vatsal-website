---
import Layout from '../layouts/Layout.astro';

const offers = [
  {
    num: '01',
    tag: '50 Proven Ads & Checklist',
    tagColor: 'text-[#E24A1F] font-bold',
    title: 'Static Ad Vault',
    price: '₹999',
    oldPrice: '₹2,499',
    description:
      '50 proven static ad concepts and teardowns for problem-solving products and services. Whether selling skincare or an AI tool, see why they work and build your ads in an afternoon.',
    type: '50 Creatives + Checklist',
    badge: 'Instant Access',
    ctaText: 'Explore The Vault →',
    href: '/vault',
    isExternal: false,
  },
  {
    num: '02',
    tag: 'Creative Production',
    tagColor: 'text-[#E24A1F] font-bold',
    title: '25 Custom Static Ads Pack',
    price: '₹4,000',
    oldPrice: '₹12,000',
    description:
      'We craft 25 custom static ad concepts specifically for your brand. Every ad delivered in 1:1, 9:16, and 16:9 formats (75 total export files) in 3 to 5 days.',
    type: 'Asset Pack',
    badge: 'Custom Delivery',
    ctaText: 'Get 25 Custom Ads →',
    href: '/static-ads',
    isExternal: false,
  },
  {
    num: '03',
    tag: 'Audit + 1-on-1 Mentorship',
    tagColor: 'text-[#E24A1F] font-bold',
    title: 'Roast My Ads & Funnel',
    price: '₹10,000',
    oldPrice: '',
    description:
      'Unfiltered video teardown of your ad creatives, copy, and landing page plus 4 weekly 1-on-1 private calls over a month to help implement fixes and scale.',
    type: 'Audit + Mentorship',
    badge: '4 Spots / Mo',
    ctaText: 'Book Funnel Roast →',
    href: '/roast-my-ads',
    isExternal: false,
  },
  {
    num: '04',
    tag: 'Agency Partnership',
    tagColor: 'text-[#141416] font-bold',
    title: 'Done-For-You Ad Management',
    price: 'Retainer',
    oldPrice: '',
    description:
      'Full-service paid acquisition through Arqo Studio. Strategy, creative briefing, launch, scaling, and daily account optimization handled end-to-end.',
    type: 'DFY Agency',
    badge: 'Arqo Studio',
    ctaText: 'Book a Call on Arqo Studio ↗',
    href: 'https://arqostudio.com/contact',
    isExternal: true,
  },
];

const stats = [
  { value: '₹12L+', label: 'Revenue Generated', sublabel: 'Own D2C Clothing Brand' },
  { value: '3+', label: 'Years Running Ads', sublabel: 'Meta & Google' },
  { value: '∞', label: 'Ideas Shipped', sublabel: 'Arqo Studio' },
];

const instagramPosts = [
  {
    id: 'DeUGIWbqqUi',
    url: 'https://www.instagram.com/vatspective/reel/DeUGIWbqqUi/',
    image: '/instagram/reel-1.jpg',
    title: 'Four ways to increase the AOV without changing the product',
    type: 'Reel',
    tag: 'D2C Strategy',
  },
  {
    id: 'DeO9NnLKjRH',
    url: 'https://www.instagram.com/vatspective/reel/DeO9NnLKjRH/',
    image: '/instagram/reel-2.jpg',
    title: 'What hitting 7 Figures in clothing sales taught me about Meta Ads',
    type: 'Reel',
    tag: 'Meta Ads',
  },
  {
    id: 'DeMvTxaiC--',
    url: 'https://www.instagram.com/vatspective/p/DeMvTxaiC--/',
    image: '/instagram/post-3.jpg',
    title: '70 Closing Scripts That Close The Deal',
    type: 'Carousel',
    tag: 'Sales & Closing',
  },
  {
    id: 'DeJ3tzjCGF3',
    url: 'https://www.instagram.com/vatspective/p/DeJ3tzjCGF3/',
    image: '/instagram/post-4.jpg',
    title: 'How Top Closers Handle Objections without pitching or defending',
    type: 'Carousel',
    tag: 'Objection Handling',
  },
  {
    id: 'DeJh0uLlHu6',
    url: 'https://www.instagram.com/vatspective/p/DeJh0uLlHu6/',
    image: '/instagram/post-5.jpg',
    title: '5 pricing rules that sound completely wrong... but actually work',
    type: 'Carousel',
    tag: 'Pricing Strategy',
  },
  {
    id: 'DeCJrDJKZW2',
    url: 'https://www.instagram.com/vatspective/reel/DeCJrDJKZW2/',
    image: '/instagram/reel-7.jpg',
    title: 'Four ways to get more people to show up on sales calls',
    type: 'Reel',
    tag: 'Funnel Optimization',
  },
];
---

<Layout
  title="Vatsal Jain | Direct-to-Consumer Founder & Ad Strategist"
  description="Direct-to-consumer founder and ad strategist. Proven static ad systems, custom creative production, and full-funnel ad audits through Arqo Studio."
>
  <!-- NAVBAR -->
  <header class="sticky top-0 z-50 w-full border-b border-[#E8E6E1] bg-[#FAF9F6]/90 backdrop-blur-md">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex items-center justify-between py-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-1.5 text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.io</span>
        </a>

        <!-- Nav links: About, Articles, Products -->
        <nav class="hidden items-center gap-8 md:flex">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Products</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Button: Roast My Ads -->
          <a
            href="/roast-my-ads"
            class="inline-flex items-center gap-1.5 rounded-md bg-[#E24A1F] px-4 py-2 text-xs sm:text-sm font-bold text-white transition hover:bg-[#C53B12] shadow-sm"
          >
            Roast My Ads →
          </a>

          <!-- Mobile hamburger -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="flex h-9 w-9 items-center justify-center rounded-md border border-[#E8E6E1] text-[#5E5D64] transition hover:bg-white md:hidden"
            aria-label="Toggle menu"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden pb-4 md:hidden border-t border-[#E8E6E1] pt-3">
        <nav class="flex flex-col gap-3">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64]">Products</a>
          <a href="/roast-my-ads" class="text-sm font-semibold text-[#E24A1F]">Roast My Ads</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="flex-auto">

    <!-- HERO -->
    <section id="about" class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-24 lg:px-12">
      <div class="flex flex-col gap-10 md:flex-row md:items-center md:justify-between">
        <!-- Left: text -->
        <div class="max-w-2xl">
          <span class="inline-block text-xs font-bold uppercase tracking-wider text-[#E24A1F] mb-3">
            Direct-to-consumer founder &amp; ad strategist
          </span>
          <h1 class="text-4xl font-extrabold tracking-tight text-[#141416] sm:text-5xl lg:text-6xl leading-[1.08]">
            D2C founder. Ad man.<br />
            <a href="#products" class="underline decoration-[#E24A1F] decoration-3 underline-offset-[8px] transition hover:decoration-[#C53B12]">
              Hustler
            </a> building online.
          </h1>
          <p class="mt-6 text-base text-[#5E5D64] sm:text-lg leading-relaxed max-w-xl">
            I'm Vatsal, founder of <strong class="text-[#141416] font-semibold">Arqo Studio</strong>. I ran my own D2C clothing brand and built it to <strong class="text-[#141416]">₹12 lakhs in revenue</strong>. Now I run ads for a living, create AI images and videos, and build growth systems.
          </p>

          <!-- Quick links -->
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              href="/roast-my-ads"
              class="inline-flex items-center gap-1.5 rounded-md bg-[#E24A1F] px-4 py-2.5 text-sm font-bold text-white transition hover:bg-[#C53B12] shadow-sm"
            >
              🔥 Roast My Ads →
            </a>
            <a
              href="/vault"
              class="inline-flex items-center gap-1.5 rounded-md border border-[#E8E6E1] bg-white px-4 py-2.5 text-sm font-bold text-[#141416] transition hover:border-[#141416]/40 hover:text-[#E24A1F] shadow-2xs"
            >
              Static Ad Vault (₹999) →
            </a>
            <a
              href="#products"
              class="inline-flex items-center gap-1 text-sm font-semibold text-[#5E5D64] transition hover:text-[#141416]"
            >
              All 4 offers →
            </a>
          </div>

          <!-- Social links -->
          <div class="mt-8 flex gap-5">
            <a href="https://twitter.com/" class="group -m-1 p-1" aria-label="Follow on Twitter">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 fill-[#8E8D94] transition group-hover:fill-[#141416]">
                <path d="M20.055 7.983c.011.174.011.347.011.523 0 5.338-3.92 11.494-11.09 11.494v-.003A10.755 10.755 0 0 1 3 18.186c.308.038.618.057.928.058a7.655 7.655 0 0 0 4.841-1.733c-1.668-.032-3.13-1.16-3.642-2.805a3.753 3.753 0 0 0 1.76-.07C5.07 13.256 3.76 11.6 3.76 9.676v-.05a3.77 3.77 0 0 0 1.77.505C3.816 8.945 3.288 6.583 4.322 4.737c1.98 2.524 4.9 4.058 8.034 4.22a4.137 4.137 0 0 1 1.128-3.86A3.807 3.807 0 0 1 19 5.274a7.657 7.657 0 0 0 2.475-.98c-.29.934-.9 1.729-1.713 2.233A7.54 7.54 0 0 0 22 5.89a8.084 8.084 0 0 1-1.945 2.093Z"/>
              </svg>
            </a>
            <a href="https://instagram.com/vatspective" target="_blank" rel="noopener noreferrer" class="group -m-1 p-1" aria-label="Follow on Instagram @vatspective">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 fill-[#8E8D94] transition group-hover:fill-[#141416]">
                <path d="M12 3c-2.444 0-2.75.01-3.71.054-.959.044-1.613.196-2.185.418A4.412 4.412 0 0 0 4.51 4.511c-.5.5-.809 1.002-1.039 1.594-.222.572-.374 1.226-.418 2.184C3.01 9.25 3 9.556 3 12s.01 2.75.054 3.71c.044.959.196 1.613.418 2.185.23.592.538 1.094 1.039 1.595.5.5 1.002.808 1.594 1.038.572.222 1.226.374 2.184.418C9.25 20.99 9.556 21 12 21s2.75-.01 3.71-.054c.959-.044 1.613-.196 2.185-.419a4.412 4.412 0 0 0 1.595-1.038c.5-.5.808-1.002 1.038-1.594.222-.572.374-1.226.418-2.184.044-.96.054-1.267.054-3.711s-.01-2.75-.054-3.71c-.044-.959-.196-1.613-.419-2.185A4.412 4.412 0 0 0 19.49 4.51c-.5-.5-1.002-.809-1.594-1.039-.572-.222-1.226-.374-2.184-.418C14.75 3.01 14.444 3 12 3Zm0 1.622c2.403 0 2.688.009 3.637.052.877.04 1.354.187 1.67.31.421.163.72.358 1.036.673.315.315.51.615.673 1.035.123.317.27.794.31 1.671.043.95.052 1.234.052 3.637s-.009 2.688-.052 3.637c-.04.877-.187 1.354-.31 1.67-.163.421-.358.72-.673 1.036a2.79 2.79 0 0 1-1.035.673c-.317.123-.794.27-1.671.31-.95.043-1.234.052-3.637.052s-2.688-.009-3.637-.052c-.877-.04-1.354-.187-1.67-.31a2.789 2.789 0 0 1-1.036-.673 2.79 2.79 0 0 1-.673-1.035c-.123-.317-.27-.794-.31-1.671-.043-.95-.052-1.234-.052-3.637s.009-2.688.052-3.637c.04-.877.187-1.354.31-1.67.163-.421.358-.72.673-1.036.315-.315.615-.51 1.035-.673.317-.123.794-.27 1.671-.31.95-.043 1.234-.052 3.637-.052Z"/>
                <path d="M12 15a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm0-7.622a4.622 4.622 0 1 0 0 9.244 4.622 4.622 0 0 0 0-9.244Zm5.884-.182a1.08 1.08 0 1 1-2.16 0 1.08 1.08 0 0 1 2.16 0Z"/>
              </svg>
            </a>
            <a href="https://linkedin.com/" class="group -m-1 p-1" aria-label="Connect on LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 fill-[#8E8D94] transition group-hover:fill-[#141416]">
                <path d="M18.335 18.339H15.67v-4.177c0-.996-.02-2.278-1.39-2.278-1.389 0-1.601 1.084-1.601 2.205v4.25h-2.666V9.75h2.56v1.17h.035c.358-.674 1.228-1.387 2.528-1.387 2.7 0 3.2 1.778 3.2 4.091v4.715zM7.003 8.575a1.546 1.546 0 01-1.548-1.549 1.548 1.548 0 111.547 1.549zm1.336 9.764H5.666V9.75H8.34v8.589zM19.67 3H4.329C3.593 3 3 3.58 3 4.297v15.406C3 20.42 3.594 21 4.328 21h15.338C20.4 21 21 20.42 21 19.703V4.297C21 3.58 20.4 3 19.666 3h.003z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Vertical Hero Reel Video with Roast My Ads Button -->
        <div class="shrink-0 flex justify-center md:pl-8">
          <div class="group relative aspect-[9/16] w-60 sm:w-64 overflow-hidden rounded-2xl bg-black border border-[#E8E6E1] shadow-xl">
            <!-- Video Player (WebM primary, MP4 fallback) -->
            <video
              id="hero-reel-video"
              poster="/hero-video-poster.jpg"
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              class="h-full w-full object-cover"
              aria-label="Vatsal Jain Ad Strategy Reel"
            >
              <source src="/hero-video.webm" type="video/webm" />
              <source src="/hero-video.mp4" type="video/mp4" />
              Your browser does not support the video tag.
            </video>

            <!-- Sound toggle button (top right) -->
            <button
              id="hero-sound-btn"
              type="button"
              class="absolute right-3 top-3 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-black/60 text-white backdrop-blur-xs transition hover:bg-black/85"
              aria-label="Toggle sound"
            >
              <svg id="sound-muted-icon" class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path d="M3.63 3.63a.75.75 0 0 0 0 1.06L7.38 8.44A8.7 8.7 0 0 0 7 10v4a8.7 8.7 0 0 0 3.3 6.82.75.75 0 0 0 1.2-.6v-5.44l4.72 4.72a7.25 7.25 0 0 1-3.47 1.45.75.75 0 0 0 .15 1.49 8.75 8.75 0 0 0 4.54-1.89l1.88 1.88a.75.75 0 1 0 1.06-1.06l-16.5-16.5a.75.75 0 0 0-1.06 0ZM10 18.17A7.2 7.2 0 0 1 8.5 14v-4a7.2 7.2 0 0 1 .3-2.02l2.7 2.7v7.49Zm6.5-8.17v-.17a7.2 7.2 0 0 0-5-6.83.75.75 0 1 0-.46 1.43A5.7 5.7 0 0 1 15 9.83v.34l1.5 1.5Zm3.5 0a10.7 10.7 0 0 0-8-10.36.75.75 0 1 0-.4 1.45A9.2 9.2 0 0 1 18.5 9.83v.34l1.5 1.5Z"/>
              </svg>
              <svg id="sound-unmuted-icon" class="hidden h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path d="M13.5 4.06c0-.85-.98-1.32-1.63-.78L7.6 7.25H4.25C3.01 7.25 2 8.26 2 9.5v5c0 1.24 1.01 2.25 2.25 2.25h3.35l4.27 3.97c.65.54 1.63.07 1.63-.78V4.06Zm3.28 2.22a.75.75 0 0 1 1.06 0 8 8 0 0 1 0 11.32.75.75 0 1 1-1.06-1.06 6.5 6.5 0 0 0 0-9.2.75.75 0 0 1 0-1.06Zm2.12-2.12a.75.75 0 0 1 1.06 0 11 11 0 0 1 0 15.56.75.75 0 1 1-1.06-1.06 9.5 9.5 0 0 0 0-13.44.75.75 0 0 1 0-1.06Z"/>
              </svg>
            </button>

            <!-- Play / Pause button (top left) -->
            <button
              id="hero-play-btn"
              type="button"
              class="absolute left-3 top-3 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-black/60 text-white backdrop-blur-xs transition hover:bg-black/85"
              aria-label="Pause or play"
            >
              <svg id="play-pause-icon" class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
              </svg>
            </button>

            <!-- Floating sticker button linking to Roast My Ads (Sanskar Tiwari style) -->
            <a
              href="/roast-my-ads"
              class="absolute bottom-4 left-1/2 z-20 flex -translate-x-1/2 items-center gap-1.5 whitespace-nowrap rounded-full bg-white px-4 py-2.5 text-xs font-bold text-[#141416] shadow-xl transition hover:bg-[#E24A1F] hover:text-white hover:scale-105"
            >
              <span>🔥</span>
              <span>Roast My Ads →</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS STRIP -->
    <div class="border-y border-[#E8E6E1] bg-white">
      <div class="mx-auto max-w-5xl px-5 py-8 sm:px-8 lg:px-12">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          {stats.map((s) => (
            <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
              <span class="text-3xl font-extrabold text-[#141416] tracking-tight">{s.value}</span>
              <span class="mt-1 text-sm font-bold text-[#141416]">{s.label}</span>
              <span class="text-xs text-[#5E5D64]">{s.sublabel}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- 4 CORE OFFERS / PRODUCTS -->
    <section id="products" class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="flex items-center gap-2.5 mb-2">
        <span class="text-base">💼</span>
        <h2 class="text-sm font-bold uppercase tracking-wider text-[#141416]">Products &amp; Services</h2>
      </div>
      <p class="text-sm text-[#5E5D64] mb-12 max-w-xl">
        Four focused ways to work together. From self-serve ad swipe files to bespoke creative packs, full-funnel audits, and done-for-you agency growth.
      </p>

      <!-- 4 OFFERS GRID -->
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {offers.map((offer) => (
          <div class="rounded-2xl border border-[#E8E6E1] bg-white p-7 shadow-xs flex flex-col justify-between transition hover:border-[#E24A1F]/50 hover:shadow-md">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class={`text-xs uppercase tracking-wider ${offer.tagColor}`}>
                  {offer.tag}
                </span>
                <span class="border border-[#E8E6E1] bg-[#FAF9F6] px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-[#5E5D64] rounded">
                  {offer.badge}
                </span>
              </div>

              <h3 class="text-xl font-bold text-[#141416]">
                {offer.title}
              </h3>

              <div class="mt-3 flex items-baseline gap-2">
                <span class="text-2xl font-extrabold text-[#E24A1F]">{offer.price}</span>
                {offer.oldPrice && (
                  <span class="text-xs text-[#8E8D94] line-through">{offer.oldPrice}</span>
                )}
              </div>

              <p class="mt-3 text-xs leading-relaxed text-[#5E5D64]">
                {offer.description}
              </p>
            </div>

            <div class="mt-6 pt-5 border-t border-[#E8E6E1]">
              <a
                href={offer.href}
                target={offer.isExternal ? '_blank' : undefined}
                rel={offer.isExternal ? 'noopener noreferrer' : undefined}
                class="inline-flex w-full items-center justify-center rounded-md bg-[#141416] px-4 py-2.5 text-xs font-bold text-white transition hover:bg-[#E24A1F] shadow-xs"
              >
                {offer.ctaText}
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ARTICLES / WRITING -->
    <section id="articles" class="border-t border-[#E8E6E1] bg-white">
      <div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
        <div class="flex items-center gap-2.5 mb-2">
          <span class="text-base">📄</span>
          <h2 class="text-sm font-bold uppercase tracking-wider text-[#141416]">Articles</h2>
        </div>
        <p class="text-sm text-[#5E5D64] mb-10 max-w-xl">
          Raw notes on running ads, building D2C brands, and using AI. No fluff, just what I've learned the hard way.
        </p>

        <!-- Article items -->
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
          {[
            {
              date: 'Sept 10, 2026',
              dateTime: '2026-09-10',
              title: 'How I Scaled a D2C Clothing Brand to ₹12L Without a Big Budget',
              excerpt: 'The exact ad strategy, product positioning, and organic plays that took my clothing brand from zero to twelve lakhs in revenue, mistakes included.',
            },
            {
              date: 'Aug 28, 2026',
              dateTime: '2026-08-28',
              title: 'Why Most People Burn Money on Meta Ads (and How to Stop)',
              excerpt: 'After running ads for dozens of brands, these are the five structural mistakes I see again and again that kill ROAS before a campaign even has a chance.',
            },
            {
              date: 'Aug 14, 2026',
              dateTime: '2026-08-14',
              title: 'AI Images That Actually Convert: My Full Creative Workflow',
              excerpt: 'My end-to-end process for generating ad creatives with AI tools that look custom-made, not AI-generated. Prompts, post-processing, and what to avoid.',
            },
            {
              date: 'Jul 30, 2026',
              dateTime: '2026-07-30',
              title: 'Starting Arqo Studio: What I Got Right, What I Got Wrong',
              excerpt: 'The honest story of building Arqo Studio: the first clients, pricing mistakes, and what I would do differently on day one.',
            },
          ].map((article) => (
