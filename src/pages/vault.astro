---
import Layout from '../layouts/Layout.astro';

const vaultCollage = [
  {
    type: 'Side-by-Side Comparison',
    title: 'The "Old Way vs New Way" Contrast',
    tag: 'Comparison',
    accent: 'border-[#E24A1F]/30 bg-[#E24A1F]/[0.05]',
    pill: 'text-[#E24A1F] bg-[#E24A1F]/10',
  },
  {
    type: 'Social Proof Mashup',
    title: 'Customer DM / Tweet Overlay',
    tag: 'Social Proof',
    accent: 'border-[#E8E6E1] bg-white',
    pill: 'text-[#5E5D64] bg-[#F5F3EF]',
  },
  {
    type: 'Product in Use',
    title: 'The Real-Life Context Shot',
    tag: 'Contextual',
    accent: 'border-[#E24A1F]/30 bg-[#E24A1F]/[0.05]',
    pill: 'text-[#E24A1F] bg-[#E24A1F]/10',
  },
  {
    type: 'Feature Breakdown',
    title: 'Anatomy / Exploded View',
    tag: 'Product Demo',
    accent: 'border-[#E8E6E1] bg-white',
    pill: 'text-[#5E5D64] bg-[#F5F3EF]',
  },
  {
    type: 'Checklist / Audit',
    title: 'The "3 Common Mistakes" Graphic',
    tag: 'Educational',
    accent: 'border-[#E8E6E1] bg-white',
    pill: 'text-[#5E5D64] bg-[#F5F3EF]',
  },
  {
    type: 'Direct Offer',
    title: 'The Bundle Stacking Visual',
    tag: 'Offer Angle',
    accent: 'border-[#E24A1F]/30 bg-[#E24A1F]/[0.05]',
    pill: 'text-[#E24A1F] bg-[#E24A1F]/10',
  },
];

const assets = [
  {
    num: '01',
    name: 'The Vault: 50 Static Ad Teardowns',
    badge: 'Core Asset',
    desc: '50 battle-tested static ads analyzed in depth. Each breakdown covers the ad format, the scroll-stopping hook, why it works psychologically, the visual hierarchy, and a direct adaptation blueprint for your product.',
  },
  {
    num: '02',
    name: 'The Mix & Match Creative System',
    badge: 'Production Guide',
    desc: 'A practical framework to combine proven ad mechanics. Take the layout from one ad, the headline structure from another, and the proof element from a third to build original variations in an afternoon.',
  },
  {
    num: '03',
    name: 'The 6 Core Angle Blueprints',
    badge: 'Angle Matrix',
    desc: 'Deep breakdowns across Comparison, Us vs Them, Social Proof Overlays, Feature Highlights, Problem Agitation, and Bundle Stacks. Pick the angle that fits your product and adapt it immediately.',
  },
  {
    num: '04',
    name: 'The One-Page Production Worksheet',
    badge: 'Action Sheet',
    desc: 'Angle to Hook to Visual to Test. A single-page worksheet to take your raw product photos, select an angle, pair it with a proven hook structure, and produce 5 to 10 testable static ads in one sitting.',
  },
  {
    num: '05',
    name: 'The Testing & Iteration Protocol',
    badge: 'Decision Rules',
    desc: 'Clear guidelines on how many creatives to launch at once, how long to let tests run before judging, and the exact metrics to check before deciding to kill, iterate, or scale.',
  },
];

const sampleCreatives = [
  {
    id: '#01',
    format: 'Comparison / Contrast Ad',
    type: 'The "Old Way vs New Way" Split',
    whatItIs: 'A clean split visual comparing the painful, messy status quo on the left with your product solution on the right.',
    whyItWorks: 'Exploits instant contrast bias. The viewer immediately recognizes their current frustration without reading paragraphs of text.',
    howToAdapt: 'Identify the single most frustrating step your customer deals with before using your product. Show that on the left with muted, desaturated tones. Put your product on the right with bright, clean framing.',
    variations: [
      'Cost Angle: Show money and hours lost to manual work vs automated outcome.',
      'Frustration Angle: Messy countertop or cluttered workflow vs clean finished setup.',
      'Time Angle: 3 hours of hassle vs 10 seconds with your product.',
    ],
    adaptationTip: 'Use your own authentic product photo on the right. Keep the background neutral, use a bold divider line, and place simple 3-word labels above each side so the contrast is clear in under 1 second.',
  },
  {
    id: '#02',
    format: 'Social Proof / Native Overlay',
    type: 'The Customer DM / Review Overlay',
    whatItIs: 'A real customer message or review card placed directly over an authentic photo of the product in real-world use.',
    whyItWorks: 'Breaks ad blindness. It looks native to social feeds. Third-party endorsements disarm consumer skepticism much faster than polished brand graphics.',
    howToAdapt: 'Take your highest-converting 5-star customer review or DM. Turn it into a minimalist quote card overlay placed on top of an everyday photo of your product.',
    variations: [
      'The Skeptical Buyer Angle: "I thought this was a gimmick until day 3..."',
      'The Reorder Angle: "My 4th time ordering, cannot go back to store brands."',
      'The Gift Angle: "Bought one for my partner and ended up keeping it myself."',
    ],
    adaptationTip: 'Do not use fake or stock-looking graphics. Keep the text box styled like an iOS message or clean review badge. Let the real product photo breathe underneath.',
  },
  {
    id: '#03',
    format: 'Educational / Authority Audit',
    type: 'The "3 Common Mistakes" Checklist',
    whatItIs: 'A structured visual list highlighting 3 mistakes your target audience makes and why your product is the corrective fix.',
    whyItWorks: 'Taps into loss aversion and curiosity. People stop scrolling because they want to make sure they are not making a costly error.',
    howToAdapt: 'Pick 3 misconceptions in your niche (skincare habits, coffee brewing, gym wear fabric). List 2 general mistakes, and position the 3rd as the core problem your product solves.',
    variations: [
      'The Material Angle: 3 fabrics ruining your daily workouts.',
      'The Routine Angle: 3 morning habits hurting your skin barrier.',
      'The Budget Angle: 3 ways you are overpaying for standard alternatives.',
    ],
    adaptationTip: 'Use red X icons for the first two mistakes and a green checkmark for your product. Keep the text under 8 words per line so it is readable on mobile feeds.',
  },
];

const faqs = [
  {
    q: 'Why breakdowns instead of generic templates or AI prompts?',
    a: 'Templates and AI prompts rarely work across different businesses. Physical products have unique shapes, packaging, colors, and brand guidelines that generic templates fail to capture. AI alone frequently breaks on real product placement. By studying the underlying visual mechanics, hook angles, and buyer psychology, you get a reliable starting point you can adapt to your own product photos in an afternoon.',
  },
  {
    q: 'Do I need advanced design skills or paid software?',
    a: 'No. The highest-performing static ads today use simple layouts: strong contrast, clear typography, and authentic product photography. You can build these concepts using free tools like Canva or Figma in minutes.',
  },
  {
    q: 'Can I mix and match ideas across different ads?',
    a: 'Yes, that is the core purpose of the Vault. You can take the headline formula from a comparison ad, combine it with the layout of a feature breakdown, and add a social proof badge from another concept. This lets you generate dozens of unique variations without starting from zero.',
  },
  {
    q: 'Is this only for e-commerce brands?',
    a: 'It is built primarily for direct-to-consumer and physical product brands, but the underlying psychology (contrast, social proof, feature stacks, mistake checklists) works equally well for digital products, services, and local businesses.',
  },
  {
    q: 'What is the refund policy?',
    a: '7-day unconditional refund. If you review the breakdowns and feel you did not get actionable ideas you can apply to your brand, send an email to hey@vatsaljain.io for a full refund.',
  },
  {
    q: 'How do I access the Vault after purchase?',
    a: 'Immediately upon checkout, you receive private access to the Notion Dashboard containing all 50 breakdown cards, worksheets, and frameworks, along with a downloadable reference PDF.',
  },
  {
    q: 'What do the lifetime updates include?',
    a: 'The first 50 founding buyers automatically receive all future breakdown additions inside their Notion dashboard at no additional charge.',
  },
];
---

<Layout
  title="Static Ad Vault | 50 Proven Meta Ads & Breakdowns"
  description="Stop searching ad libraries from scratch. 50 proven static ads and tactical teardowns. Mix and match winning principles to build high-converting creatives in an afternoon."
>
  <!-- TOP ANNOUNCEMENT -->
  <div class="border-b border-[#E24A1F]/20 bg-[#E24A1F]/[0.08] px-4 py-2.5 text-center text-xs font-semibold text-[#E24A1F]">
    ⚡ Founding Offer: First 50 buyers get the complete Static Ad Vault for ₹999 with lifetime updates.
  </div>

  <!-- NAVIGATION -->
  <header class="sticky top-0 z-50 w-full border-b border-[#E8E6E1] bg-[#FAF9F6]/90 backdrop-blur-md">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex items-center justify-between py-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-1.5 text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.io</span>
        </a>

        <!-- Nav links: About, Articles, Products -->
        <nav class="hidden items-center gap-8 md:flex">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Products</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Button: Roast My Ads -->
          <a
            href="/roast-my-ads"
            class="inline-flex items-center gap-1.5 rounded-md bg-[#E24A1F] px-4 py-2 text-xs sm:text-sm font-bold text-white transition hover:bg-[#C53B12] shadow-sm"
          >
            Roast My Ads →
          </a>

          <!-- Mobile hamburger -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="flex h-9 w-9 items-center justify-center rounded-md border border-[#E8E6E1] text-[#5E5D64] transition hover:bg-white md:hidden"
            aria-label="Toggle menu"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden pb-4 md:hidden border-t border-[#E8E6E1] pt-3">
        <nav class="flex flex-col gap-3">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64]">Products</a>
          <a href="/roast-my-ads" class="text-sm font-semibold text-[#E24A1F]">Roast My Ads</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="flex-auto">

    <!-- 1. HERO SECTION -->
    <section class="border-b border-[#E8E6E1] bg-[#FAF9F6] py-16 sm:py-24">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 border border-[#E24A1F]/30 bg-[#E24A1F]/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-[#E24A1F] rounded">
            For D2C Founders & Media Buyers
          </div>

          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-[#141416] sm:text-5xl lg:text-6xl sm:leading-[1.1]">
            Stop searching ad libraries from scratch. Get 50 proven static ads and the breakdowns behind why they convert.
          </h1>

          <p class="mt-6 text-lg text-[#5E5D64] sm:text-xl leading-relaxed">
            Generic templates rarely fit your brand, and AI often fails on real product use cases. The Vault gives you a proven starting point with deep breakdowns of psychology, visual structure, and hooks. Mix and match these principles to build working creatives in an afternoon.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="#pricing"
              class="inline-flex items-center gap-2 rounded-md bg-[#E24A1F] px-6 py-3.5 text-base font-bold text-white shadow-sm transition hover:bg-[#C53B12]"
            >
              Get The Vault for ₹999 <span aria-hidden="true">→</span>
            </a>
            <a
              href="#samples"
              class="inline-flex items-center gap-2 rounded-md border border-[#E8E6E1] bg-white px-6 py-3.5 text-base font-semibold text-[#141416] transition hover:border-[#141416]/40 shadow-xs"
            >
              See Sample Breakdowns
            </a>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-[#5E5D64]">
            <span class="font-medium">✓ Instant digital access</span>
            <span>·</span>
            <span class="font-medium">✓ 7-day money-back guarantee</span>
            <span>·</span>
            <span class="font-medium">✓ Lifetime updates for first 50 buyers</span>
          </div>
        </div>

        <!-- VISUAL COLLAGE: 6 VAULT CREATIVES -->
        <div class="mt-14">
          <div class="mb-3 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-[#8E8D94]">
            <span>Visual Preview: 6 of 50 Static Formats Inside</span>
            <span class="text-[#E24A1F]">Includes Deep Teardowns</span>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            {vaultCollage.map((item) => (
              <div class={`rounded-lg border p-3.5 flex flex-col justify-between aspect-[3/4] ${item.accent}`}>
                <div>
                  <span class={`inline-block text-[10px] font-bold px-1.5 py-0.5 uppercase tracking-wider rounded ${item.pill}`}>
                    {item.tag}
                  </span>
                  <div class="mt-3 text-xs font-bold text-[#141416] leading-snug">
                    {item.type}
                  </div>
                </div>
                <div class="text-[11px] text-[#5E5D64] border-t border-[#E8E6E1] pt-2">
                  {item.title}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. THE PROBLEM -->
    <section id="problem" class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">The Bottleneck</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          Why Creative Testing Always Stalls
        </h2>
        <p class="mt-3 text-base text-[#5E5D64]">
          If your ad performance has flatlined, the problem is rarely your campaign budget setup. It is starting from zero every time you need new creative:
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <div class="text-sm font-bold text-[#E24A1F]">01. Starting From a Blank Canvas</div>
          <p class="mt-2 text-sm text-[#5E5D64] leading-relaxed">
            You spend hours scrolling the Meta Ad Library and competitor feeds hoping for inspiration. Staring at a blank screen burns energy before design even starts.
          </p>
        </div>

        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <div class="text-sm font-bold text-[#E24A1F]">02. Templates That Do Not Fit Your Product</div>
          <p class="mt-2 text-sm text-[#5E5D64] leading-relaxed">
            Generic template packs and AI prompts look great in previews, but fall apart when applied to real inventory with specific packaging, colors, and branding.
          </p>
        </div>

        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <div class="text-sm font-bold text-[#E24A1F]">03. Copying Visuals Without Understanding Why</div>
          <p class="mt-2 text-sm text-[#5E5D64] leading-relaxed">
            Copying a competitor format without knowing the buyer psychology behind it leads to wasted budget. Without clear principles, you cannot iterate on what fails.
          </p>
        </div>

        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <div class="text-sm font-bold text-[#E24A1F]">04. Slow Turnaround Kills Momentum</div>
          <p class="mt-2 text-sm text-[#5E5D64] leading-relaxed">
            Waiting days for freelancers or agencies lets existing ads fatigue and customer acquisition costs climb. You need a fast, reliable starting point to test every week.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. THE SOLUTION -->
    <section class="border-y border-[#E8E6E1] bg-white py-16">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">The Solution</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
            Meet the Static Ad Vault
          </h2>
          <p class="mt-4 text-base sm:text-lg text-[#5E5D64] leading-relaxed font-normal">
            The Static Ad Vault gives you <strong class="text-[#141416]">50 proven static ad creatives</strong> paired with <strong class="text-[#141416]">tactical breakdowns</strong> of why they convert. You get the scroll-stopping hook, the visual layout mechanics, and the buyer psychology. Mix and match these core principles to produce original, high-performing ads for your brand in an afternoon.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. WHAT YOU GET (5 ASSETS) -->
    <section id="assets" class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Complete Offer Breakdown</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          What You Get Inside
        </h2>
        <p class="mt-3 text-sm sm:text-base text-[#5E5D64]">
          Everything is organized for immediate implementation. No fluff or 40-hour video courses. Five practical assets ready to use.
        </p>
      </div>

      <div class="mt-12 space-y-5">
        {assets.map((asset) => (
          <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 transition hover:border-[#E24A1F] sm:p-8 shadow-xs">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center font-mono text-sm font-bold text-[#E24A1F] bg-[#E24A1F]/10 rounded-lg">
                  {asset.num}
                </span>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-lg font-bold text-[#141416]">{asset.name}</h3>
                    <span class="border border-[#E24A1F]/30 bg-[#E24A1F]/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-[#E24A1F] rounded">
                      {asset.badge}
                    </span>
                  </div>
                  <p class="mt-2 text-sm text-[#5E5D64] leading-relaxed">
                    {asset.desc}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. SAMPLE CREATIVES (3 FULL BREAKDOWNS) -->
    <section id="samples" class="border-t border-[#E8E6E1] bg-white py-20">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Proof of Quality</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
            Sample Teardowns: Inside the Vault
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#5E5D64]">
            Here is the exact anatomy of entries inside the Vault. You get the concept, the psychology, how to adapt it, variation angles, and practical layout advice.
          </p>
        </div>

        <div class="mt-12 space-y-10">
          {sampleCreatives.map((sample) => (
            <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-6 sm:p-8 shadow-xs">
              <div class="flex flex-wrap items-center justify-between border-b border-[#E8E6E1] pb-4">
                <div>
                  <span class="font-mono text-xs font-bold text-[#E24A1F]">VAULT SAMPLE {sample.id}</span>
                  <h3 class="text-xl font-bold text-[#141416]">{sample.type}</h3>
                </div>
                <span class="border border-[#E8E6E1] bg-white px-2.5 py-1 text-xs font-semibold text-[#5E5D64] rounded">
                  {sample.format}
                </span>
              </div>

              <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
                <div class="space-y-5">
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#8E8D94]">What It Is</h4>
                    <p class="mt-1 text-sm text-[#141416] leading-relaxed">{sample.whatItIs}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#8E8D94]">Why It Works (The Psychology)</h4>
                    <p class="mt-1 text-sm text-[#5E5D64] leading-relaxed">{sample.whyItWorks}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#8E8D94]">How To Adapt It To Your Brand</h4>
                    <p class="mt-1 text-sm text-[#5E5D64] leading-relaxed">{sample.howToAdapt}</p>
                  </div>
                </div>

                <div class="space-y-5 border-t border-[#E8E6E1] pt-6 md:border-t-0 md:border-l md:border-[#E8E6E1] md:pl-6">
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#8E8D94]">Variation Angles</h4>
                    <ul class="mt-2 space-y-1.5 text-xs text-[#5E5D64]">
                      {sample.variations.map((v) => (
                        <li class="flex items-start gap-2">
                          <span class="font-bold text-[#E24A1F]">·</span>
                          <span>{v}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#E24A1F]">Layout & Execution Tip</h4>
                    <div class="mt-2 rounded-lg bg-white border border-[#E8E6E1] p-3.5 text-xs text-[#141416] leading-relaxed">
                      {sample.adaptationTip}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. HOW IT WORKS (3 SIMPLE STEPS) -->
    <section class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="text-center max-w-xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Workflow</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          How It Works in 3 Steps
        </h2>
        <p class="mt-3 text-sm text-[#5E5D64]">
          Go from zero ideas to launch-ready ads in a single afternoon.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <span class="font-mono text-2xl font-bold text-[#E24A1F]">01</span>
          <h3 class="mt-3 text-base font-bold text-[#141416]">Pick a Starting Point</h3>
          <p class="mt-2 text-xs text-[#5E5D64] leading-relaxed">
            Open the Vault and choose a proven format matching your current angle: comparison, social proof, product-in-use, or checklist.
          </p>
        </div>

        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <span class="font-mono text-2xl font-bold text-[#E24A1F]">02</span>
          <h3 class="mt-3 text-base font-bold text-[#141416]">Mix and Match Principles</h3>
          <p class="mt-2 text-xs text-[#5E5D64] leading-relaxed">
            Apply the visual hierarchy and hook structure from the teardown. Drop in your own product photos and craft copy based on the angle notes.
          </p>
