---
import Layout from '../layouts/Layout.astro';

const vaultCollage = [
  {
    type: 'Side-by-Side Comparison',
    title: 'The "Old Way vs New Way" Contrast',
    tag: 'Comparison',
    accent: 'border-orange-500/40 bg-orange-500/5',
    pill: 'text-orange-500 bg-orange-500/10',
  },
  {
    type: 'Social Proof Mashup',
    title: 'Customer DM / Tweet Overlay',
    tag: 'Social Proof',
    accent: 'border-zinc-300 dark:border-zinc-700 bg-zinc-100/50 dark:bg-zinc-800/40',
    pill: 'text-zinc-600 dark:text-zinc-300 bg-zinc-200 dark:bg-zinc-700',
  },
  {
    type: 'Product in Use',
    title: 'The Real-Life Context Shot',
    tag: 'UGC-Style',
    accent: 'border-orange-500/30 bg-orange-500/5',
    pill: 'text-orange-500 bg-orange-500/10',
  },
  {
    type: 'Feature Breakdown',
    title: 'Anatomy / Exploded View',
    tag: 'Product Demo',
    accent: 'border-zinc-300 dark:border-zinc-700 bg-zinc-100/50 dark:bg-zinc-800/40',
    pill: 'text-zinc-600 dark:text-zinc-300 bg-zinc-200 dark:bg-zinc-700',
  },
  {
    type: 'Checklist / Audit',
    title: 'The "3 Common Mistakes" Graphic',
    tag: 'Educational',
    accent: 'border-zinc-300 dark:border-zinc-700 bg-zinc-100/50 dark:bg-zinc-800/40',
    pill: 'text-zinc-600 dark:text-zinc-300 bg-zinc-200 dark:bg-zinc-700',
  },
  {
    type: 'Direct Offer',
    title: 'The Bundle Stacking Visual',
    tag: 'Offer Angle',
    accent: 'border-orange-500/40 bg-orange-500/5',
    pill: 'text-orange-500 bg-orange-500/10',
  },
];

const assets = [
  {
    num: '01',
    name: 'The Vault: 50 Static Ad Creatives',
    badge: 'Core Asset',
    desc: '50 battle-tested static ad frameworks. Every entry includes the creative visual, ad format type, breakdown of what it is, why it works psychologically, exact adaptation steps for your product, 2–3 variation angles, and the copy-paste AI prompt used to generate it.',
  },
  {
    num: '02',
    name: 'The AI Creative Workflow',
    badge: 'Workflow Manual',
    desc: 'Step-by-step guide to turning a raw product photo or angle into a high-converting static ad. Covers tool setups (Midjourney, ChatGPT/Claude), prompt syntax, fixing AI flaws (text glitches, distorted hands, product accuracy), and exact Meta placement aspect ratios.',
  },
  {
    num: '03',
    name: 'The Prompt Library',
    badge: 'Templates',
    desc: 'A ready-to-use swipe file containing the exact generation prompt for all 50 Vault creatives, plus modular fill-in-the-blank prompt templates so you can spin up unique ad concepts on demand.',
  },
  {
    num: '04',
    name: 'The One-Page Creative Process',
    badge: 'Action Worksheet',
    desc: 'Angle → Hook → Creative → Test. A single-page worksheet to pick one customer pain point, write 3 distinct angles, pair each with a hook, select a matching Vault format, and launch without creative block.',
  },
  {
    num: '05',
    name: 'The Launch & Test Checklist',
    badge: 'Testing Protocol',
    desc: 'A concise 1-page decision protocol: exactly how many creatives to launch at once, what variables to hold constant, what metrics to evaluate after 3–5 days, and clear rules for when to kill, iterate, or scale.',
  },
];

const sampleCreatives = [
  {
    id: '#01',
    format: 'Comparison / Contrast Ad',
    type: 'The "Old Way vs New Way" Split',
    whatItIs: 'A clean split visual comparing the painful, messy status quo on the left with your streamlined product solution on the right.',
    whyItWorks: 'Exploits instant contrast bias. The viewer immediately recognizes their current frustration without reading a block of copy.',
    howToAdapt: 'Identify the single most annoying step your customer endures without your product. Put that on the left with desaturated lighting; put your product on the right with vibrant, clean framing.',
    variations: [
      'Cost Angle: Show money & hours lost to manual work vs. automated outcome.',
      'Frustration Angle: Messy countertop / cluttered workflow vs. sleek finished setup.',
      'Time Angle: "3 Hours of hassle" vs. "10 Seconds with [Your Product]".',
    ],
    prompt: '/imagine prompt: Clean split-screen advertisement, left side showing frustrated person dealing with [Insert Problem / Clutter] in dim muted tones, right side showing satisfied customer holding sleek modern [Insert Product Name] in bright natural lighting, professional commercial photography, editorial typography overlay space --ar 4:5 --v 6.1',
  },
  {
    id: '#02',
    format: 'Social Proof / Native Screenshot',
    type: 'The Customer DM / Tweet Overlay',
    whatItIs: 'A real-looking customer message or tweet layered directly over an authentic lifestyle photo of the product in everyday use.',
    whyItWorks: 'Breaks ad blindness. It looks native to Instagram and X feeds. Third-party endorsements disarm consumer skepticism faster than polished brand claims.',
    howToAdapt: 'Take your highest-converting 5-star customer review or DM. Turn it into a minimalist quote card overlay placed on top of an AI-generated lifestyle image of your product.',
    variations: [
      'The "Skeptical Buyer" Angle: "I thought this was a gimmick until day 3..."',
      'The "Reorder" Angle: "My 4th time ordering, can never go back."',
      'The "Partner Reaction" Angle: "My wife stole mine so I had to buy another."',
    ],
    prompt: '/imagine prompt: Authentic candid lifestyle shot of [Insert Product] resting on a sunlit oak coffee table in a modern apartment, shot on 35mm lens, natural shallow depth of field, minimalist upper third area for text overlay, warm aesthetic --ar 4:5 --v 6.1',
  },
  {
    id: '#03',
    format: 'Educational / Authority Audit',
    type: 'The "3 Common Mistakes" Checklist',
    whatItIs: 'A structured, high-value visual list highlighting 3 mistakes your target audience makes and why your product is the corrective fix.',
    whyItWorks: 'Taps into loss aversion and curiosity. People stop scrolling because they want to ensure they aren’t making a costly mistake.',
    howToAdapt: 'Pick 3 misconceptions in your niche (e.g. skincare habits, coffee brewing, gym wear fabric). List 2 general mistakes, and position the 3rd as the core problem your product solves.',
    variations: [
      'The Ingredient / Material Angle: 3 fabrics ruining your workouts.',
      'The Routine Angle: 3 morning habits killing your skin barrier.',
      'The Budget Angle: 3 ways you are overpaying for [Category].',
    ],
    prompt: '/imagine prompt: Editorial studio product photograph of [Insert Product], centered on a minimal stone pedestal against a neutral matte backdrop, crisp commercial lighting, balanced margins designed for infographic checklist typography --ar 4:5 --v 6.1',
  },
];

const faqs = [
  {
    q: 'Do I need design skills or expensive software?',
    a: 'No. The entire system is built for non-designers. You get copy-paste AI prompts to generate the core visuals, plus simple guidelines to add clean text overlays using free tools like Canva or Figma.',
  },
  {
    q: 'Which AI tools do I need?',
    a: 'Any standard image generator works. We provide prompts optimized for Midjourney, but they work equally well in tools like ChatGPT (DALL-E 3), Ideogram, or Flux. We also show how to use ChatGPT or Claude for angle and hook expansion.',
  },
  {
    q: 'Is this only for e-commerce and D2C brands?',
    a: 'It is built primarily for D2C and physical e-commerce brands, but the underlying psychological angles (comparison, social proof, checklists, feature stacks) work remarkably well for digital products, lead generation, and local businesses.',
  },
  {
    q: 'How are the files delivered?',
    a: 'You get instant lifetime access to the complete digital Vault inside a clean Notion workspace, along with downloadable PDF cheat sheets and prompt swipe sheets.',
  },
  {
    q: 'What is the refund policy?',
    a: 'We offer an unconditional 7-day money-back guarantee. If you go through the Vault and feel it didn’t give you testable creative ideas for your brand, email us within 7 days for a 100% refund.',
  },
  {
    q: 'How do I access the bonuses and future updates?',
    a: 'The first 50 founding buyers automatically receive all future Vault additions (including the 10 launch-week bonus creatives) inside their Notion dashboard at no extra cost.',
  },
];
---

<Layout
  title="AI Ad Creative Vault — 50 Proven Static Meta Ads & AI Prompts"
  description="Stop guessing what ad to make. Get 50 proven static Meta ad creatives and the exact AI prompts to remake them for your brand in an afternoon."
>
  <!-- TOP ANNOUNCEMENT -->
  <div class="border-b border-orange-500/20 bg-orange-500/10 px-4 py-2.5 text-center text-xs font-semibold text-orange-600 dark:text-orange-400">
    ⚡ Founding Offer: First 50 buyers get the complete Vault for ₹999 + lifetime updates.
  </div>

  <!-- NAVIGATION (Unified Navbar across entire site) -->
  <header class="sticky top-0 z-50 w-full border-b border-[#E8E6E1] bg-[#FAF9F6]/90 backdrop-blur-md">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex items-center justify-between py-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-1.5 text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.io</span>
        </a>

        <!-- Nav links: About, Articles, Products -->
        <nav class="hidden items-center gap-8 md:flex">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Products</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Button: Roast My Ads -->
          <a
            href="mailto:hey@vatsaljain.io?subject=Roast%20My%20Ads"
            class="inline-flex items-center gap-1.5 rounded-md bg-[#E24A1F] px-4 py-2 text-xs sm:text-sm font-bold text-white transition hover:bg-[#C53B12] shadow-sm"
          >
            Roast My Ads →
          </a>

          <!-- Mobile hamburger -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="flex h-9 w-9 items-center justify-center rounded-md border border-[#E8E6E1] text-[#5E5D64] transition hover:bg-white md:hidden"
            aria-label="Toggle menu"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden pb-4 md:hidden border-t border-[#E8E6E1] pt-3">
        <nav class="flex flex-col gap-3">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64]">Products</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="flex-auto">

    <!-- 1. HERO SECTION -->
    <section class="border-b border-zinc-100 bg-zinc-50/60 py-16 sm:py-24 dark:border-zinc-800 dark:bg-zinc-950">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 border border-orange-500/30 bg-orange-500/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-orange-600 dark:text-orange-400">
            For D2C Founders & Media Buyers
          </div>

          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl lg:text-6xl sm:leading-[1.1] dark:text-zinc-50">
            Stop guessing what ad to make. Get 50 proven Meta creatives and the AI prompts to remake them for your brand.
          </h1>

          <p class="mt-6 text-lg text-zinc-600 sm:text-xl dark:text-zinc-300 leading-relaxed">
            50 proven static ad creatives for Meta, plus the exact AI prompts and workflow to remake them for your own brand in an afternoon.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="#pricing"
              class="inline-flex items-center gap-2 bg-orange-500 px-6 py-3.5 text-base font-bold text-white shadow-sm transition hover:bg-orange-600"
            >
              Get The Vault for ₹999 <span aria-hidden="true">→</span>
            </a>
            <a
              href="#samples"
              class="inline-flex items-center gap-2 border border-zinc-200 bg-white px-6 py-3.5 text-base font-semibold text-zinc-800 transition hover:border-zinc-400 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-zinc-500"
            >
              See Sample Breakdowns
            </a>
          </div>

          <div class="mt-6 flex items-center gap-3 text-xs text-zinc-500 dark:text-zinc-400">
            <span>✓ Instant digital access</span>
            <span>·</span>
            <span>✓ 7-day unconditional guarantee</span>
            <span>·</span>
            <span>✓ Lifetime updates for first 50 buyers</span>
          </div>
        </div>

        <!-- VISUAL COLLAGE: 6 VAULT CREATIVES -->
        <div class="mt-14">
          <div class="mb-3 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-zinc-400">
            <span>Visual Vault Preview: 6 of 50 Static Formats Inside</span>
            <span class="text-orange-500">Includes Exact Prompts</span>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            {vaultCollage.map((item) => (
              <div class={`border p-3.5 flex flex-col justify-between aspect-[3/4] ${item.accent}`}>
                <div>
                  <span class={`inline-block text-[10px] font-bold px-1.5 py-0.5 uppercase tracking-wider ${item.pill}`}>
                    {item.tag}
                  </span>
                  <div class="mt-3 text-xs font-bold text-zinc-900 dark:text-zinc-100 leading-snug">
                    {item.type}
                  </div>
                </div>
                <div class="text-[11px] text-zinc-500 dark:text-zinc-400 border-t border-zinc-200/60 dark:border-zinc-700/60 pt-2">
                  {item.title}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. THE PROBLEM -->
    <section id="problem" class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-red-500">The Bottleneck</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
          Why Creative Testing Always Stalls
        </h2>
        <p class="mt-3 text-base text-zinc-600 dark:text-zinc-400">
          If your Meta ad performance has flatlined, the problem isn’t your Ads Manager campaign budget setup. It’s the creative bottleneck:
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/60">
          <div class="text-sm font-bold text-red-500">01. You Run Out of Ideas</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            You stare at a blank Canva board wondering what angle to test next. You repeat the same product-on-white-background images that fatigued weeks ago.
          </p>
        </div>

        <div class="border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/60">
          <div class="text-sm font-bold text-red-500">02. No Designer On Call</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Freelance designers charge ₹1,500 to ₹5,000 per graphic, require lengthy creative briefs, and take 4 to 7 days to deliver something that still might not convert.
          </p>
        </div>

        <div class="border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/60">
          <div class="text-sm font-bold text-red-500">03. Slow Turnaround Kills Momentum</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            By the time you get new creatives back from an agency or freelancer, your active ads have fatigued and customer acquisition costs have spiked.
          </p>
        </div>

        <div class="border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/60">
          <div class="text-sm font-bold text-red-500">04. No Proof An Idea Will Work</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            You spend real ad spend testing untested visual concepts blindly, with no understanding of the underlying psychological mechanism making people click.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. THE SOLUTION -->
    <section class="border-y border-zinc-100 bg-zinc-50/70 py-16 dark:border-zinc-800 dark:bg-zinc-900/40">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-widest text-orange-500">The Solution</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
            Meet the AI Ad Creative Vault
          </h2>
          <p class="mt-4 text-base sm:text-lg text-zinc-700 dark:text-zinc-300 leading-relaxed font-normal">
            The AI Ad Creative Vault is <strong>50 proven static ad concepts</strong> paired with the <strong>exact AI prompts and step-by-step workflow</strong> to remake them for your own product in an afternoon. You don't just get images—you get the psychological mechanism behind every ad, so you learn what converts as you build your next 10 testable creatives.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. WHAT YOU GET (5 ASSETS) -->
    <section id="assets" class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-orange-500">Complete Offer Breakdown</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
          What You Get Inside
        </h2>
        <p class="mt-3 text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
          Everything is packaged for immediate execution. No fluff, no 40-hour course. Just 5 high-density assets.
        </p>
      </div>

      <div class="mt-12 space-y-6">
        {assets.map((asset) => (
          <div class="border border-zinc-200 bg-white p-6 transition hover:border-orange-500 sm:p-8 dark:border-zinc-800 dark:bg-zinc-900/70 dark:hover:border-orange-500">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div class="flex items-start gap-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center font-mono text-sm font-bold text-orange-500 bg-orange-500/10">
                  {asset.num}
                </span>
                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">{asset.name}</h3>
                    <span class="border border-orange-500/30 bg-orange-500/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-orange-600 dark:text-orange-400">
                      {asset.badge}
                    </span>
                  </div>
                  <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                    {asset.desc}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. SAMPLE CREATIVES (3 FULL BREAKDOWNS) -->
    <section id="samples" class="border-t border-zinc-100 bg-zinc-50/50 py-20 dark:border-zinc-800 dark:bg-zinc-900/30">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-orange-500">Proof of Quality</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
            Sample Creatives: Inside the Vault
          </h2>
          <p class="mt-3 text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
            Here is the exact anatomy of entries inside the Vault. You get the concept, the psychology, how to adapt it, variations, and the AI prompt.
          </p>
        </div>

        <div class="mt-12 space-y-10">
          {sampleCreatives.map((sample) => (
            <div class="border border-zinc-200 bg-white p-6 sm:p-8 dark:border-zinc-800 dark:bg-zinc-900">
              <div class="flex flex-wrap items-center justify-between border-b border-zinc-100 pb-4 dark:border-zinc-800">
                <div>
                  <span class="font-mono text-xs font-bold text-orange-500">VAULT SAMPLE {sample.id}</span>
                  <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">{sample.type}</h3>
                </div>
                <span class="border border-zinc-200 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:text-zinc-300">
                  {sample.format}
                </span>
              </div>

              <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
                <div class="space-y-5">
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-400">What It Is</h4>
                    <p class="mt-1 text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">{sample.whatItIs}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-400">Why It Works (The Psychology)</h4>
                    <p class="mt-1 text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">{sample.whyItWorks}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-400">How To Adapt It To Your Brand</h4>
                    <p class="mt-1 text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">{sample.howToAdapt}</p>
                  </div>
                </div>

                <div class="space-y-5 border-t border-zinc-100 pt-6 md:border-t-0 md:border-l md:border-zinc-100 md:pl-6 dark:border-zinc-800">
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-400">2–3 Variation Angles</h4>
                    <ul class="mt-2 space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400">
                      {sample.variations.map((v) => (
                        <li class="flex items-start gap-2">
                          <span class="font-bold text-orange-500">·</span>
                          <span>{v}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-orange-500">Copy-Paste AI Prompt</h4>
                    <div class="mt-2 rounded bg-zinc-900 p-3 font-mono text-[11px] text-zinc-200 dark:bg-black leading-relaxed">
                      {sample.prompt}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. HOW IT WORKS (3 SIMPLE STEPS) -->
    <section class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="text-center max-w-xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-orange-500">Workflow</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-100">
          How It Works in 3 Steps
        </h2>
        <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
          Go from zero ideas to launch-ready ads in a single afternoon.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900/60">
