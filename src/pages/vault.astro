<script>
  // Direct Razorpay Checkout & Lead Capture
  const modal = document.getElementById('checkout-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const leadForm = document.getElementById('vault-lead-form');
  const submitBtn = document.getElementById('lead-submit-btn');
  const triggers = document.querySelectorAll('.vault-checkout-trigger');

  // Meta Pixel & CAPI: Track ViewContent for the Vault product on page load
  try {
    if (typeof (window as any).trackMetaEvent === 'function') {
      (window as any).trackMetaEvent('ViewContent', {
        content_name: 'The Static Ad Vault',
        content_category: 'Digital Product',
        value: 999.00,
        currency: 'INR',
      });
    } else if (typeof (window as any).fbq === 'function') {
      (window as any).fbq('track', 'ViewContent', {
        content_name: 'The Static Ad Vault',
        content_category: 'Digital Product',
        value: 999.00,
        currency: 'INR',
      });
    }
  } catch (e) {}

  function openCheckoutModal(e: Event) {
    if (e) e.preventDefault();
    modal?.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    const nameInput = document.getElementById('lead-name') as HTMLInputElement | null;
    setTimeout(() => nameInput?.focus(), 50);
    try {
      (window as any).recordLiveAction?.('Opened Vault Checkout Modal', { product: 'The Static Ad Vault' });
    } catch (err) {}
  }

  function closeCheckoutModal() {
    modal?.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  // Hero Video Autoplay & Unmute Controller
  const heroVideo = document.getElementById('vault-hero-video') as HTMLVideoElement | null;
  const unmuteBtn = document.getElementById('vault-unmute-btn');
  const iconMuted = document.getElementById('unmute-icon-muted');
  const iconSound = document.getElementById('unmute-icon-sound');

  if (heroVideo) {
    // Explicitly enforce muted on DOM level for browser autoplay policy
    heroVideo.muted = true;
    heroVideo.defaultMuted = true;

    const startAutoplay = () => {
      heroVideo.muted = true;
      const playPromise = heroVideo.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          // Retry on first touch/click if browser blocked silent autoplay
          const resumeOnInteract = () => {
            heroVideo.play().catch(() => {});
            window.removeEventListener('click', resumeOnInteract);
            window.removeEventListener('touchstart', resumeOnInteract);
            window.removeEventListener('scroll', resumeOnInteract);
          };
          window.addEventListener('click', resumeOnInteract, { once: true });
          window.addEventListener('touchstart', resumeOnInteract, { once: true });
          window.addEventListener('scroll', resumeOnInteract, { once: true });
        });
      }
    };

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      startAutoplay();
    } else {
      document.addEventListener('DOMContentLoaded', startAutoplay);
    }

    if (unmuteBtn) {
      unmuteBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (heroVideo.muted) {
          heroVideo.currentTime = 0;
          heroVideo.muted = false;
          heroVideo.volume = 1;
          const p = heroVideo.play();
          if (p !== undefined) {
            p.then(() => {
              iconMuted?.classList.add('hidden');
              iconSound?.classList.remove('hidden');
            }).catch((err) => {
              console.warn('Playback error on unmute:', err);
              heroVideo.muted = true;
              heroVideo.play().catch(() => {});
            });
          }
        } else {
          heroVideo.muted = true;
          iconMuted?.classList.remove('hidden');
          iconSound?.classList.add('hidden');
        }
      });
    }

    // Clicking the video directly toggles play/pause
    heroVideo.addEventListener('click', () => {
      if (heroVideo.paused) {
        heroVideo.play().catch(() => {});
      } else {
        heroVideo.pause();
      }
    });

    heroVideo.addEventListener('volumechange', () => {
      if (heroVideo.muted) {
        iconMuted?.classList.remove('hidden');
        iconSound?.classList.add('hidden');
      } else {
        iconMuted?.classList.add('hidden');
        iconSound?.classList.remove('hidden');
      }
    });
  }

  triggers.forEach((btn) => {
    btn.addEventListener('click', openCheckoutModal);
  });

  closeModalBtn?.addEventListener('click', closeCheckoutModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeCheckoutModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) closeCheckoutModal();
  });

  function sendLeadUpdate(status: string, extra: Record<string, any> = {}) {
    const nameInput = document.getElementById('lead-name') as HTMLInputElement | null;
    const emailInput = document.getElementById('lead-email') as HTMLInputElement | null;
    const phoneInput = document.getElementById('lead-phone') as HTMLInputElement | null;

    const currentName = nameInput?.value.trim() || '';
    const currentEmail = emailInput?.value.trim() || '';
    const currentPhone = phoneInput?.value.trim() || '';
    if (!currentEmail && !currentPhone) return;

    const payload = {
      status,
      name: currentName,
      email: currentEmail,
      phone: currentPhone,
      amount: '₹999',
      product: 'The Static Ad Vault',
      source: window.location.href,
      timestamp: new Date().toISOString(),
      ...extra,
    };

    try {
      fetch('/api/record-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        keepalive: true,
      }).catch(() => {});
    } catch (e) {}
  }

  // Auto-capture partial entries on field blur (catches people who exit modal without submitting)
  const leadEmailField = document.getElementById('lead-email') as HTMLInputElement | null;
  const leadPhoneField = document.getElementById('lead-phone') as HTMLInputElement | null;

  leadEmailField?.addEventListener('blur', () => {
    if (leadEmailField.value.includes('@')) {
      sendLeadUpdate('Modal Form: Email Entered');
      try { (window as any).recordLiveAction?.('Typed Email in Checkout'); } catch (e) {}
    }
  });

  leadPhoneField?.addEventListener('blur', () => {
    if (leadPhoneField.value.replace(/\D/g, '').length >= 10) {
      sendLeadUpdate('Modal Form: Phone Entered');
      try { (window as any).recordLiveAction?.('Typed Phone in Checkout'); } catch (e) {}
    }
  });

  leadForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nameInput = document.getElementById('lead-name') as HTMLInputElement | null;
    const emailInput = document.getElementById('lead-email') as HTMLInputElement | null;
    const phoneInput = document.getElementById('lead-phone') as HTMLInputElement | null;

    const name = nameInput?.value.trim() || '';
    const email = emailInput?.value.trim() || '';
    const phone = phoneInput?.value.trim() || '';

    if (!email || !phone) {
      if (!phone) phoneInput?.focus();
      else emailInput?.focus();
      return;
    }

    if (submitBtn) {
      submitBtn.innerHTML = `<span>Opening Secure Checkout...</span>`;
      submitBtn.setAttribute('disabled', 'true');
    }

    const leadData = {
      name,
      email,
      phone,
      product: 'The Static Ad Vault',
      price: '₹999',
      source: window.location.href,
      timestamp: new Date().toISOString()
    };

    // 1. Local backup
    try {
      const existing = JSON.parse(localStorage.getItem('vault_captured_leads') || '[]');
      existing.push(leadData);
      localStorage.setItem('vault_captured_leads', JSON.stringify(existing));
    } catch (err) {}

    // 2. Meta Pixel & CAPI: InitiateCheckout with customer matching
    try {
      if (typeof (window as any).trackMetaEvent === 'function') {
        (window as any).trackMetaEvent('InitiateCheckout', {
          content_name: 'The Static Ad Vault',
          value: 999.00,
          currency: 'INR',
          num_items: 1,
        }, {
          name,
          email,
          phone,
        });
      } else if (typeof (window as any).fbq === 'function') {
        (window as any).fbq('track', 'InitiateCheckout', {
          content_name: 'The Static Ad Vault',
          value: 999.00,
          currency: 'INR'
        });
      }
    } catch (e) {}

    // 3. Create Server-Side Order via Cloudflare Function
    try {
      const res = await fetch('/api/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(leadData),
      });

      if (!res.ok) {
        throw new Error('Order creation endpoint returned ' + res.status);
      }

      const data = await res.json();
      if (!data.orderId) {
        throw new Error('No order ID returned from server');
      }

      // Record checkout initiated with orderId
      sendLeadUpdate('Checkout Initiated', { order_id: data.orderId });

      // Close modal before opening Razorpay checkout
      closeCheckoutModal();
      if (submitBtn) {
        submitBtn.innerHTML = `<span>Continue to Secure Payment (₹999)</span> <span aria-hidden="true">→</span>`;
        submitBtn.removeAttribute('disabled');
      }

      // Open Direct Razorpay Checkout Modal
      const RazorpayConstructor = (window as any).Razorpay;
      if (typeof RazorpayConstructor !== 'function') {
        throw new Error('Razorpay SDK not loaded');
      }

      const rzp = new RazorpayConstructor({
        key: data.keyId,
        amount: data.amount,
        currency: data.currency,
        name: 'Static Ad Vault',
        description: 'Arqo Studio · 30+ Ad Teardowns + Lifetime Updates',
        image: 'https://vatsal.arqostudio.com/arqo-logo.png',
        order_id: data.orderId,
        prefill: {
          name: name,
          email: email,
          contact: phone,
        },
        theme: {
          color: '#E24A1F',
        },
        modal: {
          ondismiss: function () {
            // User closed the Razorpay popup without paying (Cart Abandoned)
            sendLeadUpdate('Checkout Abandoned (Razorpay Closed)', { order_id: data.orderId });
            try { (window as any).recordLiveAction?.('Closed Razorpay Checkout (Cart Abandoned)'); } catch (e) {}
            if (submitBtn) {
              submitBtn.innerHTML = `<span>Continue to Secure Payment (₹999)</span> <span aria-hidden="true">→</span>`;
              submitBtn.removeAttribute('disabled');
            }
          },
        },
        handler: function (response: any) {
          // Record successful payment immediately
          sendLeadUpdate('PAID', {
            order_id: response.razorpay_order_id || data.orderId,
            payment_id: response.razorpay_payment_id || '',
          });
          try {
            (window as any).recordLiveAction?.('🎉 Paid ₹999 for The Static Ad Vault', {
              amount: '₹999',
              order_id: response.razorpay_order_id || data.orderId,
              payment_id: response.razorpay_payment_id || '',
            });
          } catch (e) {}

          // Track purchase in Meta Pixel & CAPI with full user data
          try {
            if (typeof (window as any).trackMetaEvent === 'function') {
              (window as any).trackMetaEvent('Purchase', {
                content_name: 'The Static Ad Vault',
                value: 999.00,
                currency: 'INR',
                order_id: response.razorpay_payment_id || response.razorpay_order_id,
              }, {
                name,
                email,
                phone,
              });
            } else if (typeof (window as any).fbq === 'function') {
              (window as any).fbq('track', 'Purchase', {
                content_name: 'The Static Ad Vault',
                value: 999.00,
                currency: 'INR',
                transaction_id: response.razorpay_payment_id,
              });
            }
          } catch (e) {}

          // Direct redirect to thank you upsell page with all query & tracking parameters carried forward
          const redirectUrl = `/vault/thank-you?payment_id=${encodeURIComponent(
            response.razorpay_payment_id || ''
          )}&order_id=${encodeURIComponent(response.razorpay_order_id || '')}&name=${encodeURIComponent(name)}&email=${encodeURIComponent(email)}&phone=${encodeURIComponent(phone)}`;
          const finalUrl = typeof (window as any).getForwardedUrl === 'function'
            ? (window as any).getForwardedUrl(redirectUrl)
            : redirectUrl;
          window.location.href = finalUrl;
        },
      });

      // Handle payment failure (card decline, UPI cancel, bank error)
      rzp.on('payment.failed', function (resp: any) {
        sendLeadUpdate('Payment Failed', {
          order_id: data.orderId,
          payment_id: resp?.error?.metadata?.payment_id || '',
          notes: (resp?.error?.code || '') + ': ' + (resp?.error?.description || resp?.error?.reason || 'Payment failed'),
        });
      });

      rzp.open();
    } catch (err) {
      console.warn('Direct checkout failed, falling back to hosted page:', err);
      // Fallback: Redirect to hosted payment page with pre-filled query params
      const params = new URLSearchParams();
      if (name) params.set('name', name);
      if (email) params.set('email', email);
      if (phone) params.set('phone', phone);
      const fallbackUrl = `https://pages.razorpay.com/static-ad-vault?${params.toString()}`;
      const finalFallback = typeof (window as any).getForwardedUrl === 'function'
        ? (window as any).getForwardedUrl(fallbackUrl)
        : fallbackUrl;
      window.location.href = finalFallback;
    }
  });
</script>
