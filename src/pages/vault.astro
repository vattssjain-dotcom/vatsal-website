---
import Layout from '../layouts/Layout.astro';

const vaultCollage = [
  {
    type: 'Side-by-Side Comparison',
    title: 'The "Old Way vs New Way" Contrast',
    tag: 'Comparison',
    accent: 'border-[#E24A1F]/30 bg-[#E24A1F]/[0.05]',
    pill: 'text-[#E24A1F] bg-[#E24A1F]/10',
  },
  {
    type: 'Social Proof Overlay',
    title: 'Customer DM / Review Callout',
    tag: 'Social Proof',
    accent: 'border-[#E8E6E1] bg-white',
    pill: 'text-[#5E5D64] bg-[#F5F3EF]',
  },
  {
    type: 'Solution in Action',
    title: 'Real-Life Context / Workflow',
    tag: 'Contextual',
    accent: 'border-[#E24A1F]/30 bg-[#E24A1F]/[0.05]',
    pill: 'text-[#E24A1F] bg-[#E24A1F]/10',
  },
  {
    type: 'Mechanism Breakdown',
    title: 'Feature Anatomy / How It Works',
    tag: 'How It Works',
    accent: 'border-[#E8E6E1] bg-white',
    pill: 'text-[#5E5D64] bg-[#F5F3EF]',
  },
  {
    type: 'Checklist / Audit',
    title: 'The "3 Common Mistakes" Graphic',
    tag: 'Educational',
    accent: 'border-[#E8E6E1] bg-white',
    pill: 'text-[#5E5D64] bg-[#F5F3EF]',
  },
  {
    type: 'Direct Transformation',
    title: 'The Before vs After Outcome',
    tag: 'Outcome',
    accent: 'border-[#E24A1F]/30 bg-[#E24A1F]/[0.05]',
    pill: 'text-[#E24A1F] bg-[#E24A1F]/10',
  },
];

const whatsIncluded = [
  {
    num: '01',
    name: '30 Proven Static Ad Formats & Teardowns',
    badge: 'Core Vault',
    desc: '30 battle-tested static ad formats analyzed in detail. Every teardown breaks down the scroll-stopping hook, visual hierarchy, layout psychology, and the exact thinking behind adapting the concept to your specific product or service.',
  },
  {
    num: '02',
    name: 'Continuous Vault Additions',
    badge: 'Lifetime Access',
    desc: 'You get immediate access to all 30 foundational formats today, plus ongoing access to every new ad format, creative angle, and teardown added to the vault as we test and discover them.',
  },
  {
    num: '03',
    name: 'The Ad Creation & Testing Checklist',
    badge: 'Execution Guide',
    desc: 'A no-nonsense, step-by-step checklist on how to approach creating your ads. Take your problem and solution, pick a winning format, structure the visual hierarchy, and test variations with clear decision rules.',
  },
];

const sampleCreatives = [
  {
    id: '#01',
    format: 'Comparison / Contrast Ad',
    type: 'The "Old Way vs New Way" Split',
    whatItIs: 'A clean split visual comparing the painful, slow status quo on the left with your solution on the right.',
    whyItWorks: 'Exploits instant contrast bias. The viewer immediately recognizes their current frustration without reading paragraphs of text.',
    howToAdapt: 'Identify the single biggest pain point your buyer experiences before using your solution. Show that on the left with muted, desaturated tones. Put your product or service outcome on the right with clear, bright framing.',
    variations: [
      'Physical Product (e.g. Skincare): Harsh chemicals and irritated barrier on the left vs calm, hydrated skin on the right.',
      'Software / AI Service: 4 hours of messy spreadsheets on the left vs a 1-click automated dashboard on the right.',
      'B2B / Agency Service: Juggling 6 disconnected tools on the left vs a single streamlined growth system on the right.',
    ],
    adaptationTip: 'Keep the contrast immediate. Use a clear divider, short 3-word labels above each side, and keep background distractions to zero so the difference is obvious in under one second.',
  },
  {
    id: '#02',
    format: 'Social Proof / Native Overlay',
    type: 'The Customer DM / Review Overlay',
    whatItIs: 'A real customer message, tweet, or review card placed directly over an authentic visual of your product or service in action.',
    whyItWorks: 'Breaks social feed blindness by looking native and organic. Third-party endorsements disarm skepticism far faster than polished brand claims.',
    howToAdapt: 'Take your highest-converting customer feedback that mentions a specific problem solved. Overlay it cleanly over your physical product shot, software interface, or client result.',
    variations: [
      'Physical Product: "I thought this was another overhyped trend until day 4, my breakouts completely cleared up."',
      'AI / Software Service: "This tool replaced 3 different subscriptions and gave our team 10 hours back each week."',
      'Professional Service: "Closed two new clients within 14 days of running this new pipeline."',
    ],
    adaptationTip: 'Do not use fake stock badge designs. Style the message box like a real iOS message, tweet, or clean review card. Let the authentic visual breathe underneath.',
  },
  {
    id: '#03',
    format: 'Educational / Authority Audit',
    type: 'The "3 Common Mistakes" Checklist',
    whatItIs: 'A structured visual checklist highlighting 3 mistakes your target audience makes and positioning your solution as the corrective fix.',
    whyItWorks: 'Taps into loss aversion and curiosity. People stop scrolling because nobody wants to make an expensive, painful, or embarrassing mistake.',
    howToAdapt: 'Pick 3 common misconceptions in your market. List 2 broad industry mistakes, and position the 3rd as the exact problem your product or service eliminates.',
    variations: [
      'Physical Product (Skincare): 3 common morning habits that are silently destroying your moisture barrier.',
      'AI / Software Service: 3 mistakes companies make when automating their customer workflows.',
      'Consulting / Marketing Service: 3 reasons your paid ad campaigns fatigue within 48 hours.',
    ],
    adaptationTip: 'Use red X icons for the mistakes and a bold green checkmark for the solution. Keep each line under 8 words so it stays readable on mobile screens.',
  },
];

const faqs = [
  {
    q: 'Who is this for: products or services?',
    a: 'Both. The Vault is built for anyone selling a problem-solving product or service. Whether you sell a physical product like skincare, health, or apparel, or an AI tool, software, consulting, or agency service, the core concept of winning ads is identical: highlighting a specific problem and presenting your solution. The visual layouts, hook angles, and buyer psychology apply across both.',
  },
  {
    q: 'Why 30 ad teardowns instead of generic templates or AI prompts?',
    a: 'Templates and AI prompts fail when applied to real businesses. Every product has unique packaging and branding, and every service has specific workflows and customer outcomes. AI alone frequently produces unusable, hallucinated visuals. By deconstructing 30 proven ad formats, you get the actual principles (contrast, hook psychology, visual hierarchy) so you have a solid starting point you can apply in an afternoon.',
  },
  {
    q: 'Do I get access to future ads added to the Vault?',
    a: 'Yes. Founding buyers get instant access to the 30 foundational formats today, plus ongoing access to every new ad format and teardown we add to the vault over time at zero extra charge.',
  },
  {
    q: 'Do I need design skills or paid software?',
    a: 'No. The highest-performing static ads rely on simple layouts, clear contrast, and authentic visuals, not complicated 3D artwork. You can build these concepts using free tools like Canva, Figma, or whatever editor you already use.',
  },
  {
    q: 'Can I mix and match ideas across different ads?',
    a: 'Yes, that is the entire purpose of the Vault. You can take the headline formula from a comparison ad, combine it with a checklist format from another teardown, and add a social proof badge. This gives you dozens of original variations without starting from zero.',
  },
  {
    q: 'What is included in the purchase?',
    a: 'You get full access to the 30 Static Ad Formats and Teardowns inside a dedicated Notion workspace, ongoing access to all future ad formats added here, The Ad Creation & Testing Checklist, and downloadable documents.',
  },
  {
    q: 'What is the refund policy?',
    a: 'Due to the immediate digital delivery of all breakdown files, Notion templates, and checklists, all sales are final. Please review the sample teardowns and details on this page before purchasing.',
  },
  {
    q: 'How do I access the Vault after purchase?',
    a: 'Immediately upon checkout, you receive private access to the Notion Dashboard containing all breakdown cards and the creation checklist, along with the document edition and future additions.',
  },
];
---

<Layout
  title="Static Ad Vault | 30 Proven Meta Ads & Breakdowns + Continuous Updates"
  description="Stop searching ad libraries from scratch. 30 proven static ad formats and teardowns for problem-solving products and services. Plus new ads added regularly."
>
  <!-- TOP ANNOUNCEMENT -->
  <div class="border-b border-[#E24A1F]/20 bg-[#E24A1F]/[0.08] px-4 py-2.5 text-center text-xs font-semibold text-[#E24A1F]">
    ⚡ Founding Offer: First 50 buyers get the Static Ad Vault (30 Formats + All Future Adds) for ₹999.
  </div>

  <!-- NAVIGATION -->
  <header class="sticky top-0 z-50 w-full border-b border-[#E8E6E1] bg-[#FAF9F6]/90 backdrop-blur-md">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex items-center justify-between py-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-1.5 text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.</span>
        </a>

        <!-- Nav links: About, Articles, Products -->
        <nav class="hidden items-center gap-8 md:flex">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Products</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Button: Roast My Ads -->
          <a
            href="/roast-my-ads"
            class="inline-flex items-center gap-1.5 rounded-md bg-[#E24A1F] px-4 py-2 text-xs sm:text-sm font-bold text-white transition hover:bg-[#C53B12] shadow-sm"
          >
            Roast My Ads →
          </a>

          <!-- Mobile hamburger -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="flex h-9 w-9 items-center justify-center rounded-md border border-[#E8E6E1] text-[#5E5D64] transition hover:bg-white md:hidden"
            aria-label="Toggle menu"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden pb-4 md:hidden border-t border-[#E8E6E1] pt-3">
        <nav class="flex flex-col gap-3">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64]">Products</a>
          <a href="/roast-my-ads" class="text-sm font-semibold text-[#E24A1F]">Roast My Ads</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="flex-auto">

    <!-- 1. HERO SECTION -->
    <section class="border-b border-[#E8E6E1] bg-[#FAF9F6] py-16 sm:py-24">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 border border-[#E24A1F]/30 bg-[#E24A1F]/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-[#E24A1F] rounded">
            For Problem-Solving Products &amp; Services
          </div>

          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-[#141416] sm:text-5xl lg:text-6xl sm:leading-[1.1]">
            Stop searching ad libraries from scratch. Get 30 proven static ads and the breakdowns behind why they convert.
          </h1>

          <p class="mt-6 text-lg text-[#5E5D64] sm:text-xl leading-relaxed">
            Whether you sell a skincare product or an AI service, every high-performing ad works on the exact same core concept: clearly illustrating a customer problem and presenting your offer as the solution. The Vault gives you 30 proven static ad formats and the exact thinking behind them so you never start from zero. Plus, you get lifetime access to all future ad formats added here as we test new concepts. Mix and match these principles to build high-converting creatives in an afternoon.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="https://pages.razorpay.com/static-ad-vault"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-md bg-[#E24A1F] px-6 py-3.5 text-base font-bold text-white shadow-sm transition hover:bg-[#C53B12]"
            >
              Get The Vault for ₹999 <span aria-hidden="true">→</span>
            </a>
            <a
              href="#samples"
              class="inline-flex items-center gap-2 rounded-md border border-[#E8E6E1] bg-white px-6 py-3.5 text-base font-semibold text-[#141416] transition hover:border-[#141416]/40 shadow-xs"
            >
              See Sample Breakdowns
            </a>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-[#5E5D64]">
            <span class="font-medium">✓ Instant digital access</span>
            <span>·</span>
            <span class="font-medium">✓ Works for both products &amp; services</span>
            <span>·</span>
            <span class="font-medium">✓ Access to all upcoming ad formats</span>
          </div>
        </div>

        <!-- VISUAL COLLAGE: 6 VAULT CREATIVES -->
        <div class="mt-14">
          <div class="mb-3 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-[#8E8D94]">
            <span>Visual Preview: 6 of 30+ Static Formats Inside</span>
            <span class="text-[#E24A1F]">30+ In-Depth Teardowns &amp; Updates</span>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            {vaultCollage.map((item) => (
              <div class={`rounded-lg border p-3.5 flex flex-col justify-between aspect-[3/4] ${item.accent}`}>
                <div>
                  <span class={`inline-block text-[10px] font-bold px-1.5 py-0.5 uppercase tracking-wider rounded ${item.pill}`}>
                    {item.tag}
                  </span>
                  <div class="mt-3 text-xs font-bold text-[#141416] leading-snug">
                    {item.type}
                  </div>
                </div>
                <div class="text-[11px] text-[#5E5D64] border-t border-[#E8E6E1] pt-2">
                  {item.title}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. THE PROBLEM -->
    <section id="problem" class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">The Bottleneck</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          Why Creative Testing Always Stalls
        </h2>
        <p class="mt-3 text-base text-[#5E5D64]">
          If your ad performance has flatlined, the problem is rarely your campaign budget setup. It is starting from zero every time you need new creative:
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <div class="text-sm font-bold text-[#E24A1F]">01. Starting From a Blank Canvas</div>
          <p class="mt-2 text-sm text-[#5E5D64] leading-relaxed">
            You spend hours scrolling the Meta Ad Library hoping for inspiration. Staring at an empty Canva or Figma artboard drains momentum before creation even begins.
          </p>
        </div>

        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <div class="text-sm font-bold text-[#E24A1F]">02. Templates That Do Not Fit Your Solution</div>
          <p class="mt-2 text-sm text-[#5E5D64] leading-relaxed">
            Generic template packs and AI prompts look shiny in previews, but collapse when applied to real inventory, specific software dashboards, or unique services.
          </p>
        </div>

        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <div class="text-sm font-bold text-[#E24A1F]">03. Copying Graphics Without Understanding Why</div>
          <p class="mt-2 text-sm text-[#5E5D64] leading-relaxed">
            Copying competitor layouts without grasping the psychological trigger behind them wastes ad spend. When you understand the core mechanics, you can iterate with confidence.
          </p>
        </div>

        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <div class="text-sm font-bold text-[#E24A1F]">04. Slow Production Kills Performance</div>
          <p class="mt-2 text-sm text-[#5E5D64] leading-relaxed">
            Waiting days for freelancers lets existing ads fatigue and customer acquisition costs rise. You need a fast, reliable starting point to produce new tests every week.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. THE SOLUTION -->
    <section class="border-y border-[#E8E6E1] bg-white py-16">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">The Solution</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
            Meet the Static Ad Vault
          </h2>
          <p class="mt-4 text-base sm:text-lg text-[#5E5D64] leading-relaxed font-normal">
            The Static Ad Vault gives you <strong class="text-[#141416]">30 battle-tested static ad formats</strong> paired with <strong class="text-[#141416]">tactical breakdowns</strong> of why they convert. It is built for any problem-solving business: from physical goods like skincare to software, AI services, and consulting. Plus, you get lifetime access to all future ad formats added here as we continue testing winning concepts. You get the hook structure, visual hierarchy, and buyer psychology. Mix and match these core principles to produce original, high-performing ads in an afternoon.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. WHAT YOU GET (SIMPLE & DIRECT: 30 FORMATS + UPDATES + CHECKLIST) -->
    <section id="assets" class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">What Is Included</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          Simple, Practical &amp; Built for Speed
        </h2>
        <p class="mt-3 text-sm sm:text-base text-[#5E5D64]">
          No bloated courses or 40-hour video libraries. You get the 30 proven static ad formats, continuous updates as new winning ads are added, and a clear checklist to execute immediately.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {whatsIncluded.map((item) => (
          <div class="rounded-xl border border-[#E8E6E1] bg-white p-7 transition hover:border-[#E24A1F] shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center font-mono text-sm font-bold text-[#E24A1F] bg-[#E24A1F]/10 rounded-lg">
                  {item.num}
                </span>
                <span class="border border-[#E24A1F]/30 bg-[#E24A1F]/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-[#E24A1F] rounded">
                  {item.badge}
                </span>
              </div>
              <h3 class="text-lg font-bold text-[#141416]">{item.name}</h3>
              <p class="mt-3 text-sm text-[#5E5D64] leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. SAMPLE CREATIVES (3 FULL BREAKDOWNS COVERING PRODUCTS & SERVICES) -->
    <section id="samples" class="border-t border-[#E8E6E1] bg-white py-20">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Inside the Vault</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
            Sample Teardowns
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#5E5D64]">
            Here is how entries inside the Vault are structured. Notice how the exact same underlying concept applies directly to both physical products and digital services:
          </p>
        </div>

        <div class="mt-12 space-y-10">
          {sampleCreatives.map((sample) => (
            <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-6 sm:p-8 shadow-xs">
              <div class="flex flex-wrap items-center justify-between border-b border-[#E8E6E1] pb-4">
                <div>
                  <span class="font-mono text-xs font-bold text-[#E24A1F]">VAULT SAMPLE {sample.id}</span>
                  <h3 class="text-xl font-bold text-[#141416]">{sample.type}</h3>
                </div>
                <span class="border border-[#E8E6E1] bg-white px-2.5 py-1 text-xs font-semibold text-[#5E5D64] rounded">
                  {sample.format}
                </span>
              </div>

              <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
                <div class="space-y-5">
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#8E8D94]">What It Is</h4>
                    <p class="mt-1 text-sm text-[#141416] leading-relaxed">{sample.whatItIs}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#8E8D94]">Why It Works (The Psychology)</h4>
                    <p class="mt-1 text-sm text-[#5E5D64] leading-relaxed">{sample.whyItWorks}</p>
                  </div>
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#8E8D94]">How To Adapt It</h4>
                    <p class="mt-1 text-sm text-[#5E5D64] leading-relaxed">{sample.howToAdapt}</p>
                  </div>
                </div>

                <div class="space-y-5 border-t border-[#E8E6E1] pt-6 md:border-t-0 md:border-l md:border-[#E8E6E1] md:pl-6">
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#8E8D94]">Product &amp; Service Examples</h4>
                    <ul class="mt-2 space-y-2 text-xs text-[#5E5D64]">
                      {sample.variations.map((v) => (
                        <li class="flex items-start gap-2">
                          <span class="font-bold text-[#E24A1F]">·</span>
                          <span>{v}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#E24A1F]">Layout &amp; Execution Tip</h4>
                    <div class="mt-2 rounded-lg bg-white border border-[#E8E6E1] p-3.5 text-xs text-[#141416] leading-relaxed">
                      {sample.adaptationTip}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. HOW IT WORKS (3 SIMPLE STEPS) -->
    <section class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="text-center max-w-xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Workflow</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          How It Works in 3 Steps
        </h2>
        <p class="mt-3 text-sm text-[#5E5D64]">
          Go from zero ideas to launch-ready ads in a single afternoon.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs">
          <span class="font-mono text-2xl font-bold text-[#E24A1F]">01</span>
          <h3 class="mt-3 text-base font-bold text-[#141416]">Pick a Starting Point</h3>
          <p class="mt-2 text-xs text-[#5E5D64] leading-relaxed">
            Open the Vault and choose a proven concept matching your customer's problem: contrast comparison, native proof, or an educational audit.
          </p>
