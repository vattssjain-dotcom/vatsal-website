---
import Layout from '../layouts/Layout.astro';

const deliverables = [
  {
    num: '01',
    title: '25 Custom Visual Concepts',
    desc: 'Designed around your specific product, pain points, competitor gaps, and active customer reviews. No recycled templates.',
  },
  {
    num: '02',
    title: '3 Formats Per Ad (75 Total Files)',
    desc: 'Delivered in square (1:1 feed), vertical (9:16 reels/stories), and wide (16:9 in-stream/desktop) so you have native placements ready on day one.',
  },
  {
    num: '03',
    title: 'Full Creative Diversity',
    desc: 'A deliberate mix of comparison charts, social proof overlays, product-in-use shots, benefit stacks, and objection handlers to give Meta varied signals.',
  },
  {
    num: '04',
    title: 'Editable Source Files & Copy',
    desc: 'Complete high-resolution PNGs plus structured primary text and headline recommendations for each ad concept.',
  },
];

const reasons = [
  {
    title: 'Statics Convert Without Production Overhead',
    desc: 'You do not need an actor, lighting crew, or days of video editing to find a winning message. A clear static ad delivers the core reason to buy in 2 seconds flat.',
  },
  {
    title: 'Creative Diversity Is What Scales Accounts',
    desc: 'Testing 3 slight variations of the same product image fails quickly. You need distinct psychological angles: price vs value, speed, social proof, and problem comparison running in parallel.',
  },
  {
    title: 'Meta Algorithm Feeds on Diverse Placements',
    desc: 'Feeding Meta only 1:1 squares leaves Reels and Stories inventory running poorly formatted crops. Having true native 9:16 and 16:9 files drops your effective CPMs.',
  },
];
---

<Layout
  title="25 Custom Static Meta Ads | INR 4,000 | Vatsal Jain"
  description="Get 25 tailor-made static ad creatives built specifically for your brand. Each ad delivered in 1:1, 9:16, and 16:9 formats (75 total files) for INR 4,000."
>
  <!-- TOP ANNOUNCEMENT -->
  <div class="border-b border-[#E24A1F]/20 bg-[#E24A1F]/[0.08] px-4 py-2.5 text-center text-xs font-semibold text-[#E24A1F]">
    ⚡ Custom Creative Production: 25 concepts built specifically for your product or brand.
  </div>

  <!-- NAVBAR -->
  <header class="sticky top-0 z-50 w-full border-b border-[#E8E6E1] bg-[#FAF9F6]/90 backdrop-blur-md">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex items-center justify-between py-4">
        <a href="/" class="flex items-center gap-1.5 text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.</span>
        </a>

        <nav class="hidden items-center gap-8 md:flex">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Products</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/roast-my-ads"
            class="inline-flex items-center gap-1.5 rounded-md bg-[#E24A1F] px-4 py-2 text-xs sm:text-sm font-bold text-white transition hover:bg-[#C53B12] shadow-sm"
          >
            Roast My Ads →
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-auto">
    <!-- HERO -->
    <section class="border-b border-[#E8E6E1] bg-[#FAF9F6] py-16 sm:py-24">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 border border-[#E24A1F]/30 bg-[#E24A1F]/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-[#E24A1F] rounded">
            Done-For-You Creative Asset Pack
          </div>

          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-[#141416] sm:text-5xl lg:text-6xl sm:leading-[1.1]">
            25 Tailor-Made Static Ads Built for Your Product. Delivered in All 3 Formats.
          </h1>

          <p class="mt-6 text-lg text-[#5E5D64] sm:text-xl leading-relaxed">
            Stop waiting weeks on freelance designers or testing tired product shots. We research your customer angles and create 25 brand-specific static ads delivered in 1:1, 9:16, and 16:9 (75 total export files) for ₹4,000.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="mailto:hey@vatsaljain.io?subject=Book%2025%20Static%20Ads%20Pack%20(INR%204000)&body=Hey%20Vatsal%2C%0A%0AI'd%20like%20to%20order%20the%2025%20Static%20Ads%20pack%20for%20my%20brand.%0A%0ABrand%20name%20%2F%20Website%3A%20%0AProduct%20we%20want%20to%20promote%3A%20%0AAny%20specific%20pain%20points%20or%20notes%3A%20"
              class="inline-flex items-center gap-2 rounded-md bg-[#E24A1F] px-6 py-3.5 text-base font-bold text-white shadow-sm transition hover:bg-[#C53B12]"
            >
              Order 25 Custom Ads: ₹4,000 <span aria-hidden="true">→</span>
            </a>
            <a
              href="#formats"
              class="inline-flex items-center gap-2 rounded-md border border-[#E8E6E1] bg-white px-6 py-3.5 text-base font-semibold text-[#141416] transition hover:border-[#141416]/40 shadow-xs"
            >
              See Breakdown
            </a>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-[#5E5D64]">
            <span class="font-medium">✓ 25 bespoke creative concepts</span>
            <span>·</span>
            <span class="font-medium">✓ 3 formats per ad (75 total files)</span>
            <span>·</span>
            <span class="font-medium">✓ 3 to 5 business day turnaround</span>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY STATIC CREATIVE DIVERSITY MATTERS -->
    <section class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">The Strategy</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          Why Creative Diversity Decides Your ROAS
        </h2>
        <p class="mt-3 text-base text-[#5E5D64]">
          Meta's auction algorithm has shifted. Audience targeting is broad by default; your ad creative is the targeting mechanism.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
        {reasons.map((r, i) => (
          <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-[#E24A1F]">0{i + 1}</span>
              <h3 class="mt-2 text-base font-bold text-[#141416]">{r.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-[#5E5D64]">{r.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- THE 3 FORMATS EXPLAINED -->
    <section id="formats" class="border-y border-[#E8E6E1] bg-white py-20">
      <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Zero Cropping Headaches</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
            Every Ad Delivered in All 3 Core Placements
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#5E5D64]">
            When you launch an ad, running a square image inside a vertical Story looks cheap and gets skipped. Each of your 25 concepts is exported natively for:
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
          <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-6 text-center flex flex-col items-center">
            <div class="h-28 w-28 rounded-lg border-2 border-dashed border-[#E24A1F]/40 bg-white flex items-center justify-center font-mono font-bold text-[#E24A1F] text-lg mb-4">
              1:1
            </div>
            <h3 class="text-base font-bold text-[#141416]">Feed Format (Square)</h3>
            <span class="text-xs font-semibold text-[#8E8D94] mt-1">1080 × 1080 px</span>
            <p class="mt-2 text-xs text-[#5E5D64] leading-relaxed">
              Engineered for standard Instagram and Facebook feeds, explore tabs, and marketplace placement.
            </p>
          </div>

          <div class="rounded-xl border border-[#E24A1F]/30 bg-[#E24A1F]/[0.04] p-6 text-center flex flex-col items-center shadow-xs">
            <div class="h-36 w-20 rounded-lg border-2 border-solid border-[#E24A1F] bg-white flex items-center justify-center font-mono font-bold text-[#E24A1F] text-lg mb-4">
              9:16
            </div>
            <h3 class="text-base font-bold text-[#141416]">Reels &amp; Stories (Full Screen)</h3>
            <span class="text-xs font-semibold text-[#E24A1F] mt-1">1080 × 1920 px</span>
            <p class="mt-2 text-xs text-[#5E5D64] leading-relaxed">
              Full-bleed vertical layout. Designed with safe zones so Meta UI buttons and captions never block your text.
            </p>
          </div>

          <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-6 text-center flex flex-col items-center">
            <div class="h-20 w-36 rounded-lg border-2 border-dashed border-[#E24A1F]/40 bg-white flex items-center justify-center font-mono font-bold text-[#E24A1F] text-lg mb-4">
              16:9
            </div>
            <h3 class="text-base font-bold text-[#141416]">Landscape (Desktop / Video In-Stream)</h3>
            <span class="text-xs font-semibold text-[#8E8D94] mt-1">1920 × 1080 px</span>
            <p class="mt-2 text-xs text-[#5E5D64] leading-relaxed">
              Clean landscape composition for Facebook desktop feeds, video right-column placements, and search feeds.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT YOU RECEIVE -->
    <section class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:px-12">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">The Package</span>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          What You Get for ₹4,000
        </h2>
      </div>

      <div class="mt-10 space-y-4">
        {deliverables.map((item) => (
          <div class="rounded-xl border border-[#E8E6E1] bg-white p-6 shadow-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-start gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center font-mono text-sm font-bold text-[#E24A1F] bg-[#E24A1F]/10 rounded-lg">
                {item.num}
              </span>
              <div>
                <h3 class="text-base font-bold text-[#141416]">{item.title}</h3>
                <p class="mt-1 text-xs text-[#5E5D64] leading-relaxed max-w-2xl">{item.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- PRICING / ORDER CARD -->
      <div class="mt-16 rounded-2xl border border-[#E24A1F]/30 bg-white p-8 sm:p-12 shadow-md">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between border-b border-[#E8E6E1] pb-8">
          <div>
            <div class="inline-block bg-[#E24A1F]/10 px-2.5 py-1 text-xs font-bold text-[#E24A1F] uppercase tracking-wider mb-2 rounded">
              Brand-Specific Asset Pack
            </div>
            <h3 class="text-2xl font-bold text-[#141416]">25 Static Ads (75 Total Export Files)</h3>
            <p class="mt-1 text-xs text-[#5E5D64]">Bespoke design for your physical product or digital offer</p>
          </div>
          <div class="sm:text-right">
            <div class="text-xs text-[#8E8D94] line-through">Agency Rate ₹12,000+</div>
            <div class="text-4xl font-extrabold text-[#E24A1F] sm:text-5xl">₹4,000</div>
            <div class="text-xs text-[#5E5D64]">One-time flat price · Delivery in 3–5 days</div>
          </div>
        </div>

        <div class="mt-8">
          <a
            href="mailto:hey@vatsaljain.io?subject=Book%2025%20Static%20Ads%20Pack%20(INR%204000)&body=Hey%20Vatsal%2C%0A%0AI'd%20like%20to%20order%20the%2025%20Static%20Ads%20pack%20for%20my%20brand.%0A%0ABrand%20name%20%2F%20Website%3A%20%0AProduct%20we%20want%20to%20promote%3A%20%0AAny%20specific%20pain%20points%20or%20notes%3A%20"
            class="flex w-full items-center justify-center gap-2 rounded-md bg-[#E24A1F] px-8 py-4 text-center text-sm font-bold uppercase tracking-wider text-white transition hover:bg-[#C53B12] shadow-sm"
          >
            Order Your 25 Custom Ads: ₹4,000
            <span aria-hidden="true">→</span>
          </a>
          <p class="mt-3 text-center text-xs text-[#8E8D94]">
            Send your product link or website. We review, confirm angles, and deliver your full pack via Google Drive or Figma.
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- STICKY BOTTOM FULL-WIDTH CTA BAR -->
  <div class="sticky bottom-0 z-40 w-full border-t border-[#E8E6E1] bg-[#FAF9F6]/95 backdrop-blur-md py-3 px-4 shadow-[0_-4px_16px_rgba(0,0,0,0.06)]">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4">
      <div class="hidden sm:flex flex-col">
        <span class="text-xs font-bold text-[#141416]">25 Custom Static Ads Pack (75 Total Export Files)</span>
        <span class="text-[11px] text-[#5E5D64]">Bespoke design · Delivered in 1:1, 9:16, and 16:9</span>
      </div>
      <div class="w-full sm:w-auto flex items-center justify-between sm:justify-end gap-3 flex-1">
        <div class="flex items-baseline gap-1.5 sm:mr-3">
          <span class="text-xs text-[#8E8D94] line-through">₹12,000</span>
          <span class="text-xl font-extrabold text-[#E24A1F]">₹4,000</span>
        </div>
        <a
          href="mailto:hey@vatsaljain.io?subject=Book%2025%20Static%20Ads%20Pack%20(INR%204000)&body=Hey%20Vatsal%2C%0A%0AI'd%20like%20to%20order%20the%2025%20Static%20Ads%20pack%20for%20my%20brand.%0A%0ABrand%20name%20%2F%20Website%3A%20%0AProduct%20we%20want%20to%20promote%3A%20%0AAny%20specific%20pain%20points%20or%20notes%3A%20"
          class="inline-flex flex-1 sm:flex-initial items-center justify-center gap-2 rounded-md bg-[#E24A1F] px-6 py-2.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-white shadow-sm transition hover:bg-[#C53B12]"
        >
          Order 25 Ads: ₹4,000 →
        </a>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="border-t border-[#E8E6E1] bg-[#FAF9F6] py-10">
    <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-5 sm:flex-row sm:px-8 lg:px-12">
      <p class="text-xs text-[#8E8D94]">
        © {new Date().getFullYear()} Vatsal Jain · Arqo Studio. All rights reserved.
      </p>
      <div class="flex gap-6 text-xs text-[#5E5D64]">
        <a href="/" class="hover:text-[#141416]">Home</a>
        <a href="/vault" class="hover:text-[#141416]">Ad Vault</a>
        <a href="/roast-my-ads" class="hover:text-[#141416]">Roast My Ads</a>
        <a href="https://arqostudio.com/contact" class="hover:text-[#141416]">Arqo Studio</a>
      </div>
    </div>
  </footer>
</Layout>
