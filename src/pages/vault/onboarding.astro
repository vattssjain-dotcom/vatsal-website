---
import Layout from '../../layouts/Layout.astro';

const CAL_BOOKING_URL = "https://cal.com/arqo-studio/discovery-call";
---

<Layout
  title="Client Onboarding · 25 Custom Ads Package | Arqo Studio"
  description="Submit your business details and schedule your 1-on-1 strategy discovery call with Vatsal Jain."
  robots="noindex, nofollow"
>
  <div class="min-h-screen flex flex-col justify-between bg-[#FAF9F6] text-[#141416]">

    <!-- CLEAN TOP HEADER -->
    <header class="border-b border-[#E8E6E1] bg-white py-4 px-5 sm:px-8">
      <div class="mx-auto max-w-4xl flex items-center justify-between">
        <a href="/" class="text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.</span>
          <span class="ml-2 text-xs font-normal text-[#8E8D94]">· Arqo Studio</span>
        </a>
        <div class="flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Order Confirmed · ₹3,500</span>
        </div>
      </div>
    </header>

    <main class="flex-1 py-8 sm:py-12 px-5 sm:px-8">
      <div class="mx-auto w-full max-w-3xl space-y-8">

        <!-- WELCOME BANNER & STEPS PROGRESS -->
        <div class="text-center sm:text-left">
          <div class="inline-flex items-center gap-2 rounded-full bg-orange-100 text-[#E24A1F] px-3 py-1 text-xs font-bold uppercase tracking-wider mb-2">
            <span>🎉 Payment Successful</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-black text-[#141416] tracking-tight">
            Welcome to Your 25 Custom Ads Sprint!
          </h1>
          <p class="text-xs sm:text-sm text-[#5E5D64] mt-2 leading-relaxed">
            Let's get your creative engine rolling. Complete Step 1 below to submit your business details, and then select your call time on the calendar in Step 2.
          </p>

          <!-- PROGRESS STEPS -->
          <div class="mt-6 grid grid-cols-2 gap-3 text-left">
            <div id="step-pill-1" class="rounded-xl border-2 border-[#E24A1F] bg-white p-3.5 shadow-xs transition-all">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#E24A1F] block">Step 1</span>
              <span class="text-xs sm:text-sm font-bold text-[#141416] block mt-0.5">Submit Business Details</span>
            </div>
            <div id="step-pill-2" class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-3.5 opacity-60 transition-all">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#8E8D94] block">Step 2</span>
              <span class="text-xs sm:text-sm font-bold text-[#8E8D94] block mt-0.5">Book Discovery Call</span>
            </div>
          </div>
        </div>

        <!-- STEP 1: BUSINESS DETAILS INTAKE FORM -->
        <div id="onboarding-form-section" class="rounded-3xl border border-[#E8E6E1] bg-white p-6 sm:p-10 shadow-lg">
          <div class="border-b border-[#E8E6E1] pb-5">
            <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Intake Questionnaire</span>
            <h2 class="text-xl sm:text-2xl font-black text-[#141416] mt-1">
              Tell Us About Your Brand &amp; Goals
            </h2>
            <p class="text-xs text-[#5E5D64] mt-1">
              Takes just 2 minutes. Our team will review this to prepare custom angles before your strategy call.
            </p>
          </div>

          <form id="onboarding-form" class="mt-6 space-y-5">
            
            <!-- BRAND & WEBSITE -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="business-name" class="block text-xs font-bold text-[#141416]">
                  Business / Brand Name <span class="text-[#E24A1F]">*</span>
                </label>
                <input
                  type="text"
                  id="business-name"
                  name="business_name"
                  required
                  placeholder="e.g. Lumina Skincare"
                  class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
                />
              </div>

              <div>
                <label for="website-url" class="block text-xs font-bold text-[#141416]">
                  Website / Store URL <span class="text-[#E24A1F]">*</span>
                </label>
                <input
                  type="url"
                  id="website-url"
                  name="website_url"
                  required
                  placeholder="https://yourbrand.com"
                  class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
                />
              </div>
            </div>

            <!-- CONTACT DETAILS -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label for="client-name" class="block text-xs font-bold text-[#141416]">
                  Your Name <span class="text-[#E24A1F]">*</span>
                </label>
                <input
                  type="text"
                  id="client-name"
                  name="name"
                  required
                  placeholder="Alex Sharma"
                  class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
                />
              </div>

              <div>
                <label for="client-email" class="block text-xs font-bold text-[#141416]">
                  Email Address <span class="text-[#E24A1F]">*</span>
                </label>
                <input
                  type="email"
                  id="client-email"
                  name="email"
                  required
                  placeholder="alex@yourbrand.com"
                  class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
                />
              </div>

              <div>
                <label for="client-phone" class="block text-xs font-bold text-[#141416]">
                  WhatsApp / Phone <span class="text-[#E24A1F]">*</span>
                </label>
                <input
                  type="tel"
                  id="client-phone"
                  name="phone"
                  required
                  placeholder="+91 98765 43210"
                  class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
                />
              </div>
            </div>

            <!-- PRODUCT / OFFER SUMMARY -->
            <div>
              <label for="product-summary" class="block text-xs font-bold text-[#141416]">
                What product or service are we advertising? <span class="text-[#E24A1F]">*</span>
              </label>
              <p class="text-[11px] text-[#8E8D94] mt-0.5">
                Briefly describe what you're selling, price point, and what makes it unique or different.
              </p>
              <textarea
                id="product-summary"
                name="product_summary"
                rows="3"
                required
                placeholder="e.g. We sell an all-natural Vitamin C glow serum at ₹999. Key difference: 100% waterless formula that doesn't oxidize or turn brown."
                class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
              ></textarea>
            </div>

            <!-- TARGET CUSTOMER & PAIN POINTS -->
            <div>
              <label for="target-customer" class="block text-xs font-bold text-[#141416]">
                Who is your ideal customer &amp; what is their main frustration? <span class="text-[#E24A1F]">*</span>
              </label>
              <p class="text-[11px] text-[#8E8D94] mt-0.5">
                What problem are they desperately trying to solve before they discover you?
              </p>
              <textarea
                id="target-customer"
                name="target_customer"
                rows="2"
                required
                placeholder="e.g. Working women aged 24-38 dealing with stubborn dark spots and dullness from screen fatigue. Tired of sticky serums that cause breakouts."
                class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
              ></textarea>
            </div>

            <!-- COMPETITORS & INSPIRATION -->
            <div>
              <label for="competitor-links" class="block text-xs font-bold text-[#141416]">
                Competitor Ads or References (Optional)
              </label>
              <p class="text-[11px] text-[#8E8D94] mt-0.5">
                Any competitor links, Meta Ad Library URLs, or brands whose creative style you admire?
              </p>
              <input
                type="text"
                id="competitor-links"
                name="competitor_links"
                placeholder="e.g. Competitor A, Competitor B or links to ads"
                class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
              />
            </div>

            <!-- BRAND ASSETS LINK -->
            <div>
              <label for="assets-link" class="block text-xs font-bold text-[#141416]">
                Brand Assets Folder Link (Google Drive / Dropbox / Figma) <span class="text-[#E24A1F]">*</span>
              </label>
              <p class="text-[11px] text-[#8E8D94] mt-0.5">
                Share a link to your folder with logos, product cutouts, photos, or font files (ensure link sharing is set to "Anyone with link can view").
              </p>
              <input
                type="url"
                id="assets-link"
                name="assets_link"
                required
                placeholder="https://drive.google.com/drive/folders/..."
                class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
              />
            </div>

            <!-- SPECIAL INSTRUCTIONS -->
            <div>
              <label for="special-instructions" class="block text-xs font-bold text-[#141416]">
                Any specific offers, discounts, or notes to highlight? (Optional)
              </label>
              <textarea
                id="special-instructions"
                name="special_instructions"
                rows="2"
                placeholder="e.g. Free shipping on orders over ₹499, highlight Buy 1 Get 1 promo, avoid neon colors..."
                class="mt-1.5 w-full rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm text-[#141416] placeholder-[#8E8D94] focus:border-[#E24A1F] focus:bg-white focus:outline-hidden focus:ring-1 focus:ring-[#E24A1F]"
              ></textarea>
            </div>

            <!-- SUBMIT BUTTON -->
            <div class="pt-4">
              <button
                type="submit"
                id="submit-onboarding-btn"
                class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-[#E24A1F] py-4 text-sm sm:text-base font-extrabold text-white shadow-lg hover:bg-[#C53B12] active:scale-[0.99] transition uppercase tracking-wider cursor-pointer"
              >
                <span>Save Brief &amp; Proceed to Calendar Booking</span>
                <span aria-hidden="true">→</span>
              </button>
            </div>

          </form>
        </div>

        <!-- STEP 2: MEETING BOOKING VIA CAL.COM EMBED (REVEALED ON SUBMIT) -->
        <div id="booking-section" class="rounded-3xl border-2 border-emerald-500 bg-white p-6 sm:p-10 shadow-xl hidden">
          
          <!-- SUCCESS CONFIRMATION HEADER -->
          <div class="rounded-2xl bg-emerald-50 border border-emerald-200 p-4 sm:p-5 flex items-start gap-3.5 mb-8">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold text-lg">
              ✓
            </div>
            <div>
              <h3 class="text-sm sm:text-base font-bold text-emerald-950">
                Brief Successfully Submitted!
              </h3>
              <p class="text-xs text-emerald-800 mt-0.5">
                Now pick a 20-minute slot on Vatsal's live calendar below to align on your creative angles:
              </p>
            </div>
          </div>

          <div class="border-b border-[#E8E6E1] pb-4 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Step 2 · Final Step</span>
              <h2 class="text-xl sm:text-2xl font-black text-[#141416] mt-1">
                Book Your 1-on-1 Creative Strategy Call
              </h2>
              <p class="text-xs text-[#5E5D64] mt-0.5">
                With Vatsal Jain (Founder, Arqo Studio) · 20 Min Discovery Call
              </p>
            </div>

            <a
              href={CAL_BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-2 text-xs font-bold text-[#141416] hover:border-[#E24A1F] hover:text-[#E24A1F] transition shrink-0"
            >
              <span>Open in New Tab</span>
              <span>↗</span>
            </a>
          </div>

          <!-- CAL.COM LIVE EMBED -->
          <div class="rounded-2xl border border-[#E8E6E1] overflow-hidden bg-white">
            <iframe
              id="cal-embed-iframe"
              src={`${CAL_BOOKING_URL}?embed=true`}
              width="100%"
              height="750"
              frameborder="0"
              class="w-full min-h-[650px] sm:min-h-[750px] border-0"
            ></iframe>
          </div>

          <!-- POST-BOOKING REASSURANCE -->
          <div class="mt-8 rounded-2xl bg-[#FAF9F6] border border-[#E8E6E1] p-5 text-center text-xs text-[#5E5D64] space-y-1">
            <p class="font-bold text-[#141416]">What happens after booking?</p>
            <p>You'll receive a calendar invitation with Google Meet details. We'll review your brief, confirm your 25 angles, and deliver the complete ad folder within 5–7 business days.</p>
            <p class="text-[11px] text-[#8E8D94] pt-2">Questions? Reach out anytime at <a href="mailto:hello@arqostudio.com" class="text-[#E24A1F] underline">hello@arqostudio.com</a>.</p>
          </div>

        </div>

      </div>
    </main>

    <!-- MINIMAL FOOTER -->
    <footer class="py-6 text-center text-xs text-[#8E8D94] border-t border-[#E8E6E1] bg-white">
      <div class="flex flex-wrap justify-center items-center gap-4">
        <span>© {new Date().getFullYear()} Vatsal Jain · Arqo Studio</span>
        <span>·</span>
        <a href="/privacy" class="underline hover:text-[#141416]">Privacy Policy</a>
        <span>·</span>
        <a href="/terms" class="underline hover:text-[#141416]">Terms &amp; Conditions</a>
        <span>·</span>
        <a href="mailto:hello@arqostudio.com" class="underline hover:text-[#141416]">hello@arqostudio.com</a>
      </div>
    </footer>

  </div>

  <!-- ONBOARDING SCRIPT -->
  <script is:inline>
    (function() {
      const urlParams = new URLSearchParams(window.location.search);
      const paymentId = urlParams.get('payment_id') || '';
      const orderId = urlParams.get('order_id') || '';
      const paramName = urlParams.get('name') || '';
      const paramEmail = urlParams.get('email') || '';
      const paramPhone = urlParams.get('phone') || '';

      const nameInput = document.getElementById('client-name');
      const emailInput = document.getElementById('client-email');
      const phoneInput = document.getElementById('client-phone');

      if (paramName && nameInput) nameInput.value = paramName;
      if (paramEmail && emailInput) emailInput.value = paramEmail;
      if (paramPhone && phoneInput) phoneInput.value = paramPhone;

      // Try local storage if fields empty
      if (emailInput && !emailInput.value) {
        try {
          const leads = JSON.parse(localStorage.getItem('vault_captured_leads') || '[]');
          if (leads.length > 0) {
            const last = leads[leads.length - 1];
            if (last.name && nameInput && !nameInput.value) nameInput.value = last.name;
            if (last.email && emailInput && !emailInput.value) emailInput.value = last.email;
            if (last.phone && phoneInput && !phoneInput.value) phoneInput.value = last.phone;
          }
        } catch (e) {}
      }

      const form = document.getElementById('onboarding-form');
      const formSection = document.getElementById('onboarding-form-section');
      const bookingSection = document.getElementById('booking-section');
      const stepPill1 = document.getElementById('step-pill-1');
      const stepPill2 = document.getElementById('step-pill-2');
      const submitBtn = document.getElementById('submit-onboarding-btn');

      // Check if already submitted in this session
      const alreadySubmitted = sessionStorage.getItem('vatsal_onboarding_submitted') === 'true';
      if (alreadySubmitted) {
        revealBookingSection();
      }

      function revealBookingSection() {
        formSection.classList.add('hidden');
        bookingSection.classList.remove('hidden');

        // Update pills
        stepPill1.classList.remove('border-2', 'border-[#E24A1F]', 'bg-white');
        stepPill1.classList.add('border', 'border-emerald-300', 'bg-emerald-50/50', 'text-emerald-800');
        stepPill1.innerHTML = `<span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 block">✓ Step 1 Complete</span><span class="text-xs sm:text-sm font-bold text-emerald-950 block mt-0.5">Details Submitted</span>`;

        stepPill2.classList.remove('opacity-60', 'border-[#E8E6E1]', 'bg-[#FAF9F6]');
        stepPill2.classList.add('border-2', 'border-[#E24A1F]', 'bg-white', 'opacity-100');
        stepPill2.querySelector('span:first-child').classList.replace('text-[#8E8D94]', 'text-[#E24A1F]');
        stepPill2.querySelector('span:last-child').classList.replace('text-[#8E8D94]', 'text-[#141416]');

        // Smooth scroll to booking
        bookingSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.innerHTML = `<span>Saving Your Details...</span>`;
          submitBtn.setAttribute('disabled', 'true');
        }

        const formData = new FormData(form);
        const payload = {
          business_name: formData.get('business_name') || '',
          website_url: formData.get('website_url') || '',
          name: formData.get('name') || '',
          email: formData.get('email') || '',
          phone: formData.get('phone') || '',
          product_summary: formData.get('product_summary') || '',
          target_customer: formData.get('target_customer') || '',
          competitor_links: formData.get('competitor_links') || '',
          assets_link: formData.get('assets_link') || '',
          special_instructions: formData.get('special_instructions') || '',
          payment_id: paymentId,
          order_id: orderId,
        };

        try {
          // Backup locally
          localStorage.setItem('vatsal_client_onboarding_backup', JSON.stringify(payload));

          // Post to serverless function
          const res = await fetch('/api/submit-onboarding', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          sessionStorage.setItem('vatsal_onboarding_submitted', 'true');
          revealBookingSection();
        } catch (err) {
          console.error('Onboarding submission error:', err);
          // Even if network blips, allow user to continue to book their call
          sessionStorage.setItem('vatsal_onboarding_submitted', 'true');
          revealBookingSection();
        }
      });
    })();
  </script>
</Layout>
