---
import Layout from '../../layouts/Layout.astro';

// ==========================================
// CONFIGURATION
// ==========================================
const GOOGLE_DRIVE_VAULT_URL = "https://drive.google.com/drive/folders/1lvUJOkiVOmAwIDbMlOJF9duh8PipGwZP?usp=sharing";
const PDF_DOWNLOAD_URL = "/The_Static_Ad_Vault.pdf";
const UPSELL_PAYMENT_URL = "https://pages.razorpay.com/25-static-ads-upsell";
const UPSELL_PRICE_DISCOUNTED = "₹2,499";
const UPSELL_PRICE_REGULAR = "₹4,000";
const TIMER_SECONDS = 120; // 2 minutes urgency
---

<Layout
  title="Order Confirmed · Special Upgrade Offer | Vatsal Jain"
  description="Your Static Ad Vault is ready. Exclusive 2-minute upgrade: 25 custom ads made for your business."
  robots="noindex, nofollow"
>
  <!-- Purchase Tracking Pixel -->
  <script is:inline>
    if (typeof fbq === 'function') {
      fbq('track', 'Purchase', {
        value: 999.00,
        currency: 'INR',
        content_name: 'Static Ad Vault'
      });
    }
  </script>

  <div class="min-h-screen flex flex-col justify-between bg-[#FAF9F6] text-[#141416]">

    <!-- MINIMAL CLEAN HEADER -->
    <header class="border-b border-[#E8E6E1] bg-white/80 backdrop-blur-md py-4 px-5 sm:px-8">
      <div class="mx-auto max-w-2xl flex items-center justify-between">
        <a href="/" class="text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.</span>
        </a>
        <div class="flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Order Confirmed</span>
        </div>
      </div>
    </header>

    <main class="flex-1 py-8 sm:py-12 px-5 sm:px-8 flex items-center">
      <div class="mx-auto w-full max-w-2xl space-y-6">

        <!-- 1. INSTANT ACCESS / THANK YOU -->
        <div class="rounded-xl border border-[#E8E6E1] bg-white p-5 sm:p-6 shadow-xs">
          <div class="flex items-center gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 font-bold text-lg">
              ✓
            </div>
            <div>
              <h1 class="text-base sm:text-lg font-bold text-[#141416]">Thank you! Your Static Ad Vault is ready.</h1>
              <p class="text-xs text-[#5E5D64]">Lifetime access confirmed. Download your files below:</p>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a
              href={GOOGLE_DRIVE_VAULT_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 rounded-lg bg-[#E24A1F] px-4 py-3 text-xs sm:text-sm font-bold text-white hover:bg-[#C53B12] shadow-sm transition"
            >
              <span>Open Google Drive Access Hub</span>
              <span>↗</span>
            </a>
            <a
              href={PDF_DOWNLOAD_URL}
              download="The_Static_Ad_Vault.pdf"
              class="flex items-center justify-center gap-2 rounded-lg border border-[#E8E6E1] bg-[#FAF9F6] px-4 py-3 text-xs sm:text-sm font-bold text-[#141416] hover:border-[#E24A1F] hover:text-[#E24A1F] transition"
            >
              <span>Download Playbook PDF (4.3MB)</span>
              <span>↓</span>
            </a>
          </div>
        </div>

        <!-- 2. THE DIRECT 2-MINUTE COUNTDOWN UPSELL CARD -->
        <div class="rounded-2xl border-2 border-[#E24A1F] bg-white p-6 sm:p-8 shadow-xl relative">
          
          <!-- TOP URGENCY ROW -->
          <div class="flex items-center justify-between pb-4 border-b border-[#E8E6E1]">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E24A1F]/10 px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-wider text-[#E24A1F]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#E24A1F] animate-ping"></span>
              Special One-Time Offer
            </span>
            
            <!-- 2-MIN LIVE CLOCK -->
            <div class="flex items-center gap-2">
              <span class="text-xs font-semibold text-[#8E8D94] uppercase tracking-wider">Offer Closes In:</span>
              <div id="countdown" class="font-mono text-base sm:text-lg font-black text-white bg-[#141416] px-2.5 py-0.5 rounded shadow-inner">
                02:00
              </div>
            </div>
          </div>

          <!-- HEADLINE & PITCH -->
          <div class="mt-5">
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#141416] leading-tight">
              Want us to make 25 custom ads for your business?
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-[#5E5D64] leading-relaxed">
              Skip 20 hours of designing in Canva or Figma. Send us your website or product and we'll research your competitor angles, write the hooks, and design 25 ready-to-run ads in all 3 formats.
            </p>
          </div>

          <!-- VALUE BULLETS -->
          <div class="mt-5 space-y-2.5 rounded-xl bg-[#FAF9F6] border border-[#E8E6E1] p-4 text-xs sm:text-sm">
            <div class="flex items-start gap-2.5 text-[#141416]">
              <span class="text-[#E24A1F] font-bold">✓</span>
              <span><strong>25 Bespoke Visual Concepts:</strong> Designed specifically around your product and customer objections.</span>
            </div>
            <div class="flex items-start gap-2.5 text-[#141416]">
              <span class="text-[#E24A1F] font-bold">✓</span>
              <span><strong>All 3 Formats (75 Files):</strong> 1:1 Feed, 9:16 Reels/Stories, and 16:9 Landscape.</span>
            </div>
            <div class="flex items-start gap-2.5 text-[#141416]">
              <span class="text-[#E24A1F] font-bold">✓</span>
              <span><strong>Copywriting Hooks Included:</strong> Tested headlines and primary text for every creative.</span>
            </div>
            <div class="flex items-start gap-2.5 text-[#141416]">
              <span class="text-[#E24A1F] font-bold">✓</span>
              <span><strong>3 to 5 Day Delivery:</strong> High-res export folder via Google Drive + 1 round of revisions.</span>
            </div>
          </div>

          <!-- PRICING & ACTION -->
          <div class="mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2">
            <div>
              <div class="text-xs text-[#8E8D94] line-through">Standard Rate: {UPSELL_PRICE_REGULAR}</div>
              <div class="flex items-baseline gap-2">
                <span class="text-3xl sm:text-4xl font-black text-[#E24A1F]">{UPSELL_PRICE_DISCOUNTED}</span>
                <span class="text-xs font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">Save ₹1,501 (38% OFF)</span>
              </div>
            </div>

            <a
              id="upsell-btn"
              href={UPSELL_PAYMENT_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#E24A1F] px-6 py-3.5 text-sm sm:text-base font-extrabold text-white shadow-md hover:bg-[#C53B12] active:scale-[0.99] transition uppercase tracking-wider text-center"
            >
              <span>Claim 25 Ads for {UPSELL_PRICE_DISCOUNTED}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <!-- DECLINE LINK -->
          <div class="mt-5 text-center pt-3 border-t border-[#E8E6E1]">
            <a
              href={PDF_DOWNLOAD_URL}
              class="text-xs text-[#8E8D94] hover:text-[#141416] transition underline underline-offset-2"
            >
              No thanks, I'll design all 25 ads myself from scratch
            </a>
          </div>

        </div>

      </div>
    </main>

    <!-- MINIMAL FOOTER -->
    <footer class="py-6 text-center text-xs text-[#8E8D94] border-t border-[#E8E6E1] space-y-2">
      <div class="flex flex-wrap justify-center items-center gap-4">
        <span>© {new Date().getFullYear()} Vatsal Jain · Arqo Studio</span>
        <span>·</span>
        <a href="/privacy" class="underline hover:text-[#141416]">Privacy Policy</a>
        <span>·</span>
        <a href="/terms" class="underline hover:text-[#141416]">Terms &amp; Conditions</a>
        <span>·</span>
        <a href="mailto:hello@arqostudio.com" class="underline hover:text-[#141416]">hello@arqostudio.com</a>
      </div>
      <p class="text-[11px] text-[#A1A1AA] max-w-2xl mx-auto px-4">
        Disclaimer: This site is not a part of the Facebook website or Meta Platforms, Inc. Additionally, this site is NOT endorsed by Facebook / Meta in any way. FACEBOOK is a trademark of META PLATFORMS, INC.
      </p>
    </footer>

  </div>

  <!-- 2-MINUTE COUNTDOWN TIMER -->
  <script is:inline define:vars={{ TIMER_SECONDS, UPSELL_PRICE_REGULAR }}>
    (function() {
      const STORAGE_KEY = 'vatsal_oto_2min_end';
      let endTime = sessionStorage.getItem(STORAGE_KEY);

      if (!endTime) {
        endTime = Date.now() + (TIMER_SECONDS * 1000);
        sessionStorage.setItem(STORAGE_KEY, endTime.toString());
      } else {
        endTime = parseInt(endTime, 10);
      }

      const timerEl = document.getElementById('countdown');
      const btnEl = document.getElementById('upsell-btn');

      function tick() {
        const remaining = endTime - Date.now();
        if (remaining <= 0) {
          if (timerEl) {
            timerEl.textContent = '00:00';
            timerEl.className = 'font-mono text-base sm:text-lg font-bold text-gray-500 bg-gray-200 px-2.5 py-0.5 rounded';
          }
          if (btnEl) {
            btnEl.innerHTML = `<span>Order 25 Ads at Standard Rate (${UPSELL_PRICE_REGULAR})</span> →`;
          }
          return;
        }

        const totalSecs = Math.floor(remaining / 1000);
        const mins = Math.floor(totalSecs / 60);
        const secs = totalSecs % 60;

        const mStr = mins < 10 ? '0' + mins : mins;
        const sStr = secs < 10 ? '0' + secs : secs;

        if (timerEl) timerEl.textContent = `${mStr}:${sStr}`;
      }

      tick();
      setInterval(tick, 1000);

      if (btnEl) {
        btnEl.addEventListener('click', () => {
          if (typeof fbq === 'function') {
            fbq('track', 'InitiateCheckout', {
              content_name: '25 Custom Ads - 2min OTO',
              value: 2499.00,
              currency: 'INR'
            });
          }
        });
      }
    })();
  </script>
</Layout>
