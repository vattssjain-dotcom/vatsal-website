  <!-- COUNTDOWN TIMER & STICKY BAR SCRIPT -->
  <script is:inline define:vars={{ TIMER_MINUTES, UPSELL_PRICE_REGULAR }}>
    (function () {
      const STORAGE_KEY = 'vatsal_oto_end_timestamp';
      const DURATION_MS = TIMER_MINUTES * 60 * 1000;

      // 1. Get or create persistent end timestamp
      let endTimestamp = localStorage.getItem(STORAGE_KEY);
      if (!endTimestamp) {
        endTimestamp = Date.now() + DURATION_MS;
        localStorage.setItem(STORAGE_KEY, endTimestamp.toString());
      } else {
        endTimestamp = parseInt(endTimestamp, 10);
      }

      const minEl = document.getElementById('timer-minutes');
      const secEl = document.getElementById('timer-seconds');
      const stickyPill = document.getElementById('sticky-timer-pill');
      const claimBtn = document.getElementById('claim-upsell-btn');

      function updateClock() {
        const remaining = endTimestamp - Date.now();

        if (remaining <= 0) {
          if (minEl) minEl.textContent = '00';
          if (secEl) secEl.textContent = '00';
          if (stickyPill) {
            stickyPill.textContent = 'Offer Expired';
            stickyPill.className = 'rounded bg-gray-200 px-2 py-0.5 text-[10px] font-mono font-bold text-gray-600';
          }
          if (claimBtn) {
            claimBtn.innerHTML = `<span>Order 25 Custom Ads at Standard Rate (${UPSELL_PRICE_REGULAR})</span> →`;
          }
          return;
        }

        const totalSeconds = Math.floor(remaining / 1000);
        const mins = Math.floor(totalSeconds / 60);
        const secs = totalSeconds % 60;

        const minsStr = mins < 10 ? '0' + mins : mins.toString();
        const secsStr = secs < 10 ? '0' + secs : secs.toString();

        if (minEl) minEl.textContent = minsStr;
        if (secEl) secEl.textContent = secsStr;
        if (stickyPill) stickyPill.textContent = `${minsStr}:${secsStr} left`;

        requestAnimationFrame(() => {});
      }

      updateClock();
      const interval = setInterval(updateClock, 1000);

      // 2. Show Sticky Offer Bar on Scroll
      const stickyBar = document.getElementById('sticky-offer-bar');
      const upgradeSection = document.getElementById('special-upgrade');

      if (stickyBar && upgradeSection) {
        window.addEventListener('scroll', () => {
          const rect = upgradeSection.getBoundingClientRect();
          // Show when user has scrolled near or past the upgrade section
          if (window.scrollY > 400 && rect.bottom > 100) {
            stickyBar.classList.remove('translate-y-full');
          } else {
            stickyBar.classList.add('translate-y-full');
          }
        }, { passive: true });
      }

      // Track upsell click if Meta Pixel loaded
      if (claimBtn) {
        claimBtn.addEventListener('click', () => {
          if (typeof fbq === 'function') {
            fbq('track', 'InitiateCheckout', {
              content_name: '25 Custom Static Ads - Tier 2 Upsell',
              value: 2499.00,
              currency: 'INR'
            });
          }
        });
      }
    })();
  </script>
