  <!-- NON-EXPIRING COUNTDOWN TIMER & MODAL CHECKOUT SCRIPT -->
  <script is:inline define:vars={{ TIMER_SECONDS, UPSELL_PRICE_DISCOUNTED }}>
    (function() {
      // 1. NON-EXPIRING URGENCY COUNTDOWN TIMER
      const STORAGE_KEY = 'vatsal_oto_custom_ads_timer';
      let endTime = sessionStorage.getItem(STORAGE_KEY);

      if (!endTime) {
        endTime = Date.now() + (TIMER_SECONDS * 1000);
        sessionStorage.setItem(STORAGE_KEY, endTime.toString());
      } else {
        endTime = parseInt(endTime, 10);
      }

      const timerEl = document.getElementById('countdown');

      function tick() {
        const remaining = endTime - Date.now();
        if (remaining <= 0) {
          // USER INSTRUCTION: "the offer should not expire even the timer"
          // When timer completes, keep the display at active reserved pulse (never expire or increase price)
          if (timerEl) {
            timerEl.textContent = '00:00';
            timerEl.title = 'Offer rate reserved for you';
          }
          return;
        }

        const totalSecs = Math.floor(remaining / 1000);
        const mins = Math.floor(totalSecs / 60);
        const secs = totalSecs % 60;

        const mStr = mins < 10 ? '0' + mins : mins;
        const sStr = secs < 10 ? '0' + secs : secs;

        if (timerEl) timerEl.textContent = `${mStr}:${sStr}`;
      }

      tick();
      setInterval(tick, 1000);

      // 2. CHECKOUT MODAL CONTROLLER
      const modal = document.getElementById('upsell-checkout-modal');
      const closeBtn = document.getElementById('close-upsell-modal-btn');
      const leadForm = document.getElementById('upsell-lead-form');
      const submitBtn = document.getElementById('upsell-submit-btn');
      const openTriggers = document.querySelectorAll('.open-upsell-modal-btn');

      const nameInput = document.getElementById('upsell-lead-name');
      const emailInput = document.getElementById('upsell-lead-email');
      const phoneInput = document.getElementById('upsell-lead-phone');

      // Pre-fill from existing captured leads or URL query params if user just bought Vault
      try {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('email')) emailInput.value = urlParams.get('email');
        if (urlParams.get('name')) nameInput.value = urlParams.get('name');
        if (urlParams.get('phone')) phoneInput.value = urlParams.get('phone');

        if (!emailInput.value) {
          const storedLeads = JSON.parse(localStorage.getItem('vault_captured_leads') || '[]');
          if (storedLeads.length > 0) {
            const lastLead = storedLeads[storedLeads.length - 1];
            if (lastLead.name && !nameInput.value) nameInput.value = lastLead.name;
            if (lastLead.email && !emailInput.value) emailInput.value = lastLead.email;
            if (lastLead.phone && !phoneInput.value) phoneInput.value = lastLead.phone;
          }
        }
      } catch (e) {}

      function openModal(e) {
        if (e) e.preventDefault();
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
        setTimeout(() => {
          if (!nameInput.value) nameInput.focus();
          else if (!emailInput.value) emailInput.focus();
          else if (!phoneInput.value) phoneInput.focus();
        }, 50);

        if (typeof fbq === 'function') {
          fbq('track', 'InitiateCheckout', {
            content_name: '25 Custom Ads Package',
            value: 3500.00,
            currency: 'INR'
          });
        }
      }

      function closeModal() {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
      }

      openTriggers.forEach((btn) => btn.addEventListener('click', openModal));
      closeBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
      });

      // 3. LEAD TRACKING & ORDER CREATION
      function sendLeadUpdate(status, extra) {
        const payload = {
          status: status,
          name: nameInput?.value.trim() || '',
          email: emailInput?.value.trim() || '',
          phone: phoneInput?.value.trim() || '',
          amount: '₹3,500',
          product: '25 Custom Static Ads Package',
          source: window.location.href,
          timestamp: new Date().toISOString(),
          ...(extra || {})
        };

        try {
          fetch('/api/record-lead', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            keepalive: true,
          }).catch(() => {});
        } catch (err) {}
      }

      leadForm?.addEventListener('submit', async (e) => {
        e.preventDefault();

        const name = nameInput.value.trim();
        const email = emailInput.value.trim();
        const phone = phoneInput.value.trim();

        if (!email) return;

        if (submitBtn) {
          submitBtn.innerHTML = `<span>Opening Secure Checkout...</span>`;
          submitBtn.setAttribute('disabled', 'true');
        }

        const leadData = {
          name: name,
          email: email,
          phone: phone,
          product: '25 Custom Static Ads Package',
          amount: 3500,
          source: 'vatsal.arqostudio.com/vault/thank-you',
          timestamp: new Date().toISOString()
        };

        try {
          const res = await fetch('/api/create-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(leadData)
          });

          if (!res.ok) {
            throw new Error('Order creation endpoint returned ' + res.status);
          }

          const data = await res.json();
          if (!data.orderId) {
            throw new Error('No order ID returned from server');
          }

          sendLeadUpdate('Custom Ads Checkout Initiated', { order_id: data.orderId });
          closeModal();

          if (submitBtn) {
            submitBtn.innerHTML = `<span>Continue to Secure Payment (${UPSELL_PRICE_DISCOUNTED})</span> <span aria-hidden="true">→</span>`;
            submitBtn.removeAttribute('disabled');
          }

          // Open Razorpay Modal
          const RazorpayConstructor = window.Razorpay;
          if (typeof RazorpayConstructor !== 'function') {
            throw new Error('Razorpay SDK not loaded');
          }

          const rzp = new RazorpayConstructor({
            key: data.keyId,
            amount: data.amount,
            currency: data.currency,
            name: 'Arqo Studio',
            description: '25 Custom Static Ads Package (DFY Sprint)',
            image: 'https://vatsal.arqostudio.com/arqo-logo.png',
            order_id: data.orderId,
            prefill: {
              name: name,
              email: email,
              contact: phone,
            },
            theme: {
              color: '#E24A1F',
            },
            modal: {
              ondismiss: function () {
                sendLeadUpdate('Custom Ads Checkout Abandoned (Razorpay Closed)', { order_id: data.orderId });
                if (submitBtn) {
                  submitBtn.innerHTML = `<span>Continue to Secure Payment (${UPSELL_PRICE_DISCOUNTED})</span> <span aria-hidden="true">→</span>`;
                  submitBtn.removeAttribute('disabled');
                }
              },
            },
            handler: function (response) {
              sendLeadUpdate('PAID_CUSTOM_ADS', {
                order_id: response.razorpay_order_id || data.orderId,
                payment_id: response.razorpay_payment_id || '',
              });

              if (typeof fbq === 'function') {
                fbq('track', 'Purchase', {
                  content_name: '25 Custom Static Ads Package',
                  value: 3500.00,
                  currency: 'INR',
                  transaction_id: response.razorpay_payment_id,
                });
              }

              // Redirect to onboarding page with business details form + cal.com embed
              const targetUrl = `/vault/onboarding?payment_id=${encodeURIComponent(response.razorpay_payment_id || '')}&order_id=${encodeURIComponent(response.razorpay_order_id || '')}&name=${encodeURIComponent(name)}&email=${encodeURIComponent(email)}&phone=${encodeURIComponent(phone)}`;
              window.location.href = targetUrl;
            },
          });

          rzp.on('payment.failed', function (resp) {
            const err = resp.error || {};
            sendLeadUpdate('PAYMENT_FAILED_CUSTOM_ADS', {
              order_id: data.orderId,
              reason: err.description || err.code || 'Payment declined',
            });
            alert('Payment failed: ' + (err.description || 'Please try another payment method.'));
            if (submitBtn) {
              submitBtn.innerHTML = `<span>Continue to Secure Payment (${UPSELL_PRICE_DISCOUNTED})</span> <span aria-hidden="true">→</span>`;
              submitBtn.removeAttribute('disabled');
            }
          });

          rzp.open();

        } catch (error) {
          console.error('Checkout error:', error);
          alert('Unable to initiate checkout right now. Please check your connection or contact hello@arqostudio.com');
          if (submitBtn) {
            submitBtn.innerHTML = `<span>Continue to Secure Payment (${UPSELL_PRICE_DISCOUNTED})</span> <span aria-hidden="true">→</span>`;
            submitBtn.removeAttribute('disabled');
          }
        }
      });
    })();
  </script>
