---
import Layout from '../../layouts/Layout.astro';

// ==========================================
// CONFIGURATION
// ==========================================
const GOOGLE_DRIVE_VAULT_URL = "https://drive.google.com/drive/folders/1lvUJOkiVOmAwIDbMlOJF9duh8PipGwZP?usp=sharing";
const PDF_DOWNLOAD_URL = "/The_Static_Ad_Vault.pdf";
const UPSELL_PRICE_DISCOUNTED = "₹3,500";
const UPSELL_PRICE_REGULAR = "₹5,000";
const UPSELL_SAVINGS = "₹1,500";
const TIMER_SECONDS = 600; // 10 minutes urgency clock (never expires)
---

<Layout
  title="Order Confirmed · Done-For-You 25 Custom Ads Offer | Arqo Studio"
  description="Your Static Ad Vault is ready. Upgrade to 25 custom static ads designed specifically for your brand by Arqo Studio."
  robots="noindex, nofollow"
>
  <!-- Purchase Tracking Pixel for Initial Vault Purchase -->
  <script is:inline>
    if (typeof fbq === 'function') {
      fbq('track', 'Purchase', {
        value: 999.00,
        currency: 'INR',
        content_name: 'Static Ad Vault'
      });
    }
  </script>

  <div class="min-h-screen flex flex-col justify-between bg-[#FAF9F6] text-[#141416]">

    <!-- MINIMAL CLEAN HEADER -->
    <header class="sticky top-0 z-30 border-b border-[#E8E6E1] bg-white/90 backdrop-blur-md py-4 px-5 sm:px-8">
      <div class="mx-auto max-w-5xl flex items-center justify-between">
        <a href="/" class="text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.</span>
          <span class="ml-2 text-xs font-normal text-[#8E8D94]">· Arqo Studio</span>
        </a>
        <div class="flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Vault Access Unlocked</span>
        </div>
      </div>
    </header>

    <main class="flex-1 py-8 sm:py-12 px-5 sm:px-8">
      <div class="mx-auto w-full max-w-4xl space-y-10">

        <!-- 1. INSTANT ACCESS / FULFILLMENT BAR -->
        <div class="rounded-2xl border border-emerald-200 bg-gradient-to-r from-emerald-50/80 via-white to-emerald-50/40 p-5 sm:p-6 shadow-xs">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-start sm:items-center gap-3.5">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold text-xl shadow-xs">
                ✓
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h1 class="text-base sm:text-lg font-bold text-[#141416]">Thank you! Your Static Ad Vault is ready.</h1>
                </div>
                <p class="text-xs sm:text-sm text-[#5E5D64] mt-0.5">
                  Lifetime access is active. Access your Google Drive hub or download the playbook directly:
                </p>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2.5 sm:shrink-0">
              <a
                href={GOOGLE_DRIVE_VAULT_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#141416] px-4 py-2.5 text-xs font-bold text-white hover:bg-black transition shadow-xs"
              >
                <span>Google Drive Hub</span>
                <span>↗</span>
              </a>
              <a
                href={PDF_DOWNLOAD_URL}
                download="The_Static_Ad_Vault.pdf"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-[#E8E6E1] bg-white px-4 py-2.5 text-xs font-bold text-[#141416] hover:border-[#E24A1F] hover:text-[#E24A1F] transition"
              >
                <span>Download Playbook PDF</span>
                <span>↓</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 2. FULL-FLEDGED MARKETING PAGE FOR 25 CUSTOM ADS SPRINT -->
        <div class="rounded-3xl border-2 border-[#E24A1F] bg-white p-6 sm:p-10 lg:p-12 shadow-2xl relative overflow-hidden">
          
          <!-- TOP URGENCY & STATUS BAR -->
          <div class="flex flex-wrap items-center justify-between gap-3 pb-6 border-b border-[#E8E6E1]">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#E24A1F]/10 px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-[#E24A1F]">
                <span class="h-2 w-2 rounded-full bg-[#E24A1F] animate-ping"></span>
                Exclusive New Client Offer
              </span>
              <span class="hidden sm:inline-block text-xs font-semibold text-[#8E8D94]">· One-Time Upgrade</span>
            </div>
            
            <!-- LIVE TICKING CLOCK (NON-EXPIRING OFFER) -->
            <div class="flex items-center gap-2.5 bg-[#FAF9F6] border border-[#E8E6E1] px-3.5 py-1.5 rounded-xl">
              <span class="text-xs font-bold text-[#8E8D94] uppercase tracking-wider">Reserved Window:</span>
              <div id="countdown" class="font-mono text-base font-black text-[#E24A1F]">
                10:00
              </div>
            </div>
          </div>

          <!-- HERO SECTION -->
          <div class="mt-8 text-center sm:text-left">
            <div class="inline-block rounded-full bg-orange-100 text-[#E24A1F] px-3 py-1 text-xs font-bold uppercase tracking-wider mb-3">
              Done-For-You Creative Sprint
            </div>
            <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[#141416] leading-[1.15]">
              Want our team to build <span class="text-[#E24A1F]">25 custom static ads</span> engineered for your exact business?
            </h2>
            <p class="mt-4 text-sm sm:text-base lg:text-lg text-[#5E5D64] leading-relaxed max-w-3xl">
              You have the 30+ format frameworks in the Vault. But if you want to skip 20+ hours of wrestling Figma templates, researching competitor angles, and agonizing over copywriting hooks—our creative team will research, script, and design 25 ready-to-launch static ads built specifically for your product.
            </p>
          </div>

          <!-- QUICK PRICING CALLOUT BANNER -->
          <div class="mt-8 rounded-2xl bg-[#FAF9F6] border border-[#E8E6E1] p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="text-center sm:text-left">
              <div class="flex items-center justify-center sm:justify-start gap-2">
                <span class="text-xs sm:text-sm text-[#8E8D94] line-through">Standard Fee: {UPSELL_PRICE_REGULAR}</span>
                <span class="text-xs font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-full">Save {UPSELL_SAVINGS} Today</span>
              </div>
              <div class="flex items-baseline justify-center sm:justify-start gap-2 mt-1">
                <span class="text-3xl sm:text-4xl font-black text-[#E24A1F]">{UPSELL_PRICE_DISCOUNTED}</span>
                <span class="text-xs sm:text-sm font-semibold text-[#5E5D64]">one-time client investment</span>
              </div>
              <p class="text-xs text-[#8E8D94] mt-1">Includes 25 concepts · 50 total files (1:1 &amp; 9:16) · Full source files</p>
            </div>

            <button
              type="button"
              class="open-upsell-modal-btn w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-[#E24A1F] px-8 py-4 text-sm sm:text-base font-black text-white shadow-lg hover:bg-[#C53B12] hover:shadow-xl active:scale-[0.99] transition uppercase tracking-wider text-center cursor-pointer"
            >
              <span>Claim 25 Ads for {UPSELL_PRICE_DISCOUNTED}</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          <!-- VISUAL EXAMPLES PREVIEW -->
          <div class="mt-12 pt-10 border-t border-[#E8E6E1]">
            <div class="text-center sm:text-left mb-6">
              <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Tested Formats We Adapt For You</span>
              <h3 class="text-xl sm:text-2xl font-extrabold text-[#141416] mt-1">
                Formats Engineered to Lower CAC &amp; Stop The Scroll
              </h3>
              <p class="text-xs sm:text-sm text-[#5E5D64] mt-1">
                We don't make generic Canva quote graphics. We build direct-response assets proven across multi-million dollar ad accounts:
              </p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
              <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-3 text-center hover:border-[#E24A1F] transition">
                <div class="aspect-square rounded-lg bg-white border border-[#E8E6E1] mb-2 flex items-center justify-center overflow-hidden p-2">
                  <img src="/vault-previews/thumb-sheets-table.webp" alt="Sheets Breakdown format" class="max-h-full object-contain" />
                </div>
                <span class="text-xs font-bold text-[#141416] block">Data &amp; Sheets</span>
                <span class="text-[10px] text-[#8E8D94]">High authority logic</span>
              </div>

              <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-3 text-center hover:border-[#E24A1F] transition">
                <div class="aspect-square rounded-lg bg-white border border-[#E8E6E1] mb-2 flex items-center justify-center overflow-hidden p-2">
                  <img src="/vault-previews/thumb-notes-app.webp" alt="Notes app format" class="max-h-full object-contain" />
                </div>
                <span class="text-xs font-bold text-[#141416] block">iPhone Notes</span>
                <span class="text-[10px] text-[#8E8D94]">Native social feel</span>
              </div>

              <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-3 text-center hover:border-[#E24A1F] transition">
                <div class="aspect-square rounded-lg bg-white border border-[#E8E6E1] mb-2 flex items-center justify-center overflow-hidden p-2">
                  <img src="/vault-previews/thumb-reddit-thread.webp" alt="Reddit thread format" class="max-h-full object-contain" />
                </div>
                <span class="text-xs font-bold text-[#141416] block">Community Proof</span>
                <span class="text-[10px] text-[#8E8D94]">High trust reviews</span>
              </div>

              <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-3 text-center hover:border-[#E24A1F] transition">
                <div class="aspect-square rounded-lg bg-white border border-[#E8E6E1] mb-2 flex items-center justify-center overflow-hidden p-2">
                  <img src="/vault-previews/thumb-google-search.webp" alt="Search bar format" class="max-h-full object-contain" />
                </div>
                <span class="text-xs font-bold text-[#141416] block">Search Intent</span>
                <span class="text-[10px] text-[#8E8D94]">Problem-led curiosity</span>
              </div>

              <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-3 text-center hover:border-[#E24A1F] transition">
                <div class="aspect-square rounded-lg bg-white border border-[#E8E6E1] mb-2 flex items-center justify-center overflow-hidden p-2">
                  <img src="/vault-previews/thumb-fake-review.webp" alt="Review callout format" class="max-h-full object-contain" />
                </div>
                <span class="text-xs font-bold text-[#141416] block">Review Teardown</span>
                <span class="text-[10px] text-[#8E8D94]">Overcomes objections</span>
              </div>

              <div class="rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-3 text-center hover:border-[#E24A1F] transition">
                <div class="aspect-square rounded-lg bg-white border border-[#E8E6E1] mb-2 flex items-center justify-center overflow-hidden p-2">
                  <img src="/vault-previews/thumb-chatgpt-prompt.webp" alt="Chat UI format" class="max-h-full object-contain" />
                </div>
                <span class="text-xs font-bold text-[#141416] block">UI Dialogue</span>
                <span class="text-[10px] text-[#8E8D94]">Pattern interruption</span>
              </div>
            </div>
          </div>

          <!-- THE 6 DELIVERABLES BREAKDOWN -->
          <div class="mt-12 pt-10 border-t border-[#E8E6E1]">
            <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Everything Handled For You</span>
            <h3 class="text-xl sm:text-3xl font-extrabold text-[#141416] mt-1">
              What You Get Inside the 25-Ad Creative Sprint
            </h3>

            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Item 1 -->
              <div class="rounded-2xl border border-[#E8E6E1] bg-white p-5 hover:border-[#E24A1F]/40 transition">
                <div class="flex items-start gap-3.5">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#E24A1F] font-bold">
                    01
                  </div>
                  <div>
                    <h4 class="text-sm sm:text-base font-bold text-[#141416]">25 Bespoke Visual Concepts</h4>
                    <p class="text-xs sm:text-sm text-[#5E5D64] mt-1 leading-relaxed">
                      Custom tailored to your brand, product features, and target avatar. We map your offer against 25 distinct psychological angles (comparison, objection handling, proof, and starburst).
                    </p>
                  </div>
                </div>
              </div>

              <!-- Item 2 -->
              <div class="rounded-2xl border border-[#E8E6E1] bg-white p-5 hover:border-[#E24A1F]/40 transition">
                <div class="flex items-start gap-3.5">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#E24A1F] font-bold">
                    02
                  </div>
                  <div>
                    <h4 class="text-sm sm:text-base font-bold text-[#141416]">Dual Placements: 1:1 Feed &amp; 9:16 Stories</h4>
                    <p class="text-xs sm:text-sm text-[#5E5D64] mt-1 leading-relaxed">
                      Every single concept is delivered in both Square (1080x1080) for Instagram &amp; Facebook Feed, and Vertical (1080x1920) for Stories &amp; Reels. That's 50 total high-res assets ready to drop into Ads Manager.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Item 3 -->
              <div class="rounded-2xl border border-[#E8E6E1] bg-white p-5 hover:border-[#E24A1F]/40 transition">
                <div class="flex items-start gap-3.5">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#E24A1F] font-bold">
                    03
                  </div>
                  <div>
                    <h4 class="text-sm sm:text-base font-bold text-[#141416]">Persuasive Copywriting &amp; Hook Scripts</h4>
                    <p class="text-xs sm:text-sm text-[#5E5D64] mt-1 leading-relaxed">
                      Great visuals fail without strong hooks. We write scroll-stopping headlines, on-image copy, and matching primary text for every creative to maximize click-through rate.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Item 4 -->
              <div class="rounded-2xl border border-[#E8E6E1] bg-white p-5 hover:border-[#E24A1F]/40 transition">
                <div class="flex items-start gap-3.5">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#E24A1F] font-bold">
                    04
                  </div>
                  <div>
                    <h4 class="text-sm sm:text-base font-bold text-[#141416]">Full Editable Source Files (Figma / Canva)</h4>
                    <p class="text-xs sm:text-sm text-[#5E5D64] mt-1 leading-relaxed">
                      You own 100% of the creative assets. We provide full access to the organized Figma project or Canva templates so your in-house team can easily swap colors, photos, or text anytime.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Item 5 -->
              <div class="rounded-2xl border border-[#E8E6E1] bg-white p-5 hover:border-[#E24A1F]/40 transition">
                <div class="flex items-start gap-3.5">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#E24A1F] font-bold">
                    05
                  </div>
                  <div>
                    <h4 class="text-sm sm:text-base font-bold text-[#141416]">Fast 5 to 7 Business Day Turnaround</h4>
                    <p class="text-xs sm:text-sm text-[#5E5D64] mt-1 leading-relaxed">
                      No weeks of agency delays. Once you submit your onboarding brief, our production engine delivers your full creative asset folder to your private Google Drive in 5–7 business days.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Item 6 -->
              <div class="rounded-2xl border border-[#E8E6E1] bg-white p-5 hover:border-[#E24A1F]/40 transition">
                <div class="flex items-start gap-3.5">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#E24A1F] font-bold">
                    06
                  </div>
                  <div>
                    <h4 class="text-sm sm:text-base font-bold text-[#141416]">100% Satisfaction Guarantee + 1 Revision Round</h4>
                    <p class="text-xs sm:text-sm text-[#5E5D64] mt-1 leading-relaxed">
                      We want you scaling these creatives with confidence. If any design needs tweaks, copy refinement, or adjustment, 1 full revision round is included free of charge.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- HOW IT WORKS (3 SIMPLE STEPS) -->
          <div class="mt-12 pt-10 border-t border-[#E8E6E1]">
            <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Seamless Experience</span>
            <h3 class="text-xl sm:text-2xl font-extrabold text-[#141416] mt-1">
              How It Works (Step-by-Step)
            </h3>

            <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="rounded-2xl border border-[#E8E6E1] bg-[#FAF9F6] p-5">
                <div class="text-xs font-black uppercase text-[#E24A1F]">Step 1 · Checkout</div>
                <h4 class="font-bold text-sm text-[#141416] mt-2">Lock In Special Client Rate ({UPSELL_PRICE_DISCOUNTED})</h4>
                <p class="text-xs text-[#5E5D64] mt-1.5 leading-relaxed">
                  Click the upgrade button to secure the one-time client discounted rate via secure Razorpay checkout.
                </p>
              </div>

              <div class="rounded-2xl border border-[#E8E6E1] bg-[#FAF9F6] p-5">
                <div class="text-xs font-black uppercase text-[#E24A1F]">Step 2 · Direct Booking</div>
                <h4 class="font-bold text-sm text-[#141416] mt-2">Schedule Your 1-on-1 Call</h4>
                <p class="text-xs text-[#5E5D64] mt-1.5 leading-relaxed">
                  No long forms to fill out. Jump straight to Vatsal's live calendar to pick a convenient 20-minute kickoff time.
                </p>
              </div>

              <div class="rounded-2xl border border-[#E8E6E1] bg-[#FAF9F6] p-5">
                <div class="text-xs font-black uppercase text-[#E24A1F]">Step 3 · Kickoff &amp; Delivery</div>
                <h4 class="font-bold text-sm text-[#141416] mt-2">Strategy Sync &amp; 5–7 Day Delivery</h4>
                <p class="text-xs text-[#5E5D64] mt-1.5 leading-relaxed">
                  We discuss your business and angles on the call, then deliver your complete 25-ad asset pack to your Drive.
                </p>
              </div>
            </div>
          </div>

          <!-- COMPARISON: DIY VS DFY -->
          <div class="mt-12 pt-10 border-t border-[#E8E6E1]">
            <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Why Make This Investment?</span>
            <h3 class="text-xl sm:text-2xl font-extrabold text-[#141416] mt-1">
              Building Yourself vs. Handing It to Our Team
            </h3>

            <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="rounded-2xl border border-red-200 bg-red-50/40 p-5">
                <h4 class="font-bold text-sm text-red-900 flex items-center gap-2">
                  <span>✕</span> Doing It Yourself
                </h4>
                <ul class="mt-3 space-y-2 text-xs text-red-900/80">
                  <li class="flex items-start gap-2">
                    <span>•</span> 20 to 30 hours spent in Canva or Photoshop designing from scratch.
                  </li>
                  <li class="flex items-start gap-2">
                    <span>•</span> Creative fatigue and second-guessing which hooks will actually convert.
                  </li>
                  <li class="flex items-start gap-2">
                    <span>•</span> Delayed ad tests costing days or weeks of potential customer acquisition.
                  </li>
                  <li class="flex items-start gap-2">
                    <span>•</span> Sizing headaches manually resizing every single post for Stories and Feeds.
                  </li>
                </ul>
              </div>

              <div class="rounded-2xl border border-emerald-300 bg-emerald-50/50 p-5">
                <h4 class="font-bold text-sm text-emerald-950 flex items-center gap-2">
                  <span>✓</span> With Arqo Studio's 25-Ad Sprint
                </h4>
                <ul class="mt-3 space-y-2 text-xs text-emerald-950/80">
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-700 font-bold">✓</span> <strong>Done in 2 minutes:</strong> Fill the brief, jump on a strategy call, and we do the heavy lifting.
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-700 font-bold">✓</span> <strong>Battle-tested psychology:</strong> Every angle is built to attack customer skepticism and boost click-through rate.
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-700 font-bold">✓</span> <strong>Both 1:1 and 9:16 ready:</strong> 50 ready-to-test files ready to upload straight to Ads Manager.
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-700 font-bold">✓</span> <strong>Unbeatable client pricing:</strong> Only ₹3,500 (just ₹140 per ad concept!).
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- FAQ SECTION -->
          <div class="mt-12 pt-10 border-t border-[#E8E6E1]">
            <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Got Questions?</span>
            <h3 class="text-xl sm:text-2xl font-extrabold text-[#141416] mt-1 mb-6">
              Frequently Asked Questions
            </h3>

            <div class="space-y-3">
              <details class="group rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-4 text-xs sm:text-sm">
                <summary class="font-bold text-[#141416] cursor-pointer flex items-center justify-between">
                  <span>What happens immediately after I checkout?</span>
                  <span class="text-[#8E8D94] group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <p class="mt-3 text-[#5E5D64] leading-relaxed">
                  No tedious onboarding forms! You are immediately redirected to Vatsal's live Cal.com calendar to book your 1-on-1 discovery call. We'll unpack your brand, products, customer pain points, and creative preferences directly on the call.
                </p>
              </details>

              <details class="group rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-4 text-xs sm:text-sm">
                <summary class="font-bold text-[#141416] cursor-pointer flex items-center justify-between">
                  <span>What if I don't have high-end professional product photography?</span>
                  <span class="text-[#8E8D94] group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <p class="mt-3 text-[#5E5D64] leading-relaxed">
                  No problem at all! Static ads thrive on authentic, native formats—like Notes App teardowns, Google search screenshots, Reddit discussions, starburst charts, and typography-focused value stacks. We can also pull existing assets from your website or social media.
                </p>
              </details>

              <details class="group rounded-xl border border-[#E8E6E1] bg-[#FAF9F6] p-4 text-xs sm:text-sm">
