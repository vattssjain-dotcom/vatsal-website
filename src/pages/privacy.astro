---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Privacy Policy | Vatsal Jain · Arqo Studio"
  description="Privacy Policy for Vatsal Jain and Arqo Studio. Learn how your data is collected, used, and protected."
>
  <!-- HEADER -->
  <header class="sticky top-0 z-50 w-full border-b border-[#E8E6E1] bg-[#FAF9F6]/90 backdrop-blur-md">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex items-center justify-between py-4">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-1.5 text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.</span>
        </a>

        <!-- Nav links -->
        <nav class="hidden items-center gap-8 md:flex">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Products</a>
          <a href="/vault" class="text-sm font-medium text-[#5E5D64] transition hover:text-[#141416]">Ad Vault</a>
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/vault"
            class="inline-flex items-center gap-1.5 rounded-md bg-[#E24A1F] px-4 py-2 text-xs sm:text-sm font-bold text-white transition hover:bg-[#C53B12] shadow-sm"
          >
            Get The Vault →
          </a>

          <!-- Mobile hamburger -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="flex h-9 w-9 items-center justify-center rounded-md border border-[#E8E6E1] text-[#5E5D64] transition hover:bg-white md:hidden"
            aria-label="Toggle menu"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden pb-4 md:hidden border-t border-[#E8E6E1] pt-3">
        <nav class="flex flex-col gap-3">
          <a href="/#about" class="text-sm font-medium text-[#5E5D64]">About</a>
          <a href="/#articles" class="text-sm font-medium text-[#5E5D64]">Articles</a>
          <a href="/#products" class="text-sm font-medium text-[#5E5D64]">Products</a>
          <a href="/vault" class="text-sm font-semibold text-[#E24A1F]">Ad Vault</a>
        </nav>
      </div>
    </div>
  </header>

  <main class="flex-auto">
    <div class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
      <div class="border-b border-[#E8E6E1] pb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E24A1F]">Legal Documentation</span>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
          Privacy Policy
        </h1>
        <p class="mt-3 text-sm text-[#5E5D64]">
          Last updated: October 29, 2026 · Effective immediately
        </p>
      </div>

      <!-- META DISCLAIMER CALLOUT -->
      <div class="mt-8 rounded-xl border border-amber-200/80 bg-amber-50/50 p-5 text-xs text-[#5E5D64] leading-relaxed">
        <strong class="font-bold text-[#141416] uppercase tracking-wider block mb-1">Important Meta / Facebook Disclaimer:</strong>
        This website is not a part of the Facebook website or Meta Platforms, Inc. Additionally, this site is NOT endorsed or affiliated with Facebook or Meta Platforms, Inc. in any way. FACEBOOK is a trademark of META PLATFORMS, INC.
      </div>

      <div class="mt-10 space-y-10 text-sm text-[#3E3D42] leading-relaxed">
        <!-- 1. Introduction -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">1. Introduction &amp; Scope</h2>
          <p class="mt-3">
            Welcome to the website of <strong>Vatsal Jain</strong> and <strong>Arqo Studio</strong> ("we", "us", or "our"). We respect your privacy and are committed to protecting the personal information you share with us. This Privacy Policy describes how we collect, use, process, and disclose your information across our website (<a href="https://vatsal.arqostudio.com" class="text-[#E24A1F] hover:underline">vatsal.arqostudio.com</a>), products including <em>The Static Ad Vault</em>, <em>25 Custom Static Ads Pack</em>, <em>Roast My Ads</em>, and related digital services.
          </p>
        </section>

        <!-- 2. Information We Collect -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">2. Information We Collect</h2>
          <p class="mt-3">
            We collect information you provide directly to us, as well as limited technical information collected automatically:
          </p>
          <ul class="mt-3 list-disc pl-5 space-y-2 text-[#5E5D64]">
            <li><strong>Contact and Order Information:</strong> When you purchase a digital product, book an audit, or contact us, we collect your name, email address, phone number, and company/brand details.</li>
            <li><strong>Payment Information:</strong> All payment transactions are securely handled by our third-party payment gateway, <strong>Razorpay</strong>. We never store, process, or have access to your credit/debit card numbers, CVVs, or online banking credentials.</li>
            <li><strong>Usage and Device Data:</strong> When you browse our site, we may automatically collect standard log data such as IP address, browser type, referring pages, device characteristics, and pages viewed.</li>
          </ul>
        </section>

        <!-- 3. How We Use Your Information -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">3. How We Use Your Information</h2>
          <p class="mt-3">
            We use the collected information solely for legitimate business operations:
          </p>
          <ul class="mt-3 list-disc pl-5 space-y-2 text-[#5E5D64]">
            <li>To process and deliver your digital purchases (e.g., granting private access to Notion workspaces, delivering PDF teardown documents, or scheduling ad audit reviews).</li>
            <li>To send essential transactional notifications, receipts, delivery links, and customer support responses.</li>
            <li>To communicate future product updates, new formats added to the Vault, or related strategic insights (you may unsubscribe at any time).</li>
            <li>To maintain website security, prevent fraudulent transactions, and monitor site performance.</li>
          </ul>
        </section>

        <!-- 4. Third-Party Services & Tracking Technologies -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">4. Third-Party Services &amp; Pixels</h2>
          <p class="mt-3">
            We partner with trusted third-party providers to operate our business:
          </p>
          <ul class="mt-3 list-disc pl-5 space-y-2 text-[#5E5D64]">
            <li><strong>Razorpay:</strong> Payment processing. Subject to Razorpay's PCI-DSS compliant Privacy Policy.</li>
            <li><strong>Meta Pixel (Facebook/Instagram):</strong> We use the Meta Pixel to analyze conversion events and measure advertising performance. This helps us ensure our ads are shown to relevant users. You can opt out of targeted advertising through your Facebook Ad Preferences settings.</li>
            <li><strong>Cloudflare:</strong> Website hosting, CDN delivery, and DDoS mitigation.</li>
          </ul>
        </section>

        <!-- 5. Not Affiliated with Meta Platforms, Inc. -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">5. Meta Platforms / Facebook Disclaimer</h2>
          <p class="mt-3">
            This website, Vatsal Jain, and Arqo Studio are not officially connected, affiliated, authorized, sponsored, or endorsed by Meta Platforms, Inc., Facebook, Instagram, or any of their parent companies or subsidiaries. Any reference to Facebook, Meta, or Instagram is made strictly for educational, analytical, and fair-use editorial purposes to describe advertising techniques.
          </p>
        </section>

        <!-- 6. Data Retention & Security -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">6. Data Security &amp; Retention</h2>
          <p class="mt-3">
            We employ modern encryption (HTTPS/TLS) and secure access controls to protect your information against unauthorized access, alteration, or disclosure. We retain your customer record only as long as necessary to fulfill your product access and satisfy tax or legal requirements.
          </p>
        </section>

        <!-- 7. Your Data Rights -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">7. Your Data Rights</h2>
          <p class="mt-3">
            You have the right to request access to the personal data we hold about you, request corrections to inaccurate data, or request deletion of your information from our direct records. To exercise any of these rights, email us at <a href="mailto:hello@arqostudio.com" class="font-semibold text-[#E24A1F] hover:underline">hello@arqostudio.com</a>.
          </p>
        </section>

        <!-- 8. Contact Information -->
        <section>
          <h2 class="text-lg font-bold text-[#141416]">8. Contact Us</h2>
          <p class="mt-3">
            If you have questions, feedback, or concerns regarding this Privacy Policy, please contact:
          </p>
          <div class="mt-4 rounded-xl border border-[#E8E6E1] bg-white p-5 text-xs text-[#5E5D64] space-y-1.5 shadow-2xs">
            <div><strong>Entity:</strong> Vatsal Jain · Arqo Studio</div>
            <div><strong>Support Email:</strong> <a href="mailto:hello@arqostudio.com" class="text-[#E24A1F] hover:underline">hello@arqostudio.com</a></div>
            <div><strong>Website:</strong> <a href="https://vatsal.arqostudio.com" class="hover:underline">https://vatsal.arqostudio.com</a></div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-[#E8E6E1] bg-[#FAF9F6] py-10">
    <div class="mx-auto max-w-5xl px-5 sm:px-8 lg:px-12">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-xs text-[#8E8D94]">
          © {new Date().getFullYear()} Vatsal Jain · Arqo Studio. All rights reserved.
        </p>
        <div class="flex flex-wrap items-center gap-6 text-xs text-[#5E5D64]">
          <a href="/" class="hover:text-[#141416]">Home</a>
          <a href="/vault" class="hover:text-[#141416]">Ad Vault</a>
          <a href="/privacy" class="text-[#141416] font-semibold">Privacy Policy</a>
          <a href="/terms" class="hover:text-[#141416]">Terms &amp; Conditions</a>
          <a href="mailto:hello@arqostudio.com" class="hover:text-[#141416]">Contact</a>
        </div>
      </div>
      <div class="mt-6 border-t border-[#E8E6E1] pt-6 text-center text-[11px] text-[#8E8D94] leading-relaxed">
        <p>Disclaimer: This site is not a part of the Facebook website or Meta Platforms, Inc. Additionally, this site is NOT endorsed by Facebook / Meta in any way. FACEBOOK is a trademark of META PLATFORMS, INC.</p>
      </div>
    </div>
  </footer>
</Layout>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
  });
</script>
