---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="You're In! | Roast My Ads Confirmation | Vatsal Jain"
  description="Confirmation and next steps for your Roast My Ads + 1-Month Mentorship with Vatsal Jain."
  robots="noindex, nofollow"
>
  <div class="min-h-screen bg-[#FAF9F6] flex flex-col justify-between">
    <!-- HEADER -->
    <header class="border-b border-[#E8E6E1] bg-white/80 backdrop-blur-md py-4 px-5 sm:px-8">
      <div class="mx-auto max-w-2xl flex items-center justify-between">
        <a href="/" class="text-base font-bold text-[#141416] tracking-tight">
          Vatsal Jain<span class="text-[#E24A1F]">.</span>
        </a>
        <div class="flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Payment Confirmed
        </div>
      </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="flex-auto py-12 px-5 sm:px-8">
      <div class="mx-auto max-w-2xl">
        <!-- SUCCESS BADGE & TITLE -->
        <div class="text-center">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-700">
            ✓ Order Confirmed · Roast My Ads
          </span>
          <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-[#141416] sm:text-4xl">
            You're in. Let's fix your ads &amp; scale your spend.
          </h1>
          <p class="mt-3 text-sm sm:text-base text-[#5E5D64] leading-relaxed max-w-lg mx-auto">
            Your spot for the <strong class="text-[#141416]">Roast My Ads + 1-Month Mentorship</strong> is secured. Below is your 3-step kickoff checklist to get started immediately.
          </p>
        </div>

        <!-- 3-STEP ONBOARDING CHECKLIST -->
        <div class="mt-10 space-y-5">
          <!-- STEP 1 -->
          <div class="rounded-2xl border border-[#E8E6E1] bg-white p-6 sm:p-7 shadow-xs">
            <div class="flex items-start gap-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#E24A1F] text-sm font-extrabold text-white">
                1
              </span>
              <div class="flex-1">
                <h2 class="text-base font-bold text-[#141416]">Share Your Ad Account &amp; Creative Assets</h2>
                <p class="mt-1 text-xs sm:text-sm text-[#5E5D64] leading-relaxed">
                  To prepare your comprehensive video teardown before our first call, send over your ad account viewer access or links to your active creatives:
                </p>
                <div class="mt-3 rounded-lg border border-[#E8E6E1] bg-[#FAF9F6] p-3 text-xs text-[#5E5D64] space-y-1.5">
                  <p>• <strong>Store / Product URL:</strong> Where your ads currently send traffic</p>
                  <p>• <strong>Meta Ads Access:</strong> Add <code class="rounded bg-white px-1.5 py-0.5 border border-[#E8E6E1] text-[#141416]">hello@arqostudio.com</code> (Viewer role only)</p>
                  <p>• <strong>Current Challenge:</strong> What's your monthly ad spend and biggest bottleneck?</p>
                </div>
                <a
                  href="mailto:hello@arqostudio.com?subject=Roast%20My%20Ads%20Kickoff%20Details&body=Hey%20Vatsal%2C%0A%0AHere%20are%20my%20details%20for%20the%20Roast%20My%20Ads%20onboarding%3A%0A%0AWebsite%20%2F%20Store%20URL%3A%20%0ACurrent%20Monthly%20Ad%20Spend%3A%20%0AMeta%20Ad%20Account%20ID%20(or%20invited%20hello%40arqostudio.com)%3A%20%0ABiggest%20problem%20right%20now%20(CTR%2C%20CPA%2C%20scaling%2C%20creatives)%3A%20%0A"
                  class="mt-4 inline-flex items-center gap-1.5 rounded-md bg-[#141416] px-4 py-2 text-xs sm:text-sm font-bold text-white transition hover:bg-black"
                >
                  Email Onboarding Details →
                </a>
              </div>
            </div>
          </div>

          <!-- STEP 2 -->
          <div class="rounded-2xl border border-[#E8E6E1] bg-white p-6 sm:p-7 shadow-xs">
            <div class="flex items-start gap-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#E24A1F] text-sm font-extrabold text-white">
                2
              </span>
              <div class="flex-1">
                <h2 class="text-base font-bold text-[#141416]">Schedule Week 1 Strategy Kickoff</h2>
                <p class="mt-1 text-xs sm:text-sm text-[#5E5D64] leading-relaxed">
                  We conduct four 45-minute 1-on-1 calls across your 30 days. You'll receive a direct calendar invitation link within 12 hours to pick your preferred slot for Call 1.
                </p>
                <div class="mt-3 flex items-center gap-2 text-xs font-semibold text-[#E24A1F]">
                  <span>📅 Calendar link sent to your checkout email</span>
                </div>
              </div>
            </div>
          </div>

          <!-- STEP 3 -->
          <div class="rounded-2xl border border-[#E8E6E1] bg-white p-6 sm:p-7 shadow-xs">
            <div class="flex items-start gap-4">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#E24A1F] text-sm font-extrabold text-white">
                3
              </span>
              <div class="flex-1">
                <h2 class="text-base font-bold text-[#141416]">48-Hour Unfiltered Video Teardown Delivery</h2>
                <p class="mt-1 text-xs sm:text-sm text-[#5E5D64] leading-relaxed">
                  Within 48 hours of receiving your assets, I'll record and deliver your private Loom teardown highlighting exact leaks, hook fixes, and a prioritized action checklist to review on our first call.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- CONTACT / SUPPORT CARD -->
        <div class="mt-8 rounded-2xl border border-[#E8E6E1] bg-white p-6 text-center">
          <h3 class="text-sm font-bold text-[#141416]">Questions or need immediate assistance?</h3>
          <p class="mt-1 text-xs text-[#5E5D64]">
            Reach out directly at <a href="mailto:hello@arqostudio.com" class="font-semibold text-[#E24A1F] underline">hello@arqostudio.com</a> or reply to your Razorpay receipt.
          </p>
          <div class="mt-4">
            <a href="/" class="text-xs font-semibold text-[#5E5D64] hover:text-[#141416] transition">
              ← Back to homepage
            </a>
          </div>
        </div>
      </div>
    </main>

    <!-- FOOTER -->
    <footer class="border-t border-[#E8E6E1] bg-white py-6 px-5 text-center text-xs text-[#8E8D94] space-y-2">
      <div class="flex flex-wrap justify-center items-center gap-4">
        <span>© {new Date().getFullYear()} Vatsal Jain · Arqo Studio</span>
        <span>·</span>
        <a href="/privacy" class="underline hover:text-[#141416]">Privacy Policy</a>
        <span>·</span>
        <a href="/terms" class="underline hover:text-[#141416]">Terms &amp; Conditions</a>
        <span>·</span>
        <a href="mailto:hello@arqostudio.com" class="underline hover:text-[#141416]">hello@arqostudio.com</a>
      </div>
      <p class="text-[11px] text-[#A1A1AA] max-w-2xl mx-auto px-4">
        Disclaimer: This site is not a part of the Facebook website or Meta Platforms, Inc. Additionally, this site is NOT endorsed by Facebook / Meta in any way. FACEBOOK is a trademark of META PLATFORMS, INC.
      </p>
    </footer>
  </div>
</Layout>
