---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  robots?: string;
}

const {
  title = 'Vatsal Jain | Direct-to-Consumer Founder & Ad Strategist',
  description = "Direct-to-consumer founder and ad strategist. Proven static ad systems, custom creative production, and full-funnel ad audits through Arqo Studio.",
  canonical = Astro.url.href,
  ogType = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vatsal Jain" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Meta -->
    <meta property="og:site_name" content="Vatsal Jain" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Search Engine Indexing -->
    <meta name="robots" content={robots} />

    <!-- Favicon & Fonts -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '940315292130796');
      fbq('track', 'PageView');
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=940315292130796&ev=PageView&noscript=1"
      />
    </noscript>
    <!-- End Meta Pixel Code -->

    <!-- UTM & Ad Tracking Parameters Forwarder -->
    <script is:inline>
      (function () {
        const TRACKING_KEYS = [
          'utm_source',
          'utm_medium',
          'utm_campaign',
          'utm_term',
          'utm_content',
          'utm_id',
          'fbclid',
          'gclid',
          'ttclid'
        ];

        // 1. Capture parameters from current URL or restore from session
        const currentParams = new URLSearchParams(window.location.search);
        let savedParams = {};

        try {
          const stored = sessionStorage.getItem('vatsal_utm_params');
          if (stored) savedParams = JSON.parse(stored);
        } catch (e) {}

        let hasNew = false;
        currentParams.forEach((val, key) => {
          const lower = key.toLowerCase();
          if (TRACKING_KEYS.includes(lower) || lower.startsWith('utm_')) {
            savedParams[key] = val;
            hasNew = true;
          }
        });

        if (hasNew) {
          try {
            sessionStorage.setItem('vatsal_utm_params', JSON.stringify(savedParams));
          } catch (e) {}
        }

        if (!Object.keys(savedParams).length) return;

        // 2. Decide if link should receive UTM parameters
        function shouldForward(url) {
          const isInternal = url.origin === window.location.origin || url.pathname.startsWith('/');
          const isConversionDomain = url.hostname.includes('arqostudio.com') || url.hostname.includes('razorpay.com');
          const isSocial = /^(www\.)?(instagram\.com|twitter\.com|x\.com|linkedin\.com|facebook\.com|youtube\.com)/i.test(url.hostname);
          return (isInternal || isConversionDomain) && !isSocial;
        }

        function appendParamsToLink(a) {
          const href = a.getAttribute('href');
          if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('javascript:')) {
            return;
          }

          try {
            const targetUrl = new URL(href, window.location.origin);
            if (!shouldForward(targetUrl)) return;

            Object.entries(savedParams).forEach(([k, v]) => {
              if (!targetUrl.searchParams.has(k)) {
                targetUrl.searchParams.set(k, v);
              }
            });

            a.href = targetUrl.toString();
          } catch (e) {}
        }

        function forwardAllLinks() {
          document.querySelectorAll('a[href]').forEach(appendParamsToLink);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', forwardAllLinks);
        } else {
          forwardAllLinks();
        }

        document.addEventListener('click', function (e) {
          const target = e.target.closest('a[href]');
          if (target) appendParamsToLink(target);
        }, { capture: true });
      })();
    </script>
  </head>
  <body class="flex h-full bg-[#FAF9F6] text-[#141416] font-sans antialiased selection:bg-[#E24A1F]/20 selection:text-[#E24A1F]">
    <div class="flex w-full flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>
