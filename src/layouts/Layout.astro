---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  robots?: string;
}

const {
  title = 'Vatsal Jain | Direct-to-Consumer Founder & Ad Strategist',
  description = "Direct-to-consumer founder and ad strategist. Proven static ad systems, custom creative production, and ad roasts through Arqo Studio.",
  canonical = Astro.url.href,
  ogType = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vatsal Jain" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Meta -->
    <meta property="og:site_name" content="Vatsal Jain" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Search Engine Indexing -->
    <meta name="robots" content={robots} />

    <!-- Favicon & Fonts -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z6a2cbyufk");
    </script>

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '940315292130796');
      window._pvEventId = 'pv_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
      fbq('track', 'PageView', {}, { eventID: window._pvEventId });
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=940315292130796&ev=PageView&noscript=1"
      />
    </noscript>
    <!-- End Meta Pixel Code -->

    <!-- UTM & Ad Tracking Parameters Forwarder -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'vatsal_utm_params';
        const EXCLUDED_PARAMS = ['payment_id', 'razorpay_payment_id', 'razorpay_order_id', 'razorpay_signature'];

        // 1. Capture parameters from current URL or restore from session/local storage
        const currentParams = new URLSearchParams(window.location.search);
        let savedParams = {};

        // Load existing stored parameters (sessionStorage takes precedence, localStorage as fallback)
        try {
          const sessionData = sessionStorage.getItem(STORAGE_KEY);
          if (sessionData) {
            savedParams = JSON.parse(sessionData);
          } else {
            const localData = localStorage.getItem(STORAGE_KEY);
            if (localData) savedParams = JSON.parse(localData);
          }
        } catch (e) {}

        // Capture any incoming query parameters
        let hasNew = false;
        currentParams.forEach((val, key) => {
          if (!EXCLUDED_PARAMS.includes(key.toLowerCase()) && val) {
            savedParams[key] = val;
            hasNew = true;
          }
        });

        // Persist to both sessionStorage (tab session) and localStorage (cross-tab / return visits)
        if (hasNew || Object.keys(savedParams).length) {
          try {
            const serialized = JSON.stringify(savedParams);
            sessionStorage.setItem(STORAGE_KEY, serialized);
            localStorage.setItem(STORAGE_KEY, serialized);
          } catch (e) {}
        }

        // Helper to read cookies
        function getCookie(name) {
          try {
            const match = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
            return match ? decodeURIComponent(match[3]) : null;
          } catch (e) {
            return null;
          }
        }

        // Global helper for Meta Conversions API (CAPI) & Pixel deduplication
        window.trackMetaEvent = function (eventName, customData, userData, customEventId) {
          customData = customData || {};
          userData = userData || {};
          const eventId = customEventId || ('evt_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9));

          // 1. Browser Meta Pixel with eventID for deduplication
          if (typeof window.fbq === 'function') {
            try {
              window.fbq('track', eventName, customData, { eventID: eventId });
            } catch (err) {}
          }

          // 2. Server-side Meta Conversions API (CAPI)
          try {
            const tracking = typeof window.getTrackingParams === 'function' ? window.getTrackingParams() : {};
            const payload = {
              event_name: eventName,
              event_id: eventId,
              event_source_url: window.location.href,
              custom_data: customData,
              user_data: userData,
              fbclid: tracking.fbclid || null,
              fbp: getCookie('_fbp'),
              fbc: getCookie('_fbc'),
            };

            fetch('/api/capi', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              keepalive: true,
            }).catch(function () {});
          } catch (err) {}

          return eventId;
        };

        // Fire CAPI for the initial PageView to establish server session with Meta Dataset
        if (window._pvEventId) {
          try {
            const tracking = typeof window.getTrackingParams === 'function' ? window.getTrackingParams() : {};
            fetch('/api/capi', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                event_name: 'PageView',
                event_id: window._pvEventId,
                event_source_url: window.location.href,
                fbclid: tracking.fbclid || null,
                fbp: getCookie('_fbp'),
                fbc: getCookie('_fbc'),
              }),
              keepalive: true,
            }).catch(function () {});
          } catch (e) {}
        }

        // Global helper for JS redirects and embeds
        window.getTrackingParams = function () {
          return { ...savedParams };
        };

        window.getForwardedUrl = function (urlStr) {
          if (!urlStr) return urlStr;
          try {
            const targetUrl = new URL(urlStr, window.location.origin);
            Object.entries(savedParams).forEach(([k, v]) => {
              if (!targetUrl.searchParams.has(k) && v) {
                targetUrl.searchParams.set(k, v);
              }
            });
            return targetUrl.toString();
          } catch (e) {
            return urlStr;
          }
        };

        // 2. Decide if link should receive UTM and tracking parameters
        function shouldForward(url) {
          const hostname = url.hostname.toLowerCase();
          const isInternal = url.origin === window.location.origin || url.pathname.startsWith('/');
          const isConversionDomain =
            hostname.includes('arqostudio.com') ||
            hostname.includes('razorpay.com') ||
            hostname.includes('rzp.io') ||
            hostname.includes('cal.com');
          const isSocial = /^(www\.)?(instagram\.com|twitter\.com|x\.com|linkedin\.com|facebook\.com|youtube\.com)/i.test(hostname);
          return (isInternal || isConversionDomain) && !isSocial;
        }

        function appendParamsToLink(a) {
          const href = a.getAttribute('href');
          if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('javascript:')) {
            return;
          }

          try {
            const targetUrl = new URL(href, window.location.origin);
            if (!shouldForward(targetUrl)) return;

            let modified = false;
            Object.entries(savedParams).forEach(([k, v]) => {
              if (!targetUrl.searchParams.has(k) && v) {
                targetUrl.searchParams.set(k, v);
                modified = true;
              }
            });

            if (modified) {
              a.href = targetUrl.toString();
            }
          } catch (e) {}
        }

        function forwardAllLinks() {
          document.querySelectorAll('a[href]').forEach(appendParamsToLink);
        }

        // Run immediately, on DOMContentLoaded, and on full load
        forwardAllLinks();
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', forwardAllLinks);
        }
        window.addEventListener('load', forwardAllLinks);

        // Capture clicks, right clicks, middle clicks, and touch
        ['click', 'mousedown', 'touchstart'].forEach(function (eventName) {
          document.addEventListener(eventName, function (e) {
            const target = e.target.closest('a[href]');
            if (target) appendParamsToLink(target);
          }, { capture: true, passive: true });
        });

        // Watch for dynamically added links (e.g. modals, buttons added via JS)
        if (typeof MutationObserver !== 'undefined') {
          const observer = new MutationObserver(function (mutations) {
            for (let i = 0; i < mutations.length; i++) {
              const mutation = mutations[i];
              if (mutation.type === 'childList') {
                mutation.addedNodes.forEach(function (node) {
                  if (node.nodeType === 1) {
                    if (node.tagName === 'A' && node.hasAttribute('href')) {
                      appendParamsToLink(node);
                    }
                    if (node.querySelectorAll) {
                      node.querySelectorAll('a[href]').forEach(appendParamsToLink);
                    }
                  }
                });
              }
            }
          });
          observer.observe(document.documentElement, { childList: true, subtree: true });
        }
      })();
    </script>
  </head>
  <body class="flex h-full bg-[#FAF9F6] text-[#141416] font-sans antialiased selection:bg-[#E24A1F]/20 selection:text-[#E24A1F]">
    <div class="flex w-full flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>
