---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vatsal Jain — D2C Hustler, Ad Man & Creator',
  description = "I'm Vatsal, founder of Arqo Studio. I run ads for a living, built a D2C clothing brand to ₹12L+ in revenue, and create AI images & videos. I sell ebooks, courses, and more.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full antialiased scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Vatsal Jain" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex h-full bg-[#FAF9F6] text-[#141416] font-sans antialiased selection:bg-[#E24A1F]/20 selection:text-[#E24A1F]">
    <div class="flex w-full flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>
